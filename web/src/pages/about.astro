---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadSiteData } from "../lib/data.js";

const data = loadSiteData(undefined, 7);
const classes = (data.languageData.lang_classes || {}) as Record<
  string,
  unknown[]
>;
const classDescriptions: Record<string, string> = {
  "0": "Have exceptionally limited resources, and have rarely been considered in language technologies.",
  "1": "Have some unlabelled data; however, collecting labelled data is challenging.",
  "2": "A small set of labelled datasets has been collected, and language support communities are there to support the language.",
  "3": "Has a strong web presence, and a cultural community that backs it. Have been highly benefited by unsupervised pre-training.",
  "4": "Have a large amount of unlabelled data, and lesser, but still a significant amount of labelled data. have dedicated NLP communities researching these languages.",
  "5": "Have a dominant online presence. There have been massive investments in the development of resources and technologies.",
};

const classRows = Object.entries(classes)
  .sort(([left], [right]) => Number(left) - Number(right))
  .map(([classId, languages]) => ({
    classId,
    description: classDescriptions[classId] || "",
    count: languages.length,
    examples: languages
      .slice(0, 2)
      .map((language) => String(language))
      .join(", "),
  }));

const classExamples: Record<string, string[]> = {
  "0": ["Pinyin", "Irarutu", "Himarimã"],
  "1": ["Hawaiian", "Frisian", "Nahuatl"],
  "2": ["Sinhala", "Irish", "Zulu"],
  "3": ["Hindi", "Tamil", "Urdu"],
  "4": ["Indonesian", "Russian", "Italian"],
  "5": ["Arabic", "Chinese", "English"],
};

// Replace the examples field with explicit examples when provided, otherwise use repo data
for (const row of classRows) {
  if (classExamples[row.classId]) {
    row.examples = classExamples[row.classId].slice(0, 3).join(", ");
  }
}
---

<BaseLayout
  title="About LangTrend"
  description="Pipeline, limits, and references for LangTrend"
>
  <section class="page-intro">
    <h1>How does this work?</h1>
    <p>
      Full pipeline description, language classes composition, limitations, and references.
    </p>
  </section>

  <section class="panel">
    <article>
      <h2>Pipeline diagram</h2>
      <figure class="pipeline-diagram">
        <img
          src={`${import.meta.env.BASE_URL}images/langtrend-pipeline.svg`}
          alt="LangTrend data pipeline from arXiv fetch through extraction, cleaning, LLM judge verification, manifest build, and dashboard deploy"
          loading="lazy"
        />
      </figure>
    </article>
  </section>

  <section class="panel">
    <div class="panel-head">
      <h2 id="lang-classes-heading">Language classes</h2>
    </div>
    <table class="class-table" aria-labelledby="lang-classes-heading">
      <thead>
        <tr
          ><th>Class</th><th>Description<sup><a href="#table-fn1" id="table-fn1-ref">1</a></sup></th><th
            >Count<sup><a href="#table-fn2" id="table-fn2-ref">2</a></sup></th
          ><th>Examples<sup><a href="#table-fn2">2</a></sup></th></tr
        >
      </thead>
      <tbody>
        {
          classRows.map((row) => (
            <tr>
              <td>Class {row.classId}</td>
              <td>{row.description}</td>
              <td>{row.count}</td>
              <td>{row.examples}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <div class="table-notes">
      <p id="table-fn1">
        <sup><a href="#table-fn1-ref">1</a></sup> Class descriptions are adapted from <a
          href="https://aclanthology.org/2020.acl-main.560/"
          target="_blank"
          rel="noreferrer">Joshi et al. [3]<span class="sr-only"> (opens in new tab)</span></a
        >.
      </p>
      <p id="table-fn2">
        <sup><a href="#table-fn2-ref">2</a></sup> Counts and example languages are updated from the <a
          href="https://github.com/NisansaDdS/Some-Languages-are-More-Equal-than-Others"
          target="_blank"
          rel="noreferrer">Some Languages are More Equal than Others<span class="sr-only"> (opens in new tab)</span></a
        > repository, which follows the work from <a
          href="https://doi.org/10.18653/v1/2022.aacl-main.62"
          target="_blank"
          rel="noreferrer">Ranathunga and de Silva [2]<span class="sr-only"> (opens in new tab)</span></a
        >.
      </p>
    </div>
  </section>

  <section class="panel">
    <article>
      <h2>Limitations</h2>
      <ul class="info-list">
        <li>
          Language detection is based on explicit mentions in titles, abstracts,
          section text, and cleaned PDF body text, so indirect references (e.g.,
          citing a multilingual dataset without naming the languages) can be
          missed. Furthermore, the regex pass may produce false positives
          (shorter language names in particular can appear as acronyms, author
          names, or technical terms). Text cleaning and acronym filtering
          reduce these, but don't eliminate them entirely.
        </li>

        <li>
          Detected languages are also checked by an LLM judge, which classifies
          each one as studied, mentioned-only, or a false positive with a
          one-line reason. The judge is not infallible — like any LLM, it can
          hallucinate a plausible-sounding reason, misread context, or judge
          near-identical cases inconsistently across different papers, and it
          only sees a bounded context (the title, abstract, and snippets around
          each match) rather than the full paper. Every verdict is shown with
          its reason so it can be checked against the source paper, and nothing
          it flags is ever deleted — a judged false positive or mentioned-only
          detection stays visible, just excluded from (or dimmed in) the counts.
        </li>

        <li>
          LLM verification is being rolled out gradually: the most recently
          processed week is judged first, and older weeks are backfilled in the
          background over time. Until a week has been judged, its detected
          languages are counted as provisionally studied.
        </li>

        <li>
          HTML extraction is preferred for accuracy, but the pipeline depends on
          the availability of arXiv HTML pages. If the HTML version is missing
          or incomplete, the pipeline falls back to the PDF (via Docling). If
          the PDF is also unavailable or has been withdrawn, only the abstract
          text is analysed.
        </li>

        <li>
          The pipeline only covers papers submitted to the <code>cs.CL</code> arXiv
          category (It may include multiple categories, which include <code
            >cs.CL</code
          >). Multilingual NLP papers appearing in adjacent categories (cs.AI,
          cs.LG, cs.CV, etc.), which exclude <code>cs.CL</code> are not captured.
        </li>
        <li>
          Papers are processed at fetch time. If an author updates a paper with
          new or removed language mentions, these are not reflected unless the
          pipeline re-runs for the same date window.
        </li><li>
          The pipeline runs once a week (every Tuesday), covering the previous
          week's arXiv announcement window. As a result, papers that fall across
          the date boundary may be missed in a given snapshot.
        </li>
      </ul>
    </article>
  </section>
  <section class="panel">
    <article>
      <h2>References</h2>
      <ol class="ref-list">
        <li>
          S. Ranathunga, N. De Silva, D. Jayakody, and A. Fernando, “Shoulders
          of Giants: A Look at the Degree and Utility of Openness in NLP
          Research,” in Proceedings of the 62nd Annual Meeting of the
          Association for Computational Linguistics (Volume 2: Short Papers),
          L.-W. Ku, A. Martins, and V. Srikumar, Eds., Bangkok, Thailand:
          Association for Computational Linguistics, Aug. 2024, pp. 519–529.
          doi: 10.18653/v1/2024.acl-short.48.
        </li>
        <li>
          S. Ranathunga and N. de Silva, “Some Languages are More Equal than
          Others: Probing Deeper into the Linguistic Disparity in the NLP
          World,” in Proceedings of the 2nd Conference of the Asia-Pacific
          Chapter of the Association for Computational Linguistics and the 12th
          International Joint Conference on Natural Language Processing (Volume
          1: Long Papers), Y. He, H. Ji, S. Li, Y. Liu, and C.-H. Chang, Eds.,
          Online only: Association for Computational Linguistics, Nov. 2022, pp.
          823–848. doi: 10.18653/v1/2022.aacl-main.62.
        </li>
        <li>
          P. Joshi, S. Santy, A. Budhiraja, K. Bali, and M. Choudhury, “The
          State and Fate of Linguistic Diversity and Inclusion in the NLP
          World,” in Proceedings of the 58th Annual Meeting of the Association
          for Computational Linguistics, D. Jurafsky, J. Chai, N. Schluter, and
          J. Tetreault, Eds., Online: Association for Computational Linguistics,
          Jul. 2020, pp. 6282–6293. doi: 10.18653/v1/2020.acl-main.560.
        </li>
        <li>
          C. Auer et al., “Docling Technical Report,” 2024, arXiv. doi:
          10.48550/ARXIV.2408.09869.
        </li>
      </ol>
    </article>
  </section>
</BaseLayout>
