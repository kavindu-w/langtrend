---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

const { title = 'LangTrend', description = 'LangTrend dashboard for language inclusion in NLP papers' } = Astro.props as {
  title?: string;
  description?: string;
};

const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHome = pathname === base + '/' || pathname === base;
const isAbout = pathname.startsWith(base + '/about');
const currentYear = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <a class="brand" href={import.meta.env.BASE_URL}>LangTrend</a>
        <nav class="navlinks" aria-label="Site navigation">
          <a class="navlink" href={import.meta.env.BASE_URL} aria-current={isHome ? 'page' : undefined}>
            <svg class="navicon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4 11.5 12 4l8 7.5V20a1 1 0 0 1-1 1h-4.5v-6.5h-5V21H5a1 1 0 0 1-1-1v-8.5Z" fill="currentColor" />
            </svg>
            <span>Home</span>
          </a>
          <a class="navlink" href={`${import.meta.env.BASE_URL}about/`} aria-current={isAbout ? 'page' : undefined}>
            <svg class="navicon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M11 10h2v7h-2zm0-4h2v2h-2z" fill="currentColor" />
              <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Z" fill="currentColor" />
            </svg>
            <span>About</span>
          </a>
        </nav>
      </header>
      <main>
        <slot />

        <footer class="page-footer panel">
          <h2>Contact</h2>
          <a
            class="footer-link footer-mail"
            href="mailto:akwarnakulasuriya@gmail.com"
            aria-label="Email akwarnakulasuriya@gmail.com"
            title="Email akwarnakulasuriya@gmail.com"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm0 2v.23l8 5.33 8-5.33V7H4Zm16 10V9.57l-7.45 4.96a1 1 0 0 1-1.1 0L4 9.57V17h16Z"
                fill="currentColor"></path>
            </svg>
            <span>Email</span>
          </a>
          <a
            class="footer-link footer-github"
            href="https://github.com/kavindu-w/langtrend"
            target="_blank"
            rel="noreferrer"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M12 2C6.48 2 2 6.48 2 12.02c0 4.42 2.87 8.17 6.84 9.49.5.09.66-.22.66-.48 0-.24-.01-.87-.02-1.71-2.78.61-3.37-1.34-3.37-1.34-.46-1.17-1.12-1.49-1.12-1.49-.92-.63.07-.62.07-.62 1.02.07 1.56 1.05 1.56 1.05.9 1.54 2.36 1.1 2.93.84.09-.66.35-1.1.64-1.35-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.03a9.5 9.5 0 0 1 5 0c1.9-1.3 2.74-1.03 2.74-1.03.55 1.37.2 2.39.1 2.64.64.7 1.02 1.6 1.02 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.86 0 1.34-.01 2.42-.01 2.75 0 .26.17.57.67.47A10.02 10.02 0 0 0 22 12.02C22 6.48 17.52 2 12 2Z"
                fill="currentColor"></path>
            </svg>
            <span>GitHub<span class="sr-only"> (opens in new tab)</span></span>
          </a>
          <p class="copyright-line">
            © {currentYear} LangTrend. All rights reserved.
          </p>
        </footer>
      </main>
    </div>

    <button id="go-top-button" class="go-top-button" type="button" aria-label="Go to top" title="Go to top" data-tooltip="Go to Top">
      <svg class="navicon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 4 5 11h4v9h6v-9h4l-7-7Z" fill="currentColor" />
      </svg>
    </button>

    <script>
      const goTopButton = document.getElementById('go-top-button');

      if (goTopButton) {
        const updateVisibility = () => {
          goTopButton.classList.toggle('is-visible', window.scrollY > 300);
        };

        goTopButton.addEventListener('click', () => {
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduced ? 'instant' : 'smooth' });
        });

        window.addEventListener('scroll', updateVisibility, { passive: true });
        window.addEventListener('load', updateVisibility);
        updateVisibility();
      }
    </script>
  </body>
</html>
