---
const { manifest } = Astro.props;
const judge = manifest.counts.judge ?? null;
const cards: { label: string; value: string | number; sub?: string }[] = [
  { label: 'Papers scanned', value: manifest.counts.papers },
  { label: 'Flagged papers', value: manifest.counts.flagged_papers },
  { label: 'Unique languages', value: manifest.counts.unique_languages },
  { label: 'Window', value: `${manifest.window_days} days` },
];
if (judge && judge.judged_papers > 0) {
  cards.push({
    label: 'LLM-verified papers',
    value: judge.judged_papers,
    sub: `${judge.studied} studied · ${judge.mentioned_only} mentioned-only · ${judge.false_positive} excluded`,
  });
}
---
<section class="stat-grid">
  {cards.map((card) => (
    <article class="stat-card">
      <span>{card.label}</span>
      <strong>{card.value}</strong>
      {card.sub && <small class="stat-sub">{card.sub}</small>}
    </article>
  ))}
</section>
