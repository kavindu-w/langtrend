      </article>
    </div>

    {(['week', 'month', 'year'] as TrendGranularity[]).map((gran) => {
      const {
        granularity: trendGranularity,
        granularityLabel: trendGranularityLabel,
        periods: trendPeriods,
        topLanguages: topTrendLanguages,
        trendSeries,
        endpointLabelY: trendEndpointLabelY,
        groupedHeight: trendGroupedHeight,
        groupedMargins: trendGroupedMargins,
        groupedScrollPx: trendGroupedScrollPx,
        groupedWidth: trendGroupedWidth,
        groupedInnerWidth: trendGroupedInnerWidth,
        groupedInnerHeight: trendGroupedInnerHeight,
        groupedScale: trendGroupedScale,
        groupedMax: trendGroupedMax,
        groupedY: trendGroupedY,
        topLangHeight: trendTopLanguageHeight,
        topLangMargins: trendTopLanguageMargins,
        topLangScrollPx: trendTopLanguageScrollPx,
        topLangWidth: trendTopLanguageWidth,
        topLangInnerWidth: trendTopLanguageInnerWidth,
        topLangInnerHeight: trendTopLanguageInnerHeight,
        topLangScale: trendTopLanguageScale,
        topLangMax: trendTopLanguageMax,
        topLangY: trendTopLanguageY,
        classHeight: trendClassHeight,
        classMargins: trendClassMargins,
        classScrollPx: trendClassScrollPx,
        classWidth: trendClassWidth,
        classInnerWidth: trendClassInnerWidth,
        classInnerHeight: trendClassInnerHeight,
        classScale: trendClassScale,
        classBars: trendClassBars,
        uniqueHeight: trendUniqueHeight,
        uniqueMargins: trendUniqueMargins,
        uniqueScrollPx: trendUniqueScrollPx,
        uniqueWidth: trendUniqueWidth,
        uniqueInnerWidth: trendUniqueInnerWidth,
        uniqueInnerHeight: trendUniqueInnerHeight,
        uniqueScale: trendUniqueScale,
        uniqueMax: trendUniqueMax,
        uniqueY: trendUniqueY,
        bumpMaxRank,
        bumpSvgHeight,
        bumpMargins,
        bumpScrollPx,
        bumpSvgWidth,
        bumpInnerWidth,
        bumpInnerHeight,
        bumpYScale,
        bumpXScale,
        bumpSeriesData,
        bumpSegments,
        bumpLeftLabelY,
        bumpRightLabelY,
      } = trendDataByGranularity[gran];
      return (
        <div class="trend-granularity-pane" data-granularity={gran} style={gran !== 'week' ? 'display:none' : ''}>
          <div class="overall-summary-grid" style="margin-bottom:14px">
            <div class="trend-view-controls trend-view-controls-inline">
              <button type="button" class={`trend-view-chip ${trendGranularity === 'week' ? 'is-active' : ''}`} data-trend-mode="week" aria-pressed={trendGranularity === 'week' ? 'true' : 'false'}>Week</button>
              <button type="button" class={`trend-view-chip ${trendGranularity === 'month' ? 'is-active' : ''}`} data-trend-mode="month" aria-pressed={trendGranularity === 'month' ? 'true' : 'false'}>Month</button>
              <button type="button" class={`trend-view-chip ${trendGranularity === 'year' ? 'is-active' : ''}`} data-trend-mode="year" aria-pressed={trendGranularity === 'year' ? 'true' : 'false'}>Year</button>
              <span class="chart-caption">Overall trends grouped by {trendGranularityLabel.toLowerCase()}</span>
      </div>
      <div class="coverage-summary-card">
        <div class="chart-subpanel-head">
            <div>
              <h3>Overall coverage</h3>
              <p>Papers scanned all time vs. papers with at least one detected language.</p>
            </div>
          </div>
      <svg class="chart-svg coverage-pie-svg" width="100%" height="260" viewBox="0 0 520 260" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Pie chart of total papers analyzed versus papers with detected languages across all weeks">
        <g>
          {overallCoveragePie.map((slice) => (
            <g>
              <path d={slice.path} fill={slice.color} stroke="white" stroke-width="1.5"></path>
              <path d={slice.calloutPath} fill="none" stroke="var(--text)" stroke-dasharray="3 4" stroke-width="1"></path>
              <text
                x={260 + Math.cos(slice.midAngle) * 60}
                y={130 + Math.sin(slice.midAngle) * 60 + 4}
                text-anchor="middle"
                class="chart-value"
                style={`fill:${slice.label === 'Not flagged' ? 'var(--text)' : '#fff'};font-size:0.6rem;font-weight:800`}
              >
                {coverageSlicePercent(slice.value, trendOverallPapers)}
              </text>
              <text x={slice.labelX + (slice.side === 'right' ? 8 : -8)} y={slice.labelY + 4} text-anchor={slice.side === 'right' ? 'start' : 'end'} class="chart-axis-label">
                {coverageSliceLines(slice.label, slice.value).map((line, index) => (
                  <tspan x={slice.labelX + (slice.side === 'right' ? 8 : -8)} dy={index === 0 ? 0 : 14}>{line}</tspan>
                ))}
              </text>
            </g>
          ))}
          <circle cx="260" cy="130" r="44" fill="var(--panel)" stroke="var(--line)"></circle>
          <text x="260" y="122" text-anchor="middle" class="chart-value">
            <tspan x="260" dy="0">{trendOverallPapers}</tspan>
            <tspan x="260" dy="14" class="chart-axis-label">papers</tspan>
          </text>
        </g>
      </svg>
      </div>
      <article class="chart-subpanel">
            <div class="chart-subpanel-head">
              <div>
                <h3>{trendGranularityLabel} scan volume</h3>
                <p>Total papers scanned in each {trendGranularity} period, split by papers with and without detected languages.</p>
              </div>
            </div>
            <div class="chart-legend-inline" style="justify-content:center">
              <span><span class="coverage-dot abstract"></span>Other papers</span>
              <span><span class="coverage-dot html"></span>Papers with detected languages</span>
            </div>
            {trendPeriods.length > 0 ? (
              <div class="chart-scroll trend-period-chart-scroll">
                <svg class="chart-svg" width={trendGroupedScrollPx === null ? "100%" : undefined} style={trendGroupedScrollPx !== null ? `width:${trendGroupedScrollPx}px;max-width:none` : undefined} viewBox={`0 0 ${trendGroupedWidth} ${trendGroupedHeight}`} preserveAspectRatio="xMinYMin meet" role="img" aria-label={`Stacked bar chart of ${trendGranularity} scan volume`}>
                  <g transform={`translate(${trendGroupedMargins.left} ${trendGroupedMargins.top})`}>
                    {trendGroupedY.ticks(4).map((tick) => (
                      <g transform={`translate(0 ${trendGroupedY(tick)})`}>
                        <line x1="0" x2={trendGroupedInnerWidth} y1="0" y2="0" class="chart-grid-line"></line>
                        <text x="-10" y="4" text-anchor="end" class="chart-axis-label">{tick}</text>
                      </g>
                    ))}
                    {trendPeriods.map((period) => {
                      const x = trendGroupedScale(period.label) || 0;
                      const barWidth = trendGroupedScale.bandwidth();
                      const totalHeight = (period.papers / trendGroupedMax) * trendGroupedInnerHeight;
                      const flaggedHeight = (period.flaggedPapers / trendGroupedMax) * trendGroupedInnerHeight;
                      const otherHeight = Math.max(totalHeight - flaggedHeight, 0);
                      const yTop = trendGroupedInnerHeight - totalHeight;
                      const otherCount = Math.max(period.papers - period.flaggedPapers, 0);
                      return (
                        <g>
                          {otherHeight > 0 && <path d={roundedTopRect(x, yTop, barWidth, otherHeight, 5)} fill="rgba(32, 22, 19, 0.18)"></path>}
                          {flaggedHeight > 0 && <path d={roundedBottomRect(x, trendGroupedInnerHeight - flaggedHeight, barWidth, flaggedHeight, 5)} fill="#0f6c5d"></path>}
                          {otherHeight > 14 && (
                            <text x={x + barWidth / 2} y={yTop + otherHeight / 2 + 4} text-anchor="middle" class="chart-value">{otherCount}</text>
                          )}
                          {flaggedHeight > 14 && (
                            <text x={x + barWidth / 2} y={trendGroupedInnerHeight - flaggedHeight / 2 + 4} text-anchor="middle" class="chart-value" style="fill:#fff">{period.flaggedPapers}</text>
                          )}
                          <text x={x + barWidth / 2} y={trendGroupedInnerHeight + 18} text-anchor="middle" class="chart-label">{period.label}</text>
                        </g>
                      );
                    })}
                  </g>
                </svg>
              </div>
            ) : (
              <p class="placeholder-text">Scan volume will appear once multiple snapshots are available.</p>
            )}
      </article>
    </div>

    <div class="overall-trend-grid">
          <article class="chart-subpanel">
            <div class="chart-subpanel-head">
              <div>
                <h3>Resource class mix by {trendGranularity}</h3>
                <p>Proportional share of detected languages per resource-availability tier each {trendGranularity}.</p>
              </div>
            </div>
            <div class="class-legend">
              {CLASS_LABELS.map((label, classId) => (
                <div class="class-legend-item">
                  <span class="trend-legend-swatch" style={`background:${classColorForId(classId)}`}></span>
                  <span>{label}{classId === 0 ? ' (lowest)' : classId === CLASS_LABELS.length - 1 ? ' (highest)' : ''}</span>
                </div>
              ))}
            </div>
            {trendPeriods.length > 0 ? (
              <div class="chart-scroll">
                <svg class="chart-svg" width={trendClassScrollPx === null ? "100%" : undefined} style={trendClassScrollPx !== null ? `width:${trendClassScrollPx}px;max-width:none` : undefined} viewBox={`0 0 ${trendClassWidth} ${trendClassHeight}`} preserveAspectRatio="xMinYMin meet" role="img" aria-label={`100 percent stacked bar chart of resource class mix by ${trendGranularity}`}>
                  <g transform={`translate(${trendClassMargins.left} ${trendClassMargins.top})`}>
                    {trendPeriods.map((period, index) => {
                      const x = trendClassScale(period.label) || 0;
                      const barWidth = trendClassScale.bandwidth();
                      const bar = trendClassBars[index];
                      return (
                        <g>
                          {bar.segments.map((segment) => (
                            <rect x={x} y={segment.y} width={barWidth} height={Math.max(segment.height, 0)} fill={segment.color}>
                              <title>{`${segment.label}: ${segment.count}`}</title>
                            </rect>
                          ))}
                          <text x={x + barWidth / 2} y={trendClassInnerHeight + 18} text-anchor="middle" class="chart-label">{period.label}</text>
                        </g>
                      );
                    })}
                  </g>
                </svg>
              </div>
            ) : (
              <p class="placeholder-text">Class mix will appear once multiple snapshots are available.</p>
            )}
          </article>

          <article class="chart-subpanel">
            <div class="chart-subpanel-head">
              <div>
                <h3>Unique languages per {trendGranularity}</h3>
                <p>How many distinct languages were mentioned in each {trendGranularity} period — a measure of breadth.</p>
              </div>
            </div>
            {trendPeriods.length > 0 ? (
              <div class="chart-scroll trend-period-chart-scroll">
                <svg class="chart-svg" width={trendUniqueScrollPx === null ? "100%" : undefined} style={trendUniqueScrollPx !== null ? `width:${trendUniqueScrollPx}px;max-width:none` : undefined} viewBox={`0 0 ${trendUniqueWidth} ${trendUniqueHeight}`} preserveAspectRatio="xMinYMin meet" role="img" aria-label={`Line chart of unique languages per ${trendGranularity}`}>
                  <g transform={`translate(${trendUniqueMargins.left} ${trendUniqueMargins.top})`}>
                    {trendUniqueY.ticks(4).map((tick) => (
                      <g transform={`translate(0 ${trendUniqueY(tick)})`}>
                        <line x1="0" x2={trendUniqueInnerWidth} y1="0" y2="0" class="chart-grid-line"></line>
                        <text x="-10" y="4" text-anchor="end" class="chart-axis-label">{tick}</text>
                      </g>
                    ))}
                    <path
                      d={trendPeriods.map((period, i) => {
                        const x = (trendUniqueScale(period.label) || 0) + trendUniqueScale.bandwidth() / 2;
                        const y = trendUniqueY(period.uniqueLanguages);
                        return `${i === 0 ? 'M' : 'L'}${x},${y}`;
                      }).join(' ')}
                      fill="none" stroke="#7c3aed" stroke-width="2.5" stroke-linejoin="round"
                    />
                    {trendPeriods.map((period) => {
                      const x = (trendUniqueScale(period.label) || 0) + trendUniqueScale.bandwidth() / 2;
                      const y = trendUniqueY(period.uniqueLanguages);
                      const labelY = Math.max(12, Math.min(y - 10, trendUniqueInnerHeight - 12));
                      return (
                        <g>
                          <circle cx={x} cy={y} r="5" fill="#7c3aed" stroke="white" stroke-width="2"></circle>
                          <text x={x} y={labelY} text-anchor="middle" class="chart-value">{period.uniqueLanguages}</text>
                          <text x={x} y={trendUniqueInnerHeight + 18} text-anchor="middle" class="chart-label">{period.label}</text>
                        </g>
                      );
                    })}
                  </g>
                </svg>
              </div>
            ) : (
              <p class="placeholder-text">Unique-language counts will appear once multiple snapshots are available.</p>
            )}
          </article>

          <article class="chart-subpanel chart-subpanel-wide">
            <div class="chart-subpanel-head">
              <div>
                <h3>Top-language trends</h3>
                <p>Mention counts for the top 10 languages in the selected {trendGranularity} view, tracked across all available periods.</p>
              </div>
            </div>
            {trendPeriods.length > 0 && topTrendLanguages.length > 0 ? (
              <div class="trend-line-layout">
                <div class="chart-scroll trend-period-chart-scroll">
                  <svg class="chart-svg" width={trendTopLanguageScrollPx === null ? "100%" : undefined} style={trendTopLanguageScrollPx !== null ? `width:${trendTopLanguageScrollPx}px;max-width:none` : undefined} height={trendTopLanguageScrollPx !== null ? trendTopLanguageHeight : undefined} viewBox={`0 0 ${trendTopLanguageWidth} ${trendTopLanguageHeight}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={`Line chart of top-language trends across ${trendGranularity}s`}>
                    <g transform={`translate(${trendTopLanguageMargins.left} ${trendTopLanguageMargins.top})`}>
                      {trendTopLanguageY.ticks(6).map((tick) => (
                        <g transform={`translate(0 ${trendTopLanguageY(tick)})`}>
                          <line x1="0" x2={trendTopLanguageInnerWidth} y1="0" y2="0" class="chart-grid-line"></line>
                          <text x="-10" y="4" text-anchor="end" class="chart-axis-label">{tick}</text>
                        </g>
                      ))}
                      {trendSeries.map((series, idx) => {
                        const lastPt = series.points[series.points.length - 1];
                        const labelY = trendEndpointLabelY[idx];
                        return (
                          <g>
                            <path d={series.path} fill="none" stroke={series.color} stroke-width="2.5"></path>
                            {lastPt && lastPt.value > 0 && (
                              <g>
                                <path d={`M ${lastPt.x + 14} ${lastPt.y} L ${trendTopLanguageInnerWidth + 10} ${labelY}`} fill="none" stroke={series.color} stroke-dasharray="3 4" stroke-width="1"></path>
                                {pfpWarn(series.language) ? (
                                  <g class="chart-warn-label" data-pfp-reason={pfpWarn(series.language)}>
                                    <text x={trendTopLanguageInnerWidth + 14} y={labelY + 4} class="chart-axis-label" style={`fill:${series.color};font-weight:700`}>{series.language}<tspan class="warn-star-svg" dx="2" dy="-3" font-size="0.5em">★</tspan> · {lastPt.value}</text>
                                  </g>
                                ) : (
                                  <text x={trendTopLanguageInnerWidth + 14} y={labelY + 4} class="chart-axis-label" style={`fill:${series.color};font-weight:700`}>{series.language} · {lastPt.value}</text>
                                )}
                              </g>
                            )}
                            {series.points.map((point) => (
                              <path d={markerPath(idx, point.x, point.y, 4)} fill={series.color} stroke="white" stroke-width="1.2"></path>
                            ))}
                          </g>
                        );
                      })}
                      {trendPeriods.map((period) => {
                        const x = trendTopLanguageScale(period.label) || 0;
                        return (
                          <text x={x + trendTopLanguageScale.bandwidth() / 2} y={trendTopLanguageInnerHeight + 18} text-anchor="middle" class="chart-label">{period.label}</text>
                        );
                      })}
                    </g>
                  </svg>
                </div>
              </div>
            ) : (
              <p class="placeholder-text">Multi-period language trend lines will appear once data is available.</p>
            )}
          </article>

          <article class="chart-subpanel chart-subpanel-wide">
            <div class="chart-subpanel-head">
              <div>
                <h3>Language rank trajectory</h3>
                <p>Rank 1 = most mentions in that period. Tracks the languages that appear in each top 10 across the selected {trendGranularity} view.</p>
              </div>
            </div>
            {trendPeriods.length >= 2 && bumpSeriesData.length > 0 ? (
              <div class="chart-scroll bump-chart-scroll">
                <svg class="chart-svg" width={bumpScrollPx === null ? "100%" : undefined} style={bumpScrollPx !== null ? `width:${bumpSvgWidth}px;max-width:none` : undefined} height={bumpScrollPx !== null ? bumpSvgHeight : undefined} viewBox={`0 0 ${bumpSvgWidth} ${bumpSvgHeight}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={`Language rank bump chart across ${trendGranularity}s`}>
                  <g transform={`translate(${bumpMargins.left} ${bumpMargins.top})`}>
                    {Array.from({ length: bumpMaxRank }, (_, i) => i + 1).map((rank) => (
                      <line x1="0" x2={bumpInnerWidth} y1={bumpYScale(rank)} y2={bumpYScale(rank)} class="chart-grid-line"></line>
                    ))}
                    {trendPeriods.map((period) => (
                      <text x={(bumpXScale(period.label) || 0) + bumpXScale.bandwidth() / 2} y={bumpInnerHeight + 34} text-anchor="middle" class="chart-label">{period.label}</text>
                    ))}
                    {bumpSegments.map((segment) => (
                      <path d={segment.d} fill="none" stroke={segment.color} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    ))}
                    {bumpSeriesData.map((series, seriesIdx) => (
                      <g>
                        {series.firstPt && (
                          <g>
                            <path d={`M ${series.firstPt.x - 14} ${series.firstPt.y} L ${-14} ${bumpLeftLabelY[seriesIdx]}`} fill="none" stroke={series.labelColor} stroke-dasharray="3 4" stroke-width="1"></path>
                            {pfpWarn(series.language) ? (
                              <g class="chart-warn-label" data-pfp-reason={pfpWarn(series.language)}>
                                <text x={-16} y={bumpLeftLabelY[seriesIdx] + 5} text-anchor="end" class="chart-axis-label" style={`fill:${series.labelColor};font-weight:700`}>{series.language}<tspan class="warn-star-svg" dx="2" dy="-3" font-size="0.5em">★</tspan></text>
                              </g>
                            ) : (
                              <text x={-16} y={bumpLeftLabelY[seriesIdx] + 5} text-anchor="end" class="chart-axis-label" style={`fill:${series.labelColor};font-weight:700`}>{series.language}</text>
                            )}
                          </g>
                        )}
                        {series.lastPt && (
                          <g>
                            <path d={`M ${series.lastPt.x + 14} ${series.lastPt.y} L ${bumpInnerWidth + 14} ${bumpRightLabelY[seriesIdx]}`} fill="none" stroke={series.labelColor} stroke-dasharray="3 4" stroke-width="1"></path>
                            {pfpWarn(series.language) ? (
                              <g class="chart-warn-label" data-pfp-reason={pfpWarn(series.language)}>
                                <text x={bumpInnerWidth + 16} y={bumpRightLabelY[seriesIdx] + 5} text-anchor="start" class="chart-axis-label" style={`fill:${series.labelColor};font-weight:700`}>{series.language}<tspan class="warn-star-svg" dx="2" dy="-3" font-size="0.5em">★</tspan></text>
                              </g>
                            ) : (
                              <text x={bumpInnerWidth + 16} y={bumpRightLabelY[seriesIdx] + 5} text-anchor="start" class="chart-axis-label" style={`fill:${series.labelColor};font-weight:700`}>{series.language}</text>
                            )}
                          </g>
                        )}
                        {series.points.map((point) => point && (() => {
                          const rankColor = BUMP_RANK_COLORS[point.rank - 1] ?? BUMP_RANK_COLORS[BUMP_RANK_COLORS.length - 1];
                          const isLight = point.rank >= 6;
                          const textColor = isLight ? '#000' : '#fff';
                          return (
                            <g>
                              <circle cx={point.x} cy={point.y} r="14" fill={rankColor} stroke="#000" stroke-width="1.5"></circle>
                              <text x={point.x} y={point.y + 5} text-anchor="middle" style={`fill:${textColor};font-size:0.65rem;font-weight:700`}>{point.rank}</text>
                            </g>
                          );
                        })())}
                      </g>
                    ))}
                  </g>
                </svg>
              </div>
            ) : (
              <p class="placeholder-text">Language rank trajectory will appear once multiple periods are available.</p>
            )}
          </article>
        </div>
        </div>
      );
    })}
  </details>
  <div id="chart-pfp-tooltip" class="review-popover-body chart-pfp-tooltip" aria-hidden="true">
    <strong>⚠ Manual verification may be needed</strong>
    <p id="chart-pfp-tooltip-reason"></p>
  </div>

  <script is:inline>
    const trendStateStorageKey = 'langtrend:overall-trend-details-state';
    const trendScrollStorageKey = 'langtrend:overall-trend-scroll-y';
    const trendModeStorageKey = 'langtrend:trend-mode';

    function switchTrendPane(mode) {
      document.querySelectorAll('.trend-granularity-pane').forEach(function(pane) {
        pane.style.display = pane.dataset.granularity === mode ? '' : 'none';
      });
      document.querySelectorAll('.trend-view-chip').forEach(function(btn) {
        var active = btn.getAttribute('data-trend-mode') === mode;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      try { history.replaceState(null, '', '?trend=' + mode); } catch {}
      try { sessionStorage.setItem(trendModeStorageKey, mode); } catch {}
    }

    // Restore trend mode from URL param or session storage
    try {
      var _trendMode = new URLSearchParams(location.search).get('trend') || sessionStorage.getItem(trendModeStorageKey) || 'week';
      if (_trendMode !== 'week') switchTrendPane(_trendMode);
    } catch {}

    try { window.history.scrollRestoration = 'manual'; } catch {}

    // Apply collapse state immediately, before toggle listeners are attached,
    // to avoid a flash of all-expanded sections after filter-button navigation.
    try {
      const _rawState = sessionStorage.getItem(trendStateStorageKey);
      if (_rawState) {
        const _state = JSON.parse(_rawState);
        document.querySelectorAll('details').forEach((el, i) => {
          const key = el.id || el.getAttribute('data-trend-panel') || el.getAttribute('name') || `details-${i}`;
          if (Object.prototype.hasOwnProperty.call(_state, key)) el.open = Boolean(_state[key]);
        });
      }
    } catch {}

    const saveTrendState = () => {
      try {
        sessionStorage.setItem(trendScrollStorageKey, String(window.scrollY));
        const state = {};
        document.querySelectorAll('details').forEach((el, i) => {
          const key = el.id || el.getAttribute('data-trend-panel') || el.getAttribute('name') || `details-${i}`;
          state[key] = el.open;
        });
        sessionStorage.setItem(trendStateStorageKey, JSON.stringify(state));
      } catch {}
    };

    // Add toggle listeners after the initial restore so restoration-triggered
    // toggles don't overwrite sessionStorage with a partially-restored state.
    document.querySelectorAll('details').forEach((el) => el.addEventListener('toggle', saveTrendState));

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest('[data-trend-mode]') : null;
      if (!target) return;
      saveTrendState();
      switchTrendPane(target.getAttribute('data-trend-mode'));
    });

    window.addEventListener('beforeunload', saveTrendState);

    // Chart language warning tooltips
    const _pfpTip = document.getElementById('chart-pfp-tooltip');
    const _pfpReason = document.getElementById('chart-pfp-tooltip-reason');
    function _showPfpTip(el, reason) {
      if (!_pfpTip || !_pfpReason) return;
      _pfpReason.textContent = reason;
      const rect = el.getBoundingClientRect();
      const tipW = 280;
      let left = rect.left + window.scrollX + rect.width / 2 - tipW / 2;
      left = Math.max(8, Math.min(left, window.innerWidth + window.scrollX - tipW - 8));
      _pfpTip.style.left = left + 'px';
      _pfpTip.style.top = (rect.top + window.scrollY - 8) + 'px';
      _pfpTip.style.transform = 'translateY(-100%)';
      _pfpTip.style.opacity = '1';
      _pfpTip.style.visibility = 'visible';
      _pfpTip.removeAttribute('aria-hidden');
    }
    function _hidePfpTip() {
      if (!_pfpTip) return;
      _pfpTip.style.opacity = '0';
      _pfpTip.style.visibility = 'hidden';
      _pfpTip.setAttribute('aria-hidden', 'true');
    }
    document.querySelectorAll('.chart-warn-label').forEach(function(el) {
      const reason = el.getAttribute('data-pfp-reason') || '';
      el.addEventListener('mouseenter', function() { _showPfpTip(el, reason); });
      el.addEventListener('mouseleave', _hidePfpTip);
      el.addEventListener('focusin', function() { _showPfpTip(el, reason); });
      el.addEventListener('focusout', _hidePfpTip);
    });

    // Restore scroll position. Try immediately on load (collapse state was
    // applied synchronously so layout height is already correct), then
    // retry once after a frame to cover any deferred rendering.
    window.addEventListener('load', () => {
      try {
        const scrollY = Number(sessionStorage.getItem(trendScrollStorageKey)) || 0;
        if (scrollY > 0) {
          window.scrollTo(0, scrollY);
          requestAnimationFrame(() => window.scrollTo(0, scrollY));
        }
      } catch {}
    });

    // --- Period mode enhancements ---
    (function() {
      function fmtPeriodWeekLabel(slug) {
        var start = new Date(slug + 'T12:00:00');
        var end = new Date(start); end.setDate(end.getDate() + 6);
        var sm = start.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
        var em = end.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
        return sm + '–' + em;
      }
      function fmtShortLabel(slug) {
        var d = new Date(slug + 'T12:00:00');
        return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
      }

      function roundedTopRectPath(x, y, w, h, r) {
        r = Math.min(r, w / 2, Math.max(h / 2, 0));
        if (h <= 0) return '';
        return 'M '+(x+r)+','+y+' H '+(x+w-r)+' Q '+(x+w)+','+y+' '+(x+w)+','+(y+r)+' V '+(y+h)+' H '+x+' V '+(y+r)+' Q '+x+','+y+' '+(x+r)+','+y+' Z';
      }

      function roundedBottomRectPath(x, y, w, h, r) {
        r = Math.min(r, w / 2, Math.max(h / 2, 0));
        if (h <= 0) return '';
        return 'M '+x+','+y+' H '+(x+w)+' V '+(y+h-r)+' Q '+(x+w)+','+(y+h)+' '+(x+w-r)+','+(y+h)+' H '+(x+r)+' Q '+x+','+(y+h)+' '+x+','+(y+h-r)+' Z';
      }

      function pieSlicePath(cx, cy, radius, startAngle, endAngle) {
        var start = {
          x: cx + radius * Math.cos(startAngle),
          y: cy + radius * Math.sin(startAngle),
        };
        var end = {
          x: cx + radius * Math.cos(endAngle),
          y: cy + radius * Math.sin(endAngle),
        };
        var largeArcFlag = endAngle - startAngle > Math.PI ? 1 : 0;
        return 'M '+cx+' '+cy+' L '+start.x+' '+start.y+' A '+radius+' '+radius+' 0 '+largeArcFlag+' 1 '+end.x+' '+end.y+' Z';
      }

      function buildPieSlices(items, centerX, centerY, radius, startOffset, labelOffset) {
        var total = Math.max(1, items.reduce(function(sum, item) { return sum + Math.max(item.value || 0, 0); }, 0));
        var angle = startOffset;
        var slices = [];

        items.forEach(function(item) {
          if ((item.value || 0) <= 0) {
            return;
          }

          var sweep = (item.value / total) * Math.PI * 2;
          var startAngle = angle;
          var endAngle = angle + sweep;
          var midAngle = startAngle + sweep / 2;
          var side = Math.cos(midAngle) >= 0 ? 'right' : 'left';
          var calloutStart = {
            x: centerX + radius * Math.cos(midAngle),
            y: centerY + radius * Math.sin(midAngle),
          };
          var calloutElbow = {
            x: centerX + (radius + 16) * Math.cos(midAngle),
            y: centerY + (radius + 16) * Math.sin(midAngle),
          };
          var labelX = centerX + (side === 'right' ? radius + labelOffset : -(radius + labelOffset));
          var labelY = centerY + Math.sin(midAngle) * (radius + 22);

          slices.push({
            ...item,
            startAngle: startAngle,
            endAngle: endAngle,
            midAngle: midAngle,
            path: pieSlicePath(centerX, centerY, radius, startAngle, endAngle),
            calloutPath: 'M '+calloutStart.x+' '+calloutStart.y+' L '+calloutElbow.x+' '+calloutElbow.y+' L '+labelX+' '+labelY,
            labelX: labelX,
            labelY: labelY,
            side: side,
          });
          angle = endAngle;
        });

        var leftSlices = slices.filter(function(slice) { return slice.side === 'left'; }).sort(function(a, b) { return a.labelY - b.labelY; });
        var rightSlices = slices.filter(function(slice) { return slice.side === 'right'; }).sort(function(a, b) { return a.labelY - b.labelY; });

        function settle(collection) {
          var previousY = -Infinity;
          collection.forEach(function(slice) {
            slice.labelY = Math.max(slice.labelY, previousY + 16);
            previousY = slice.labelY;
          });
        }

        settle(leftSlices);
        settle(rightSlices);
        return slices;
      }
      function roundedTopRectPath(x, y, w, h, r) {
        r = Math.min(r, w / 2, Math.max(h / 2, 0));
        if (h <= 0) return '';
        return 'M '+(x+r)+','+y+' H '+(x+w-r)+' Q '+(x+w)+','+y+' '+(x+w)+','+(y+r)+' V '+(y+h)+' H '+x+' V '+(y+r)+' Q '+x+','+y+' '+(x+r)+','+y+' Z';
      }
      function roundedBottomRectPath(x, y, w, h, r) {
        r = Math.min(r, w / 2, Math.max(h / 2, 0));
        if (h <= 0) return '';
        return 'M '+x+','+y+' H '+(x+w)+' V '+(y+h-r)+' Q '+(x+w)+','+(y+h)+' '+(x+w-r)+','+(y+h)+' H '+(x+r)+' Q '+x+','+(y+h)+' '+x+','+(y+h-r)+' Z';
      }

      var weekMetaEl = document.getElementById('all-weeks-meta');
      if (!weekMetaEl) return;
      var allWeeksMeta;
      try { allWeeksMeta = JSON.parse(weekMetaEl.textContent || '[]'); } catch(e) { return; }
      var langClassesMetaEl = document.getElementById('lang-classes-meta');
      var langClassesMeta = {};
      try { langClassesMeta = JSON.parse(langClassesMetaEl && langClassesMetaEl.textContent || '{}'); } catch(e) { langClassesMeta = {}; }

      function classIndexForLanguage(language) {
        for (var classIdStr in langClassesMeta) {
          if (!Object.prototype.hasOwnProperty.call(langClassesMeta, classIdStr)) continue;
          var languages = langClassesMeta[classIdStr] || [];
          if (Array.isArray(languages) && languages.indexOf(language) !== -1) {
            return Number(classIdStr);
          }
        }
        return 0;
      }

      function classColorForLanguage(language) {
        return CLASS_COLORS_JS[classIndexForLanguage(language)] || CLASS_COLORS_JS[0];
      }

      var anchorPath = location.pathname.replace(/index\.html$/, '').replace(/\/$/, '');
      var pathParts = anchorPath.split('/');
      var anchorSlug = pathParts[pathParts.length - 1];

      var _params = new URLSearchParams(location.search);
      var fromParam = _params.get('from');

      var periodSwitcher = document.getElementById('period-week-switcher');
      var periodTrendsPanel = document.getElementById('period-trends-panel');

      if (!fromParam) return;

      if (periodSwitcher) periodSwitcher.style.display = '';
      if (periodTrendsPanel) periodTrendsPanel.style.display = '';

      var sortedSlugs = allWeeksMeta.map(function(w) { return w.weekStart; }).sort();
      var fromIdx = sortedSlugs.indexOf(fromParam);
      var toIdx = sortedSlugs.indexOf(anchorSlug);
      if (fromIdx === -1 || toIdx === -1) return;

      var periodSlugs = sortedSlugs.slice(Math.min(fromIdx, toIdx), Math.max(fromIdx, toIdx) + 1);
      var periodData = periodSlugs.map(function(slug) {
        return allWeeksMeta.find(function(w) { return w.weekStart === slug; });
      }).filter(Boolean);

      // Week switcher: populate and wire change handler
      // --- Chart re-rendering helpers ---
      var CLASS_COLORS_JS = ['#cfe8f3','#a2d4ec','#73bfe2','#46abdb','#1696d2','#12719e'];
      var CLASS_LABELS_JS = ['Class 0','Class 1','Class 2','Class 3','Class 4','Class 5'];
      var TREND_LINE_COLORS_JS = ['#1696d2','#000000','#d2d2d2','#fdbf11','#55b748','#ec008b','#0a4c6a','#db2b27','#5c5859','#a2d4ec'];
      var BUMP_RANK_COLORS_JS = ['#1A2E19','#2C5C2D','#347032','#408941','#55B748','#78C26D','#8ABE80','#98CF90','#BCDEB4','#DCEDD9'];

      function sectorPathSVG(cx, cy, r, innerR, startDeg, sweepDeg) {
        if (sweepDeg >= 360) sweepDeg = 359.99;
        if (sweepDeg <= 0) return '';
        var s = (startDeg - 90) * Math.PI / 180;
        var e = (startDeg + sweepDeg - 90) * Math.PI / 180;
        var x1o = cx + r*Math.cos(s), y1o = cy + r*Math.sin(s);
        var x2o = cx + r*Math.cos(e), y2o = cy + r*Math.sin(e);
        var x1i = cx + innerR*Math.cos(e), y1i = cy + innerR*Math.sin(e);
        var x2i = cx + innerR*Math.cos(s), y2i = cy + innerR*Math.sin(s);
        var lg = sweepDeg > 180 ? 1 : 0;
        return 'M'+x1o+','+y1o+' A'+r+','+r+',0,'+lg+',1,'+x2o+','+y2o+' L'+x1i+','+y1i+' A'+innerR+','+innerR+',0,'+lg+',0,'+x2i+','+y2i+' Z';
      }

      function buildBumpSegmentPath(start, end) {
        var midX = (start.x + end.x) / 2;
        return 'M ' + start.x + ' ' + start.y + ' C ' + midX + ' ' + start.y + ' ' + midX + ' ' + end.y + ' ' + end.x + ' ' + end.y;
      }

      function markerPathJs(shapeIdx, cx, cy, size) {
        var s = size;
        switch (shapeIdx % 10) {
          case 0: return 'M ' + cx + ',' + (cy - s) + ' A ' + s + ',' + s + ' 0 1 1 ' + (cx - 0.001) + ',' + (cy - s) + ' Z';
          case 1: return 'M ' + (cx - s) + ',' + (cy - s) + ' H ' + (cx + s) + ' V ' + (cy + s) + ' H ' + (cx - s) + ' Z';
          case 2: return 'M ' + cx + ',' + (cy - s * 1.3) + ' L ' + (cx + s * 1.3) + ',' + cy + ' L ' + cx + ',' + (cy + s * 1.3) + ' L ' + (cx - s * 1.3) + ',' + cy + ' Z';
          case 3: return 'M ' + cx + ',' + (cy - s * 1.3) + ' L ' + (cx + s * 1.15) + ',' + (cy + s * 0.75) + ' L ' + (cx - s * 1.15) + ',' + (cy + s * 0.75) + ' Z';
          case 4: return 'M ' + cx + ',' + (cy + s * 1.3) + ' L ' + (cx + s * 1.15) + ',' + (cy - s * 0.75) + ' L ' + (cx - s * 1.15) + ',' + (cy - s * 0.75) + ' Z';
          case 5: return 'M ' + (cx - s) + ',' + cy + ' H ' + (cx + s) + ' M ' + cx + ',' + (cy - s) + ' V ' + cx + ',' + (cy + s);
          case 6: {
            var pts = Array.from({length: 5}, function(_, i) {
              var a = (i * 2 * Math.PI / 5) - Math.PI / 2;
              return (cx + s * 1.2 * Math.cos(a)) + ',' + (cy + s * 1.2 * Math.sin(a));
            });
            return 'M ' + pts.join(' L ') + ' Z';
          }
          case 7: {
            var hexPts = Array.from({length: 6}, function(_, i) {
              var a = (i * Math.PI / 3);
              return (cx + s * 1.1 * Math.cos(a)) + ',' + (cy + s * 1.1 * Math.sin(a));
            });
            return 'M ' + hexPts.join(' L ') + ' Z';
          }
          case 8: return 'M ' + (cx - s * 0.4) + ',' + (cy - s * 1.2) + ' H ' + (cx + s * 0.4) + ' V ' + (cy - s * 0.4) + ' H ' + (cx + s * 1.2) + ' V ' + (cy + s * 0.4) + ' H ' + (cx + s * 0.4) + ' V ' + (cy + s * 1.2) + ' H ' + (cx - s * 0.4) + ' V ' + (cy + s * 0.4) + ' H ' + (cx - s * 1.2) + ' V ' + (cy - s * 0.4) + ' H ' + (cx - s * 0.4) + ' Z';
          default: return 'M ' + (cx - s) + ',' + (cy - s) + ' L ' + (cx + s) + ',' + (cy - s) + ' L ' + cx + ',' + (cy + s) + ' Z';
        }
      }

      function renderCoveragePie(papers, flaggedPapers) {
        var card = document.getElementById('weekly-coverage-pie-card');
        if (!card) return;
        var existing = card.querySelector('svg');
        if (!existing) return;
        var cx = 228, cy = 110, r = 66, innerR = 36;
        var notFlagged = Math.max(papers - flaggedPapers, 0);
        var slices = buildPieSlices([
          { label: 'Not flagged', value: notFlagged, color: 'rgba(32, 22, 19, 0.16)' },
          { label: 'Papers with detected languages', value: flaggedPapers, color: '#0f6c5d' },
        ].sort(function(left, right) { return right.value - left.value; }), cx, cy, r, -Math.PI / 2, 30);

        function coverageSliceLines(label, value) {
          if (label === 'Papers with detected languages') {
            return ['Papers with', 'detected languages ('+value+')'];
          }
          return [label+' ('+value+')'];
        }

        existing.outerHTML = '<svg class="chart-svg coverage-pie-svg" width="100%" height="220" viewBox="0 0 460 220" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Pie chart of weekly papers scanned versus papers with detected languages"><g>' +
          slices.map(function(slice) {
            var percent = papers > 0 ? ((slice.value / papers) * 100).toFixed(1) + '%' : '0.0%';
            var labelX = slice.labelX + (slice.side === 'right' ? 8 : -8);
            var labelAnchor = slice.side === 'right' ? 'start' : 'end';
            return '<g><path d="'+slice.path+'" fill="'+slice.color+'" stroke="white" stroke-width="1.5"></path>'+
              '<path d="'+slice.calloutPath+'" fill="none" stroke="var(--text)" stroke-dasharray="3 4" stroke-width="1"></path>'+
              '<text x="'+(cx + Math.cos(slice.midAngle) * 51)+'" y="'+(cy + Math.sin(slice.midAngle) * 51 + 4)+'" text-anchor="middle" class="chart-value" style="fill:'+(slice.label === 'Not flagged' ? 'var(--text)' : '#fff')+';font-size:0.5rem;font-weight:800">'+percent+'</text>'+
              '<text x="'+labelX+'" y="'+(slice.labelY + 4)+'" text-anchor="'+labelAnchor+'" class="chart-axis-label">'+coverageSliceLines(slice.label, slice.value).map(function(line, index) { return '<tspan x="'+labelX+'" dy="'+(index === 0 ? 0 : 14)+'">'+line+'</tspan>'; }).join('')+'</text>'+
              '</g>';
          }).join('') +
          '<circle cx="228" cy="110" r="36" fill="var(--panel)" stroke="var(--line)"></circle>'+
          '<text x="228" y="102" text-anchor="middle" class="chart-value"><tspan x="228" dy="0">'+papers+'</tspan><tspan x="228" dy="14" class="chart-axis-label">scanned</tspan></text>'+
          '</g></svg>';
      }

      function renderSourceBreakdown(coverageStats, total) {
        var card = document.getElementById('weekly-source-breakdown-card');
        if (!card) return;
        var svg = card.querySelector('svg');
        if (!svg) return;
        var cs = coverageStats || { htmlScanned:0, pdfOnly:0, abstractOnly:0 };
        var items = [
          { label:'HTML + Abstract', value:cs.htmlScanned, color:'#ec008b' },
          { label:'PDF + Abstract', value:cs.pdfOnly, color:'#d94f2b' },
          { label:'Abstract only', value:cs.abstractOnly, color:'#7b6c64' }
        ].sort(function(left, right) { return right.value - left.value; });
        var totalValue = Math.max(1, items.reduce(function(sum, item) { return sum + item.value; }, 0));
        var flowHeight = 160;
        var leftX = 140;
        var rightX = 360;
        var nodeW = 18;
        var barHeight = 90;
        var rightYBase = 28;
        var rightGap = 6;
        var nodes = [];
        var cursor = rightYBase;
        items.forEach(function(item) {
          var height = Math.max(10, (item.value / totalValue) * barHeight);
          nodes.push({ label: item.label, value: item.value, color: item.color, y: cursor, height: height });
          cursor += height + rightGap;
        });
        var leftLinkTotal = nodes.reduce(function(sum, item) { return sum + item.height; }, 0);
        var rightSpanTop = nodes[0] ? nodes[0].y : rightYBase;
        var rightSpanBottom = nodes.length > 0 ? nodes[nodes.length - 1].y + nodes[nodes.length - 1].height : rightYBase;
        var leftHeight = Math.max(18, leftLinkTotal);
        var leftNodeY = (rightSpanTop + rightSpanBottom) / 2 - leftHeight / 2;
        var links = [];
        var offset = 0;
        nodes.forEach(function(node) {
          var linkHeight = Math.max(10, node.height);
          var srcY = leftNodeY + offset;
          var tgtY = node.y;
          offset += linkHeight;
          links.push('<path d="M '+(leftX + nodeW)+' '+srcY+' C '+(leftX + 112)+' '+srcY+' '+(leftX + 112)+' '+tgtY+' '+rightX+' '+tgtY+' L '+rightX+' '+(tgtY + linkHeight)+' C '+(leftX + 112)+' '+(tgtY + linkHeight)+' '+(leftX + 112)+' '+(srcY + linkHeight)+' '+(leftX + nodeW)+' '+(srcY + linkHeight)+' Z" fill="'+node.color+'" fill-opacity="0.22" stroke="'+node.color+'" stroke-opacity="0.45" stroke-width="0.6"><title>'+node.label+': '+node.value+'</title></path>');
        });
        var rects = nodes.map(function(node) {
          return '<g><rect x="'+rightX+'" y="'+node.y+'" width="'+nodeW+'" height="'+node.height+'" fill="'+node.color+'" rx="3"></rect><text x="'+(rightX + nodeW + 8)+'" y="'+(node.y + node.height / 2 + 4)+'" text-anchor="start" class="chart-axis-label" style="fill:var(--text);font-weight:700">'+node.label+' ('+node.value+')</text></g>';
        }).join('');
        svg.setAttribute('width', '100%');
        svg.setAttribute('height', String(flowHeight));
        svg.setAttribute('viewBox', '0 0 520 '+flowHeight);
        svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
        svg.setAttribute('aria-label', 'Small sankey showing detected languages flowing into source types');
        svg.innerHTML = '<g>'+links.join('')+
          '<g><rect x="'+leftX+'" y="'+leftNodeY+'" width="'+nodeW+'" height="'+leftHeight+'" fill="#0f6c5d" rx="3"></rect><text x="'+(leftX - 8)+'" y="'+(leftNodeY + leftHeight / 2)+'" text-anchor="end" class="chart-axis-label" style="fill:var(--text);font-weight:700"><tspan x="'+(leftX - 8)+'" dy="-6">With languages</tspan><tspan x="'+(leftX - 8)+'" dy="13">('+totalValue+')</tspan></text></g>'+rects+'</g>';
      }

      function renderDailyChart(dailySeries) {
        var container = document.getElementById('weekly-daily-chart');
        if (!container || !dailySeries || !dailySeries.length) return;
        var margin = { top: 24, right: 18, bottom: 52, left: 42 };
        var width = 760;
        var height = 420;
        var innerW = width - margin.left - margin.right;
        var innerH = height - margin.top - margin.bottom;
        var bandW = innerW / dailySeries.length;
        var barW = bandW * 0.56;
        var maxP = Math.max.apply(null, dailySeries.map(function(d){ return d.papers || 0; })) || 1;
        var scaleY = function(v){ return innerH - (v / maxP) * innerH; };
        var ticks = [0,1,2,3,4].map(function(i){ return Math.round(maxP*i/4); });
        var yAxis = ticks.map(function(t){
          var y = scaleY(t);
          return '<g transform="translate(0 '+y+')"><line x1="0" x2="'+innerW+'" y1="0" y2="0" class="chart-grid-line"></line><text x="-10" y="4" text-anchor="end" class="chart-axis-label">'+t+'</text></g>';
        }).join('');
        var bars = dailySeries.map(function(pt, i){
          var total = Math.max(pt.papers||0, 0);
          var flagged = Math.max(Math.min(pt.flagged||0, total), 0);
          var other = total - flagged;
          var x = i * bandW + (bandW - barW) / 2;
          var tH = total > 0 ? (total / maxP) * innerH : 0;
          var fH = total > 0 ? tH * (flagged / total) : 0;
          var oH = Math.max(tH-fH, 0);
          var yTop = innerH - tH;
          var d = new Date(pt.date+'T12:00:00');
          var wd = d.toLocaleDateString(undefined, { weekday:'short' });
          var ds = pt.date.slice(5);
          var s = '<g transform="translate('+x+' 0)">';
          if (oH > 0) s += '<path d="'+roundedTopRectPath(0, yTop, barW, oH, 5)+'" fill="rgba(32, 22, 19, 0.18)"></path>';
          if (fH > 0) s += '<path d="'+roundedBottomRectPath(0, yTop+oH, barW, fH, 5)+'" fill="#0f6c5d"></path>';
          if (oH > 14) s += '<text x="'+(barW/2)+'" y="'+(yTop+oH/2+4)+'" text-anchor="middle" class="chart-value">'+other+'</text>';
          if (fH > 14) s += '<text x="'+(barW/2)+'" y="'+(yTop+oH+fH/2+4)+'" text-anchor="middle" class="chart-value" style="fill:#fff">'+flagged+'</text>';
          s += '<text x="'+(barW/2)+'" y="'+(innerH+16)+'" text-anchor="middle" class="chart-label">'+wd+'</text>';
          s += '<text x="'+(barW/2)+'" y="'+(innerH+30)+'" text-anchor="middle" class="chart-label chart-label-subtle">'+ds+'</text>';
          s += '</g>';
          return s;
        }).join('');
        container.innerHTML = '<svg class="chart-svg" style="height:auto" width="100%" viewBox="0 0 '+width+' '+height+'" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Daily submission activity stacked bar chart"><g transform="translate('+margin.left+' '+margin.top+')"><line x1="0" x2="'+innerW+'" y1="'+innerH+'" y2="'+innerH+'" class="chart-grid-line"></line>'+yAxis+bars+'</g></svg>';
      }

      function renderClassPie(classCounts) {
        var container = document.getElementById('weekly-class-pie-container');
        if (!container || !classCounts || !classCounts.length) return;
        var cx = 228, cy = 110, r = 66, innerR = 36;
        var classMap = {};
        classCounts.forEach(function(cc){ classMap[cc.class_id] = cc.count; });
        var total = Math.max(1, Object.keys(classMap).reduce(function(s, key){ return s + (classMap[key] || 0); }, 0));
        var classColors = ['#cfe8f3','#a2d4ec','#73bfe2','#46abdb','#1696d2','#12719e'];
        var segments = CLASS_LABELS_JS.map(function(label, classId) {
          return { label: label, classId: classId, value: classMap[classId] || 0, color: classColors[classId] };
        }).filter(function(item) { return item.value > 0; }).sort(function(a, b) { return b.value - a.value || a.classId - b.classId; });
        var slices = buildPieSlices(segments, cx, cy, 66, -Math.PI / 2, 30);
        container.innerHTML = '<svg class="chart-svg coverage-pie-svg" width="100%" height="220" viewBox="0 0 460 220" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Pie chart of resource class breakdown"><g>' + slices.map(function(slice) {
          return '<g><path d="'+slice.path+'" fill="'+slice.color+'" stroke="white" stroke-width="1.5"></path><path d="'+slice.calloutPath+'" fill="none" stroke="var(--text)" stroke-dasharray="3 4" stroke-width="1"></path><text x="'+(slice.labelX + (slice.side === 'right' ? 8 : -8))+'" y="'+(slice.labelY + 4)+'" text-anchor="'+(slice.side === 'right' ? 'start' : 'end')+'" class="chart-axis-label" style="fill:var(--text);font-weight:700">'+slice.label+' ('+slice.value+')</text></g>';
        }).join('') + '<circle cx="228" cy="110" r="36" fill="var(--panel)" stroke="var(--line)"></circle><text x="228" y="104" text-anchor="middle" class="chart-value">'+total+'</text><text x="228" y="119" text-anchor="middle" class="chart-axis-label">classified</text></g></svg>';
      }

      function renderLangFreqChart(languageCounts) {
        var container = document.getElementById('weekly-lang-freq');
        if (!container || !languageCounts || !languageCounts.length) return;
        var rowH = 28, margin = { top: 18, right: 24, bottom: 20, left: 210 };
        var width = 920;
        var innerW = width - margin.left - margin.right;
        var innerH = languageCounts.length * rowH;
        var totalH = innerH + margin.top + margin.bottom;
        var maxC = Math.max(1, ...languageCounts.map(function(item) { return item.count || 0; }));
        var totalC = languageCounts.reduce(function(s,lc){ return s+lc.count; }, 0);
        var bars = languageCounts.map(function(lc, i){
          var bW = (lc.count/maxC)*innerW;
          var y = i * rowH;
          var pct = ((lc.count/totalC)*100).toFixed(1)+'%';
          var inside = bW > innerW - 100;
          var barColor = classColorForLanguage(lc.language);
          return '<g transform="translate(0 '+y+')"><text x="-12" y="16" text-anchor="end" class="h-bar-label h-bar-label-name">'+lc.language+'</text><rect x="0" y="3" width="'+bW+'" height="18" rx="4" fill="'+barColor+'" fill-opacity="0.86"></rect>'+
                 (inside ? '<text x="'+(bW-6)+'" y="16" text-anchor="end" class="h-bar-label h-bar-label-count" style="fill:#fff">'+lc.count+' ('+pct+')</text>' : '<text x="'+(bW+8)+'" y="16" text-anchor="start" class="h-bar-label h-bar-label-count">'+lc.count+' ('+pct+')</text>') + '</g>';
        }).join('');
        container.innerHTML = '<svg class="chart-svg" style="height:auto" width="100%" viewBox="0 0 920 '+totalH+'" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Full language frequency horizontal bar chart"><g transform="translate('+margin.left+' '+margin.top+')">'+bars+'</g></svg>';
      }

      function renderWeekCharts(weekData) {
        renderCoveragePie(weekData.papers, weekData.flaggedPapers);
        renderSourceBreakdown(weekData.coverageStats, weekData.flaggedPapers);
        renderDailyChart(weekData.dailySeries || []);
        renderClassPie(weekData.classCounts || []);
        renderLangFreqChart(weekData.languageCounts || []);
      }

      // --- Week switcher ---
      var weekSelect = document.getElementById('period-stats-week-select');
      if (weekSelect) {
        periodData.slice().reverse().forEach(function(w) {
          var opt = document.createElement('option');
          opt.value = w.weekStart;
          opt.textContent = fmtPeriodWeekLabel(w.weekStart);
          if (w.weekStart === anchorSlug) opt.selected = true;
          weekSelect.appendChild(opt);
        });
        weekSelect.addEventListener('change', function() {
          var sel = allWeeksMeta.find(function(w) { return w.weekStart === weekSelect.value; });
          if (!sel) return;
          var pEl = document.getElementById('stat-total-papers');
          var fEl = document.getElementById('stat-flagged-papers');
          var uEl = document.getElementById('stat-unique-langs');
          var tEl = document.getElementById('weekly-stat-title');
          if (pEl) pEl.textContent = sel.papers;
          if (fEl) fEl.textContent = sel.flaggedPapers;
          if (uEl) uEl.textContent = sel.uniqueLanguages;
          if (tEl) tEl.textContent = 'For ' + fmtPeriodWeekLabel(weekSelect.value);
          renderWeekCharts(sel);
        });
      }

      // Period stat summary
      var totalPapers = periodData.reduce(function(s, w) { return s + w.papers; }, 0);
      var totalFlagged = periodData.reduce(function(s, w) { return s + w.flaggedPapers; }, 0);
      // .count means "studied" here (remapped server-side) — a language with
      // count 0 was only ever mentioned_only in this window, so it shouldn't
      // inflate the unique-languages-studied total.
      var allLangSet = new Set();
      periodData.forEach(function(w) { (w.languageCounts || []).forEach(function(lc) { if (lc.language && lc.count > 0) allLangSet.add(lc.language); }); });

      var ptitleEl = document.getElementById('period-trend-title');
      if (ptitleEl) ptitleEl.textContent = 'Period trends: ' + fmtShortLabel(fromParam) + '–' + fmtShortLabel(anchorSlug);
      var ppEl = document.getElementById('period-stat-papers'); if (ppEl) ppEl.textContent = totalPapers;
      var pfEl = document.getElementById('period-stat-flagged'); if (pfEl) pfEl.textContent = totalFlagged;
      var puEl = document.getElementById('period-stat-unique'); if (puEl) puEl.textContent = allLangSet.size;

      function buildLinePath(points) {
        return points.map(function(point, index) {
          return (index === 0 ? 'M' : 'L') + point.x + ',' + point.y;
        }).join(' ');
      }

      function renderPeriodTrendCharts(selectedPeriodData) {
        if (!selectedPeriodData || !selectedPeriodData.length) return;

        var periods = selectedPeriodData.map(function(week) {
          return {
            weekStart: week.weekStart,
            label: fmtShortLabel(week.weekStart),
            papers: week.papers || 0,
            flaggedPapers: week.flaggedPapers || 0,
            uniqueLanguages: week.uniqueLanguages || 0,
            languageCounts: week.languageCounts || [],
            classCounts: week.classCounts || [],
          };
        });

        var totalPapersInPeriod = periods.reduce(function(sum, period) { return sum + period.papers; }, 0);
        var totalFlaggedInPeriod = periods.reduce(function(sum, period) { return sum + period.flaggedPapers; }, 0);
        // .count means "studied" here (remapped server-side) — exclude
        // languages that were only ever mentioned_only in this window.
        var uniqueLanguageSet = new Set();
        periods.forEach(function(period) {
          period.languageCounts.forEach(function(item) { if (item.language && item.count > 0) uniqueLanguageSet.add(item.language); });
        });

        function coverageSliceLines(label, value) {
          if (label === 'Papers with detected languages') {
            return ['Papers with', 'detected languages (' + value + ')'];
          }
          return [label + ' (' + value + ')'];
        }

        var coverageSlices = buildPieSlices([
          { label: 'Not flagged', value: Math.max(totalPapersInPeriod - totalFlaggedInPeriod, 0), color: 'rgba(32, 22, 19, 0.16)' },
          { label: 'Papers with detected languages', value: totalFlaggedInPeriod, color: '#0f6c5d' },
        ].sort(function(left, right) { return right.value - left.value; }), 260, 130, 82, -Math.PI / 2, 36);
        var coverageSvg = '<g>' + coverageSlices.map(function(slice) {
          var labelX = slice.labelX + (slice.side === 'right' ? 8 : -8);
          var anchor = slice.side === 'right' ? 'start' : 'end';
          var percent = totalPapersInPeriod > 0 ? ((slice.value / totalPapersInPeriod) * 100).toFixed(1) + '%' : '0.0%';
          return '<g><path d="' + slice.path + '" fill="' + slice.color + '" stroke="white" stroke-width="1.5"></path>' +
            '<path d="' + slice.calloutPath + '" fill="none" stroke="var(--text)" stroke-dasharray="3 4" stroke-width="1"></path>' +
            '<text x="' + (260 + Math.cos(slice.midAngle) * 60) + '" y="' + (130 + Math.sin(slice.midAngle) * 60 + 4) + '" text-anchor="middle" class="chart-value" style="fill:' + (slice.label === 'Not flagged' ? 'var(--text)' : '#fff') + ';font-size:0.6rem;font-weight:800">' + percent + '</text>' +
            '<text x="' + labelX + '" y="' + (slice.labelY + 4) + '" text-anchor="' + anchor + '" class="chart-axis-label">' + coverageSliceLines(slice.label, slice.value).map(function(line, index) { return '<tspan x="' + labelX + '" dy="' + (index === 0 ? 0 : 14) + '">' + line + '</tspan>'; }).join('') + '</text></g>';
        }).join('') + '<circle cx="260" cy="130" r="44" fill="var(--panel)" stroke="var(--line)"></circle><text x="260" y="122" text-anchor="middle" class="chart-value"><tspan x="260" dy="0">' + totalPapersInPeriod + '</tspan><tspan x="260" dy="14" class="chart-axis-label">papers</tspan></text></g>';
        var coverageSvgEl = document.getElementById('period-coverage-pie');
        if (coverageSvgEl) coverageSvgEl.innerHTML = coverageSvg;

        var scanContainer = document.getElementById('period-scan-volume');
        if (scanContainer) {
          var scanMargin = { top: 24, right: 44, bottom: 50, left: 42 };
          var scanHeight = 260;
          var scanWidth = chartWidthForPeriods(760, scanMargin, periods.length, 5);
          var scanInnerW = scanWidth - scanMargin.left - scanMargin.right;
          var scanInnerH = scanHeight - scanMargin.top - scanMargin.bottom;
          var bandW = scanInnerW / periods.length;
          var barW = bandW * 0.56;
          var maxP = Math.max.apply(null, periods.map(function(period) { return period.papers; })) || 1;
          var yAxis = [0, 1, 2, 3, 4].map(function(i) {
            var tick = Math.round(maxP * i / 4);
            var y = scanInnerH - (tick / maxP) * scanInnerH;
            return '<g transform="translate(0 ' + y + ')"><line x1="0" x2="' + scanInnerW + '" y1="0" y2="0" class="chart-grid-line"></line><text x="-10" y="4" text-anchor="end" class="chart-axis-label">' + tick + '</text></g>';
          }).join('');
          var bars = periods.map(function(period, index) {
            var x = index * bandW + (bandW - barW) / 2;
            var totalHeight = (period.papers / maxP) * scanInnerH;
            var flaggedHeight = (period.flaggedPapers / maxP) * scanInnerH;
            var otherHeight = Math.max(totalHeight - flaggedHeight, 0);
            var yTop = scanInnerH - totalHeight;
            var otherCount = Math.max(period.papers - period.flaggedPapers, 0);
            var svg = '';
            if (otherHeight > 0) svg += '<path d="' + roundedTopRectPath(x, yTop, barW, otherHeight, 5) + '" fill="rgba(32, 22, 19, 0.18)"></path>';
            if (flaggedHeight > 0) svg += '<path d="' + roundedBottomRectPath(x, scanInnerH - flaggedHeight, barW, flaggedHeight, 5) + '" fill="#0f6c5d"></path>';
            if (otherHeight > 14) svg += '<text x="' + (x + barW / 2) + '" y="' + (yTop + otherHeight / 2 + 4) + '" text-anchor="middle" class="chart-value">' + otherCount + '</text>';
            if (flaggedHeight > 14) svg += '<text x="' + (x + barW / 2) + '" y="' + (scanInnerH - flaggedHeight / 2 + 4) + '" text-anchor="middle" class="chart-value" style="fill:#fff">' + period.flaggedPapers + '</text>';
            svg += '<text x="' + (x + barW / 2) + '" y="' + (scanInnerH + 18) + '" text-anchor="middle" class="chart-label">' + period.label + '</text>';
            return svg;
          }).join('');
          scanContainer.innerHTML = '<svg class="chart-svg"' + (scanWidth !== 760 ? ' style="width:' + scanWidth + 'px;max-width:none"' : ' width="100%"') + ' viewBox="0 0 ' + scanWidth + ' ' + scanHeight + '" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Stacked bar chart of selected period scan volume"><g transform="translate(' + scanMargin.left + ' ' + scanMargin.top + ')"><line x1="0" x2="' + scanInnerW + '" y1="' + scanInnerH + '" y2="' + scanInnerH + '" class="chart-grid-line"></line>' + yAxis + bars + '</g></svg>';
        }

        var classLegend = document.getElementById('period-class-legend');
        if (classLegend) {
          classLegend.innerHTML = CLASS_LABELS_JS.map(function(label, classId) {
            return '<div class="class-legend-item"><span class="trend-legend-swatch" style="background:' + CLASS_COLORS_JS[classId] + '"></span><span>' + label + (classId === 0 ? ' (lowest)' : classId === CLASS_LABELS_JS.length - 1 ? ' (highest)' : '') + '</span></div>';
          }).join('');
        }

        var classContainer = document.getElementById('period-class-mix');
        if (classContainer) {
          var classHeight = 380;
          var classMargin = { top: 20, right: 18, bottom: 56, left: 42 };
          var classWidth = chartWidthForPeriods(700, classMargin, periods.length, 5);
          var classInnerW = classWidth - classMargin.left - classMargin.right;
          var classInnerH = classHeight - classMargin.top - classMargin.bottom;
          var classScale = classInnerW / periods.length;
          var classRows = periods.map(function(period) {
            var classMap = new Map(period.classCounts.map(function(item) { return [item.class_id, item.count]; }));
            var total = Math.max(1, CLASS_LABELS_JS.reduce(function(sum, _label, classId) { return sum + (classMap.get(classId) || 0); }, 0));
            var offset = 0;
            return CLASS_LABELS_JS.map(function(label, classId) {
              var count = classMap.get(classId) || 0;
              var percentage = count / total;
              var height = classInnerH * percentage;
              var segment = { classId: classId, label: label, count: count, y: classInnerH - offset - height, height: height, color: CLASS_COLORS_JS[classId] };
              offset += height;
              return segment;
            });
          });
          var classSvg = periods.map(function(period, index) {
            var x = index * classScale;
            var barWidth = classScale * 0.55;
