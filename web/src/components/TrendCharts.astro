---
import { scaleBand, scaleLinear } from 'd3';
import { CLASS_LABELS, colorForIndex } from '../lib/data.js';
import { languageBorderClass } from '../lib/language-colors.js';
import {
  aggregateTrendPeriods,
  buildLinePath,
  buildPieSlices,
  classColorForId,
  classColorForLanguage,
  coverageSliceLines,
  coverageSliceLinesWithPercent,
  coverageSlicePercent,
  fillWeekSeries,
  formatPercent,
  formatSliceLabel,
  formatWeekLabel,
  formatWeekRange,
  formatWeekdayLabel,
  markerPath,
  roundedBottomRect,
  roundedTopRect,
  scrollableChartWidth,
  sumCounts,
  trendPeriodKey,
  trendPeriodLabel,
} from '../lib/trend-charts.js';

type LanguageCount = { language: string; count: number };
type WeekPoint = { date: string; papers: number; flagged: number };
type CoverageStats = { htmlScanned: number; pdfOnly: number; abstractOnly: number };
type ClassCount = { class_id: number; count: number };
type WeekAggregate = {
  weekStart: string;
  weekEnd?: string | null;
  papers: number;
  flaggedPapers: number;
  uniqueLanguages: number;
  languageCounts: LanguageCount[];
  classCounts: ClassCount[];
  dailySeries: WeekPoint[];
  coverageStats?: { htmlScanned: number; pdfOnly: number; abstractOnly: number };
};

type Props = {
  languageCounts: LanguageCount[];
  classCounts: ClassCount[];
  weekSeries: WeekPoint[];
  coverageStats: CoverageStats;
  allWeeksData: WeekAggregate[];
  manifest: {
    counts?: {
      papers?: number;
      flagged_papers?: number;
      unique_languages?: number;
      unique_languages_mentioned_only?: number;
      judge?: {
        judged_papers?: number;
        judged_languages?: number;
        studied?: number;
        mentioned_only?: number;
        false_positive?: number;
      };
    };
    papers?: unknown[];
    flagged_papers?: unknown[];
    week_start?: string;
    week_end?: string;
  };
  languageData: { lang_classes?: Record<string, unknown[]>; possible_false_positive_languages?: Record<string, string> };
};

const {
  languageCounts: languageCountsProp = [],
  classCounts: classCountsProp = [],
  weekSeries = [],
  coverageStats,
  allWeeksData: allWeeksDataProp = [],
  manifest,
  languageData,
} = Astro.props as Props;

// Every chart below plots `.count` as the primary per-language/per-class
// metric. Remap it here, once, to mean "studied" (not-yet-judged detections
// count as studied too — mirrors build_snapshot_manifest / countLanguages)
// so every chart consistently reflects real research activity instead of
// combined studied+mentioned_only totals, matching the "Unique languages"
// KPI's meaning. The true combined total and the mentioned-only count stay
// available via `.studied`/`.mentioned_only` on the same objects for any
// chart that wants the fuller picture. This single remap covers both the
// server-rendered charts below AND the client-side inline <script>, which
// reads the same objects serialized into the all-weeks-meta JSON payload.
function withStudiedAsCount<T extends { count: number; studied?: number }>(items: T[]): T[] {
  return items.map((item) => ({ ...item, count: item.studied ?? item.count }));
}
const languageCounts = withStudiedAsCount(languageCountsProp);
const classCounts = withStudiedAsCount(classCountsProp);
const allWeeksData = allWeeksDataProp.map((week) => ({
  ...week,
  languageCounts: withStudiedAsCount(week.languageCounts || []),
  classCounts: withStudiedAsCount(week.classCounts || []),
}));

const langClasses = languageData?.lang_classes || {};
const pfpWarnings: Record<string, string> = languageData?.possible_false_positive_languages ?? {};
function pfpWarn(lang: string): string { return pfpWarnings[lang] ?? ''; }
const weeklyPapers = manifest.counts?.papers ?? (manifest.papers || []).length;
const weeklyFlagged = manifest.counts?.flagged_papers ?? (manifest.flagged_papers || []).length;
const weeklyUniqueLanguages = manifest.counts?.unique_languages ?? languageCounts.length;
const weeklyMentionedOnlyLanguages = manifest.counts?.unique_languages_mentioned_only ?? 0;
const judgeCounts = manifest.counts?.judge && (manifest.counts.judge.judged_papers ?? 0) > 0
  ? {
      judged_papers: manifest.counts.judge.judged_papers ?? 0,
      studied: manifest.counts.judge.studied ?? 0,
      mentioned_only: manifest.counts.judge.mentioned_only ?? 0,
      false_positive: manifest.counts.judge.false_positive ?? 0,
    }
  : null;

function classColor(language: string) {
  return classColorForLanguage(language, langClasses);
}

type PieItem = { label: string; value: number; color: string; countLabel?: string };
type PieSlice = PieItem & {
  startAngle: number;
  endAngle: number;
  midAngle: number;
  path: string;
  calloutPath: string;
  labelX: number;
  labelY: number;
  side: 'left' | 'right';
};

const weekLabel = formatWeekRange(weekSeries, manifest.week_start, manifest.week_end);
const weeklySummaryCards = [
  { label: 'Total papers scanned', value: weeklyPapers },
  { label: 'Papers with detected languages', value: weeklyFlagged },
  { label: 'Unique languages studied', value: weeklyUniqueLanguages },
];

const weeklyCoveragePieData = [
  { label: 'Not detected', value: Math.max(weeklyPapers - weeklyFlagged, 0), color: 'rgba(32, 22, 19, 0.16)' },
  { label: 'Papers with detected languages', value: weeklyFlagged, color: '#0f6c5d' },
];
const weeklyCoveragePie = buildPieSlices([...weeklyCoveragePieData].sort((left, right) => right.value - left.value), 228, 110, 66, -Math.PI / 2, 30);
const weeklyCoverageSources = [
  { label: 'HTML + Abstract', value: coverageStats?.htmlScanned ?? 0, color: '#ec008b' },
  { label: 'PDF + Abstract', value: coverageStats?.pdfOnly ?? 0, color: '#d94f2b' },
  { label: 'Abstract only', value: coverageStats?.abstractOnly ?? 0, color: '#7b6c64' },
].filter((item) => item.value > 0).sort((a, b) => b.value - a.value);
const weeklyCoverageSourceTotal = Math.max(1, weeklyCoverageSources.reduce((sum, item) => sum + item.value, 0));
const weeklyCoverageFlowHeight = 160;
const weeklyCoverageFlowLeftX = 140;
const weeklyCoverageFlowRightX = 360;
const weeklyCoverageFlowNodeWidth = 18;
const weeklyCoverageFlowBarHeight = 90;
const weeklyCoverageFlowRightYBase = 28;
const weeklyCoverageFlowRightGap = 6;
const weeklyCoverageFlowRightNodes = (() => {
  const nodes: { label: string; value: number; color: string; y: number; height: number }[] = [];
  let cursor = weeklyCoverageFlowRightYBase;
  for (const item of weeklyCoverageSources) {
    const height = Math.max(10, (item.value / weeklyCoverageSourceTotal) * weeklyCoverageFlowBarHeight);
    nodes.push({ ...item, y: cursor, height });
    cursor += height + weeklyCoverageFlowRightGap;
  }
  return nodes;
})();
// Left bar height = sum of link heights only (no inter-bar gaps) so strips fill the bar exactly
const weeklyCoverageFlowLeftLinkTotal = weeklyCoverageFlowRightNodes.reduce((sum, item) => sum + item.height, 0);
const weeklyCoverageFlowRightSpanTop = weeklyCoverageFlowRightNodes[0]?.y ?? weeklyCoverageFlowRightYBase;
const weeklyCoverageFlowRightSpanBottom = weeklyCoverageFlowRightNodes.length > 0
  ? weeklyCoverageFlowRightNodes[weeklyCoverageFlowRightNodes.length - 1].y + weeklyCoverageFlowRightNodes[weeklyCoverageFlowRightNodes.length - 1].height
  : weeklyCoverageFlowRightYBase;
const weeklyCoverageFlowLeftHeight = Math.max(18, weeklyCoverageFlowLeftLinkTotal);
// Center left bar vertically relative to the full right-bars span (including gaps)
const weeklyCoverageFlowLeftNodeY = (weeklyCoverageFlowRightSpanTop + weeklyCoverageFlowRightSpanBottom) / 2 - weeklyCoverageFlowLeftHeight / 2;
const weeklyCoverageFlowLinks = (() => {
  let offset = 0;
  return weeklyCoverageFlowRightNodes.map((item) => {
    const linkHeight = Math.max(10, item.height);
    const srcY = weeklyCoverageFlowLeftNodeY + offset;
    const tgtY = item.y;
    offset += linkHeight;
    return {
      ...item,
      linkHeight,
      path: `M ${weeklyCoverageFlowLeftX + weeklyCoverageFlowNodeWidth} ${srcY} C ${weeklyCoverageFlowLeftX + 112} ${srcY} ${weeklyCoverageFlowLeftX + 112} ${tgtY} ${weeklyCoverageFlowRightX} ${tgtY} L ${weeklyCoverageFlowRightX} ${tgtY + linkHeight} C ${weeklyCoverageFlowLeftX + 112} ${tgtY + linkHeight} ${weeklyCoverageFlowLeftX + 112} ${srcY + linkHeight} ${weeklyCoverageFlowLeftX + weeklyCoverageFlowNodeWidth} ${srcY + linkHeight} Z`,
    };
  });
})();

const weeklyDailySeries = fillWeekSeries(weekSeries, manifest.week_start, manifest.week_end);
const weeklyDailyWidth = 760;
const weeklyDailyHeight = 420;
const weeklyDailyMargins = { top: 24, right: 18, bottom: 52, left: 42 };
const weeklyDailyInnerWidth = weeklyDailyWidth - weeklyDailyMargins.left - weeklyDailyMargins.right;
const weeklyDailyInnerHeight = weeklyDailyHeight - weeklyDailyMargins.top - weeklyDailyMargins.bottom;
const weeklyDailyScale = scaleBand()
  .domain(weeklyDailySeries.map((item) => item.date))
  .range([0, weeklyDailyInnerWidth])
  .padding(0.22);
const weeklyDailyMax = Math.max(1, ...weeklyDailySeries.map((item) => item.papers || 0));
const weeklyDailyY = scaleLinear().domain([0, weeklyDailyMax]).nice().range([weeklyDailyInnerHeight, 0]);

const weeklyClassSeries = CLASS_LABELS.map((label, classId) => ({
  classId,
  label,
  count: classCounts.find((item) => item.class_id === classId)?.count ?? 0,
  color: classColorForId(classId),
}));
const weeklyClassTotal = Math.max(1, sumCounts(weeklyClassSeries));
const weeklyClassPieData = [...weeklyClassSeries]
  .filter((item) => item.count > 0)
  .sort((left, right) => right.count - left.count || left.classId - right.classId)
  .map((item) => ({ label: item.label, value: item.count, color: item.color }));
const weeklyClassPie = buildPieSlices(weeklyClassPieData, 228, 110, 66);

const weeklyLanguageSeries = [...languageCounts]
  .filter((item) => item.count > 0)
  .sort((left, right) => {
    const countDelta = right.count - left.count;
    return countDelta !== 0 ? countDelta : left.language.localeCompare(right.language);
  });
const weeklyLanguageMax = Math.max(1, ...weeklyLanguageSeries.map((item) => item.count || 0));
const weeklyLanguageBarWidth = 920;
const weeklyLanguageBarMargins = { top: 18, right: 24, bottom: 20, left: 210 };
const weeklyLanguageBarInnerWidth = weeklyLanguageBarWidth - weeklyLanguageBarMargins.left - weeklyLanguageBarMargins.right;
const weeklyLanguageRowHeight = 28;
const weeklyLanguageBarHeight = weeklyLanguageBarMargins.top + weeklyLanguageBarMargins.bottom + weeklyLanguageSeries.length * weeklyLanguageRowHeight;
const weeklyLanguageTotalCount = Math.max(1, languageCounts.reduce((sum, item) => sum + item.count, 0));

// Color palette declared early so it can be used in data computations below
const TREND_LINE_COLORS = ['#1696d2','#000000','#d2d2d2','#fdbf11','#55b748','#ec008b','#0a4c6a','#db2b27','#5c5859','#a2d4ec'];

const trendWeeks = [...allWeeksData].sort((left, right) => left.weekStart.localeCompare(right.weekStart));
const trendWeekLabels = trendWeeks.map((week) => week.weekStart);

type TrendGranularity = 'week' | 'month' | 'year';
type TrendPeriod = {
  periodKey: string;
  label: string;
  sortKey: string;
  papers: number;
  flaggedPapers: number;
  uniqueLanguages: number;
  languageCounts: LanguageCount[];
  classCounts: ClassCount[];
};

function computeTrendData(granularity: TrendGranularity) {
  const periods = aggregateTrendPeriods(trendWeeks, granularity);
  const periodLabels = periods.map((p) => p.label);
  const granularityLabel = granularity === 'week' ? 'Weekly' : granularity === 'month' ? 'Monthly' : 'Yearly';

  const langTotals = new Map<string, number>();
  for (const period of periods) {
    for (const item of period.languageCounts || []) {
      if (!item.language) continue;
      // period.languageCounts comes straight from aggregateTrendPeriods, where
      // .count is deliberately the combined studied+mentioned total — use
      // .studied here so the trend charts plot real research activity.
      langTotals.set(item.language, (langTotals.get(item.language) || 0) + (item.studied ?? item.count));
    }
  }
  const topLanguages = [...langTotals.entries()]
    .filter(([, total]) => total > 0)
    .sort((left, right) => {
      const d = right[1] - left[1];
      return d !== 0 ? d : left[0].localeCompare(right[0]);
    })
    .slice(0, 10)
    .map(([language, count], index) => ({
      language,
      count,
      color: TREND_LINE_COLORS[index] || colorForIndex(index),
    }));
  const langColorMap = new Map(topLanguages.map((item) => [item.language, item.color]));

  const groupedHeight = 260;
  const groupedMargins = { top: 24, right: 44, bottom: 50, left: 42 };
  const groupedScrollPx = scrollableChartWidth(760, groupedMargins, periods.length);
  const groupedWidth = groupedScrollPx ?? 760;
  const groupedInnerWidth = groupedWidth - groupedMargins.left - groupedMargins.right;
  const groupedInnerHeight = groupedHeight - groupedMargins.top - groupedMargins.bottom;
  const groupedScale = scaleBand().domain(periodLabels).range([0, groupedInnerWidth]).padding(0.22);
  const groupedMax = Math.max(1, ...periods.map((p) => p.papers || 0));
  const groupedY = scaleLinear().domain([0, groupedMax]).nice().range([groupedInnerHeight, 0]);

  const topLangHeight = 500;
  const topLangMargins = { top: 28, right: 124, bottom: 130, left: 42 };
  const topLangScrollPx = scrollableChartWidth(760, topLangMargins, periods.length);
  const topLangWidth = topLangScrollPx ?? 760;
  const topLangInnerWidth = topLangWidth - topLangMargins.left - topLangMargins.right;
  const topLangInnerHeight = topLangHeight - topLangMargins.top - topLangMargins.bottom;
  const topLangScale = scaleBand().domain(periodLabels).range([0, topLangInnerWidth]).padding(0.3);
  const topLangMax = Math.max(
    1,
    ...topLanguages.flatMap((item) => periods.map((period) => {
      const found = (period.languageCounts || []).find((l) => l.language === item.language);
      return found?.studied ?? found?.count ?? 0;
    })),
  );
  const topLangY = scaleLinear().domain([0, topLangMax]).nice().range([topLangInnerHeight, 0]);
  const trendSeries = topLanguages.map((item) => {
    const points = periods.map((period) => {
      const found = (period.languageCounts || []).find((l) => l.language === item.language);
      const value = found?.studied ?? found?.count ?? 0;
      const x = (topLangScale(period.label) || 0) + topLangScale.bandwidth() / 2;
      return { x, y: topLangY(value), value };
    });
    return { ...item, points, path: buildLinePath(points) };
  });

  const classHeight = 380;
  const classMargins = { top: 20, right: 18, bottom: 56, left: 42 };
  const classScrollPx = scrollableChartWidth(700, classMargins, periods.length);
  const classWidth = classScrollPx ?? 700;
  const classInnerWidth = classWidth - classMargins.left - classMargins.right;
  const classInnerHeight = classHeight - classMargins.top - classMargins.bottom;
  const classScale = scaleBand().domain(periodLabels).range([0, classInnerWidth]).padding(0.45);
  const classBars = periods.map((period) => {
    const classMap = new Map((period.classCounts || []).map((item) => [item.class_id, item.studied ?? item.count]));
    const total = Math.max(1, CLASS_LABELS.reduce((sum, _label, classId) => sum + (classMap.get(classId) || 0), 0));
    let offset = 0;
    return {
      label: period.label,
      total,
      segments: CLASS_LABELS.map((label, classId) => {
        const count = classMap.get(classId) || 0;
        const percentage = count / total;
        const height = classInnerHeight * percentage;
        const segment = { classId, label, count, percent: percentage, y: classInnerHeight - offset - height, height, color: classColorForId(classId) };
        offset += height;
        return segment;
      }),
    };
  });

  const uniqueHeight = 380;
  const uniqueMargins = { top: 24, right: 18, bottom: 56, left: 42 };
  const uniqueScrollPx = scrollableChartWidth(700, uniqueMargins, periods.length);
  const uniqueWidth = uniqueScrollPx ?? 700;
  const uniqueInnerWidth = uniqueWidth - uniqueMargins.left - uniqueMargins.right;
  const uniqueInnerHeight = uniqueHeight - uniqueMargins.top - uniqueMargins.bottom;
  const uniqueScale = scaleBand().domain(periodLabels).range([0, uniqueInnerWidth]).padding(0.22);
  const uniqueMax = Math.max(1, ...periods.map((p) => p.uniqueLanguages || 0));
  const uniqueYInset = 8;
  const uniqueY = scaleLinear().domain([0, uniqueMax]).nice().range([uniqueInnerHeight - uniqueYInset, uniqueYInset]);

  const endpointRaw = trendSeries.map((series, idx) => {
    const lastPt = series.points[series.points.length - 1];
    return { idx, naturalY: lastPt?.y ?? 0, value: lastPt?.value ?? 0, color: series.color };
  }).sort((a, b) => a.naturalY - b.naturalY);
  const endpointLabelY: number[] = new Array(trendSeries.length).fill(0);
  let prevEndpointY = -Infinity;
  for (const item of endpointRaw) {
    const y = Math.max(item.naturalY, prevEndpointY + 14);
    endpointLabelY[item.idx] = y;
    prevEndpointY = y;
  }

  return {
    granularity, granularityLabel, periods, periodLabels, topLanguages, langColorMap, trendSeries, endpointLabelY,
    groupedHeight, groupedMargins, groupedScrollPx, groupedWidth, groupedInnerWidth, groupedInnerHeight, groupedScale, groupedMax, groupedY,
    topLangHeight, topLangMargins, topLangScrollPx, topLangWidth, topLangInnerWidth, topLangInnerHeight, topLangScale, topLangMax, topLangY,
    classHeight, classMargins, classScrollPx, classWidth, classInnerWidth, classInnerHeight, classScale, classBars,
    uniqueHeight, uniqueMargins, uniqueScrollPx, uniqueWidth, uniqueInnerWidth, uniqueInnerHeight, uniqueScale, uniqueMax, uniqueY,
  };
}

const trendDataByGranularity = {
  week: computeTrendData('week'),
  month: computeTrendData('month'),
  year: computeTrendData('year'),
};

// Minimal per-granularity periods for the client-rendered overall rank
// trajectory (label + studied-only language counts). The client re-ranks and
// re-labels these under the resource-class filter, matching the period panel's
// bump chart. `count` here is the studied count (mentioned-only excluded).
const overallBumpPeriods = Object.fromEntries(
  (['week', 'month', 'year'] as TrendGranularity[]).map((gran) => [
    gran,
    trendDataByGranularity[gran].periods.map((period) => ({
      label: period.label,
      languageCounts: (period.languageCounts || [])
        .filter((item) => (item.studied ?? 0) > 0)
        .map((item) => ({ language: item.language, count: item.studied })),
    })),
  ]),
);

// Mirror ranking chart — independent top-10 lists for prev and current week
// "Current" is whichever week this page is showing (not necessarily the
// latest week overall), so look up its neighbor by date rather than assuming
// this is always the last entry in trendWeeks.
const currentWeekIndex = trendWeeks.findIndex((week) => week.weekStart === manifest.week_start);
const prevWeekData = currentWeekIndex > 0 ? trendWeeks[currentWeekIndex - 1] : null;
const hasPrevWeek = prevWeekData !== null;
// Exclude languages that were only ever mentioned_only — this ranks studied
// activity, so a week with fewer than 10 studied languages shouldn't get
// padded out with mentioned-only-only entries.
const currTop10 = [...languageCounts].filter((item) => item.count > 0).sort((a, b) => b.count - a.count).slice(0, 10);
const prevTop10Sorted = prevWeekData
  ? [...(prevWeekData.languageCounts || [])].filter((item) => item.count > 0).sort((a, b) => b.count - a.count).slice(0, 10)
  : [];

const mirrorSvgWidth = 960;
const mirrorSvgHeight = 420;
const mirrorRowHeight = 32;
const mirrorRowGap = 6;
const mirrorTopPad = 46;
const mirrorLabelPad = 8; // gap between bar end and rank circle edge

// Layout: left half [labelWidth | barArea | rankCircleR | gap | rankCircleR | barArea | labelWidth] right half
const mirrorLabelWidth = 160;
const mirrorRankR = 12;
const mirrorSpineGap = 60; // gap between the two spine circle columns at center
const mirrorBarAreaWidth = (mirrorSvgWidth / 2) - mirrorLabelWidth - mirrorRankR * 2 - mirrorSpineGap / 2 - 4;
// Left spine x (where left bars end / right edge of left bar zone)
const mirrorLeftSpineX = mirrorLabelWidth + mirrorBarAreaWidth;
// Right spine x (where right bars begin)
const mirrorRightSpineX = mirrorSvgWidth - mirrorLabelWidth - mirrorBarAreaWidth;

const mirrorPrevMaxCount = Math.max(1, ...prevTop10Sorted.map(x => x.count));
const mirrorCurrMaxCount = Math.max(1, ...currTop10.map(x => x.count));

type MirrorRow = { language: string; count: number; rank: number; y: number };
const mirrorPrevRows: MirrorRow[] = prevTop10Sorted.map((item, i) => ({
  language: item.language, count: item.count, rank: i + 1,
  y: mirrorTopPad + i * (mirrorRowHeight + mirrorRowGap),
}));
const mirrorCurrRows: MirrorRow[] = currTop10.map((item, i) => ({
  language: item.language, count: item.count, rank: i + 1,
  y: mirrorTopPad + i * (mirrorRowHeight + mirrorRowGap),
}));
const mirrorPrevRowMap = new Map<string, MirrorRow>(mirrorPrevRows.map(r => [r.language, r]));
const mirrorCurrRowMap = new Map<string, MirrorRow>(mirrorCurrRows.map(r => [r.language, r]));
// Connection lines: languages appearing in both lists
const mirrorConnections = mirrorCurrRows
  .filter(r => mirrorPrevRowMap.has(r.language))
  .map(r => {
    const prev = mirrorPrevRowMap.get(r.language)!;
    return { language: r.language, prevY: prev.y + mirrorRowHeight / 2, currY: r.y + mirrorRowHeight / 2 };
  });
// Languages only in prev (dropped from current top-10)
const mirrorDropped = mirrorPrevRows.filter(r => !mirrorCurrRowMap.has(r.language));
// Languages only in current (new to top-10)
const mirrorNew = mirrorCurrRows.filter(r => !mirrorPrevRowMap.has(r.language));

// Full sorted lists for computing out-of-top-10 ranks for dropped/new items
const mirrorCurrFullSorted = [...languageCounts].sort((a, b) => b.count - a.count);
const mirrorPrevFullSorted = prevWeekData ? [...(prevWeekData.languageCounts || [])].sort((a, b) => b.count - a.count) : [];
const mirrorDroppedWithRank = mirrorDropped.map(row => {
  const idx = mirrorCurrFullSorted.findIndex(x => x.language === row.language);
  return { ...row, currRank: idx >= 0 ? idx + 1 : null };
});
const mirrorNewWithRank = mirrorNew.map(row => {
  const idx = mirrorPrevFullSorted.findIndex(x => x.language === row.language);
  return { ...row, prevRank: idx >= 0 ? idx + 1 : null };
});

// Sankey chart
const sankeyLanguages = [...languageCounts]
  .filter((item) => item.count > 0)
  .sort((left, right) => right.count - left.count || left.language.localeCompare(right.language))
  .slice(0, 10);
const showSankey = sankeyLanguages.length >= 5;
const sankeySvgWidthMin = 1120;
const sankeyNodeWidth = 18;
const sankeyPad = 8;
const sankeyGroupGap = 0;
const sankeyLeftNodeX = 230;
const sankeyRightNodeX = 900;
const sankeyMidX = (sankeyLeftNodeX + sankeyNodeWidth + sankeyRightNodeX) / 2;
const sankeyClassTotalMap = new Map<number, number>();
for (const item of languageCounts) {
  const classId = languageBorderClass(item.language, langClasses);
  sankeyClassTotalMap.set(classId, (sankeyClassTotalMap.get(classId) || 0) + item.count);
}
const sankeyGrandTotal = Math.max(1, [...sankeyClassTotalMap.values()].reduce((sum, value) => sum + value, 0));
type SankeyLeftNode = { classId: number; label: string; total: number; color: string; y: number; height: number };
type SankeyRightNode = { classId: number; language: string; count: number; color: string; y: number; height: number; hidden?: boolean };
type SankeyClassGroup = SankeyLeftNode & { languages: SankeyRightNode[] };
type SankeyVisibleLanguage = SankeyRightNode & { hidden: boolean };

const sankeyLeftNodes: SankeyLeftNode[] = [...sankeyClassTotalMap.entries()]
  .sort((a, b) => b[1] - a[1] || a[0] - b[0])
  .map(([classId, total]) => ({ classId, label: CLASS_LABELS[classId] || `Class ${classId}`, total, color: classColorForId(classId), y: 0, height: 0 }));

const sankeyNodeMinH = 5; // min right-node height in SVG units (labels are font-size 12 SVG units)
const sankeyNodeSlot = sankeyNodeMinH + sankeyPad; // SVG units each language slot consumes

const sankeyClassGroups: SankeyClassGroup[] = sankeyLeftNodes.map((group) => {
  // Strictly proportional — no inflation from language count
  const proportionalHeight = Math.max(24, (group.total / sankeyGrandTotal) * 720);
  const allLangs = [...languageCounts]
    .filter((item) => languageBorderClass(item.language, langClasses) === group.classId && item.count > 0)
    .sort((left, right) => right.count - left.count || left.language.localeCompare(right.language))
    .map((item) => ({
      classId: group.classId,
      language: item.language,
      count: item.count,
      color: classColor(item.language),
      y: 0,
      height: 0,
    }));
  // Show up to 10 languages per class if available; expand the band as needed
  // so smaller classes are not artificially truncated.
  const visibleLanguages = allLangs.slice(0, 10);
  const hiddenCount = Math.max(0, allLangs.length - visibleLanguages.length);
  const languageRows: SankeyVisibleLanguage[] = [
    ...visibleLanguages.map((item) => ({ ...item, hidden: false })),
    ...(hiddenCount > 0 ? [{
      classId: group.classId,
      language: `${hiddenCount} more languages not shown`,
      count: allLangs.slice(10).reduce((sum, item) => sum + item.count, 0),
      color: 'rgba(32, 22, 19, 0.16)',
      y: 0,
      height: 0,
      hidden: true,
    } as SankeyVisibleLanguage] : []),
  ];
  const requiredHeight = 16 + languageRows.length * sankeyNodeMinH + Math.max(0, languageRows.length - 1) * sankeyPad;
  return { ...group, height: Math.max(proportionalHeight, requiredHeight), languages: languageRows };
});

let sankeyCursor = 20;
for (const group of sankeyClassGroups) {
  group.y = sankeyCursor;
  const n = group.languages.length;
  const languageCountTotal = Math.max(1, group.languages.reduce((sum, item) => sum + item.count, 0));
  const availableHeight = Math.max(n * sankeyNodeMinH, group.height - 16 - Math.max(0, n - 1) * sankeyPad);
  // Proportional heights with a floor, then scale down uniformly if they'd overflow
  const rawHeights = group.languages.map(node => Math.max(sankeyNodeMinH, (node.count / languageCountTotal) * availableHeight));
  const totalRaw = rawHeights.reduce((s, h) => s + h, 0);
  // Scale heights so they exactly fill the availableHeight. Previously we
  // prevented up-scaling which left gaps; allow hScale > 1 when totalRaw is
  // smaller than availableHeight so the right-node strips fill the left bar.
  const hScale = availableHeight / Math.max(1, totalRaw);
  let rowCursor = group.y + 8;
  for (let i = 0; i < n; i++) {
    group.languages[i].height = rawHeights[i] * hScale;
    group.languages[i].y = rowCursor;
    rowCursor += group.languages[i].height + sankeyPad;
  }
  sankeyCursor += group.height + sankeyGroupGap;
}
const sankeySvgHeight = sankeyCursor + 20;
const sankeyRightNodes = sankeyClassGroups.flatMap((group) => group.languages);
// Right-node labels (including the synthetic "N more languages not shown"
// row) can be longer than the space the fixed-width viewBox assumed, which
// clipped them at the SVG's own boundary regardless of container size —
// widen the viewBox to fit the longest label rather than just the typical case.
const sankeyLongestLabelChars = Math.max(0, ...sankeyRightNodes.map((node) => `${node.language} (${node.count})`.length));
const sankeyRightLabelSpace = sankeyRightNodeX + sankeyNodeWidth + 8 + sankeyLongestLabelChars * 7.2 + 24;
const sankeySvgWidth = Math.max(sankeySvgWidthMin, Math.ceil(sankeyRightLabelSpace));
const sankeyVisibleClassCount = 3;
const sankeyVisibleHeight = sankeyClassGroups[sankeyVisibleClassCount - 1]
  ? sankeyClassGroups[sankeyVisibleClassCount - 1].y + sankeyClassGroups[sankeyVisibleClassCount - 1].height + 20
  : sankeySvgHeight;
const sankeyPaths = sankeyClassGroups.flatMap((group) => {
  const shownTotal = Math.max(1, group.languages.reduce((sum, item) => sum + item.count, 0));
  const leftInnerH = group.height;
  let leftOffset = 0;
  return group.languages.map((item) => {
    const srcH = (item.count / shownTotal) * leftInnerH;
    const srcY1 = group.y + leftOffset;
    const srcY2 = srcY1 + srcH;
    leftOffset += srcH;
    const tgtY1 = item.y;
    const tgtY2 = tgtY1 + item.height;
    const lx = sankeyLeftNodeX + sankeyNodeWidth;
    const rx = sankeyRightNodeX;
    const d = `M ${lx} ${srcY1} C ${sankeyMidX} ${srcY1} ${sankeyMidX} ${tgtY1} ${rx} ${tgtY1} L ${rx} ${tgtY2} C ${sankeyMidX} ${tgtY2} ${sankeyMidX} ${srcY2} ${lx} ${srcY2} Z`;
    return { language: item.language, classId: group.classId, d, color: item.hidden ? 'rgba(32, 22, 19, 0.16)' : group.color, count: item.count };
  });
});

const trendOverallPapers = trendWeeks.reduce((sum, week) => sum + (week.papers || 0), 0);
const trendOverallFlagged = trendWeeks.reduce((sum, week) => sum + (week.flaggedPapers || 0), 0);
// .count means "studied" here (remapped above) — exclude languages that
// were only ever mentioned_only across every week, never actually studied.
const trendOverallUniqueLanguages = new Set(
  trendWeeks.flatMap((week) => (week.languageCounts || []).filter((item) => item.count > 0).map((item) => item.language)),
).size;
const overallCoveragePieData = [
  { label: 'Not detected', value: Math.max(trendOverallPapers - trendOverallFlagged, 0), color: 'rgba(32, 22, 19, 0.16)' },
  { label: 'Papers with detected languages', value: trendOverallFlagged, color: '#0f6c5d' },
];
const overallCoveragePie = buildPieSlices([...overallCoveragePieData].sort((left, right) => right.value - left.value), 260, 130, 82, -Math.PI / 2, 36);
const overallCoverageUniqueText = `${trendOverallUniqueLanguages}`;

---
<section class="stats-stack">
  <script type="application/json" id="all-weeks-meta" is:inline set:html={JSON.stringify(allWeeksData.map(w => ({ weekStart: w.weekStart, papers: w.papers, flaggedPapers: w.flaggedPapers, uniqueLanguages: w.uniqueLanguages, languageCounts: w.languageCounts, classCounts: w.classCounts, dailySeries: w.dailySeries, coverageStats: w.coverageStats })))}></script>
  <script type="application/json" id="lang-classes-meta" is:inline set:html={JSON.stringify(langClasses)}></script>
  <script type="application/json" id="overall-bump-periods" is:inline set:html={JSON.stringify(overallBumpPeriods)}></script>
  <details id="weekly-trends-panel" class="panel chart-panel wide-panel" open>
    <summary class="paper-collapse-summary">
      <div>
        <h2 id="weekly-stat-title">For {weekLabel}</h2>
      </div>
      <span class="paper-collapse-hint">Collapse section</span>
    </summary>

    <div id="period-week-switcher" class="period-week-switcher" style="display:none">
      <label class="picker-label" for="period-stats-week-select">Week stats for:</label>
      <select id="period-stats-week-select" class="picker-select"></select>
    </div>

    <div class="stat-row">
      <article class="stat-card-mini">
        <strong id="stat-total-papers">{weeklyPapers}</strong>
        <span>Total papers scanned</span>
      </article>
      <article class="stat-card-mini">
        <strong id="stat-flagged-papers">{weeklyFlagged}</strong>
        <span>Papers with detected languages (studied or mentioned-only)</span>
      </article>
      <article class="stat-card-mini">
        <strong id="stat-unique-langs">{weeklyUniqueLanguages}</strong>
        <span>Unique languages studied{weeklyMentionedOnlyLanguages > 0 && ` — plus ${weeklyMentionedOnlyLanguages} more mentioned-only languages`}</span>
      </article>
      {judgeCounts && judgeCounts.judged_papers > 0 && (
        <article class="stat-card-mini stat-card-wide">
          <strong id="stat-judged-papers">{judgeCounts.judged_papers}</strong>
          <span>Flagged papers judged by an LLM — <b>{judgeCounts.studied}</b> language detections are studied · <b>{judgeCounts.mentioned_only}</b> are mentioned-only · <b>{judgeCounts.false_positive}</b> are false positives</span>
        </article>
      )}
    </div>

    <div class="coverage-summary-panel">
      <div class="coverage-summary-grid">
        <div class="coverage-summary-card" id="weekly-coverage-pie-card">
          <div class="chart-subpanel-head">
            <div>
              <h3>Weekly coverage</h3>
              <p>Papers scanned this week vs. papers with at least one detected language.</p>
            </div>
          </div>
          <svg class="chart-svg coverage-pie-svg" width="100%" height="220" viewBox="0 0 460 220" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Pie chart of weekly papers scanned versus papers with detected languages">
            <g>
              {weeklyCoveragePie.map((slice) => (
                <g>
                  <path d={slice.path} fill={slice.color} stroke="white" stroke-width="1.5"></path>
                  <path d={slice.calloutPath} fill="none" stroke="var(--text)" stroke-dasharray="3 4" stroke-width="1"></path>
                  <text
                    x={228 + Math.cos(slice.midAngle) * 51}
                    y={110 + Math.sin(slice.midAngle) * 51 + 4}
                    text-anchor="middle"
                    class="chart-value"
                    style={`fill:${slice.label === 'Not detected' ? 'var(--text)' : '#fff'};font-size:0.5rem;font-weight:800`}
                  >
                    {coverageSlicePercent(slice.value, weeklyPapers)}
                  </text>
                  <text x={slice.labelX + (slice.side === 'right' ? 8 : -8)} y={slice.labelY + 4} text-anchor={slice.side === 'right' ? 'start' : 'end'} class="chart-axis-label">
                    {coverageSliceLines(slice.label, slice.value).map((line, index) => (
                      <tspan x={slice.labelX + (slice.side === 'right' ? 8 : -8)} dy={index === 0 ? 0 : 14}>{line}</tspan>
                    ))}
                  </text>
                </g>
              ))}
              <circle cx="228" cy="110" r="36" fill="var(--panel)" stroke="var(--line)"></circle>
              <text x="228" y="102" text-anchor="middle" class="chart-value">
                <tspan x="228" dy="0">{weeklyPapers}</tspan>
                <tspan x="228" dy="14" class="chart-axis-label">scanned</tspan>
              </text>
            </g>
          </svg>
        </div>

        <div class="coverage-summary-card" id="weekly-source-breakdown-card">
          <div class="chart-subpanel-head">
            <div>
              <h3>Source breakdown</h3>
              <p>How flagged papers were accessed — HTML full-text, PDF, or abstract only.</p>
            </div>
          </div>
          <svg class="chart-svg coverage-flow-svg" width="100%" height={weeklyCoverageFlowHeight} viewBox={`0 0 520 ${weeklyCoverageFlowHeight}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label="Small sankey showing flagged papers flowing into source types">
            <g>
              {weeklyCoverageFlowLinks.map((link) => (
                <path d={link.path} fill={link.color} fill-opacity="0.22" stroke={link.color} stroke-opacity="0.45" stroke-width="0.6">
                  <title>{`${link.label}: ${link.value}`}</title>
                </path>
              ))}
              <g>
                <rect x={weeklyCoverageFlowLeftX} y={weeklyCoverageFlowLeftNodeY} width={weeklyCoverageFlowNodeWidth} height={weeklyCoverageFlowLeftHeight} fill="#0f6c5d" rx="3"></rect>
                <text x={weeklyCoverageFlowLeftX - 8} y={weeklyCoverageFlowLeftNodeY + weeklyCoverageFlowLeftHeight / 2} text-anchor="end" class="chart-axis-label" style="fill:var(--text);font-weight:700">
                  <tspan x={weeklyCoverageFlowLeftX - 8} dy="-6">Flagged papers</tspan>
                  <tspan x={weeklyCoverageFlowLeftX - 8} dy="13">({weeklyCoverageSourceTotal})</tspan>
                </text>
              </g>
              {weeklyCoverageFlowLinks.map((link) => (
                <g>
                  <rect x={weeklyCoverageFlowRightX} y={link.y} width={weeklyCoverageFlowNodeWidth} height={link.linkHeight} fill={link.color} rx="3"></rect>
                  <text x={weeklyCoverageFlowRightX + weeklyCoverageFlowNodeWidth + 8} y={link.y + link.linkHeight / 2 + 4} text-anchor="start" class="chart-axis-label" style="fill:var(--text);font-weight:700">{link.label} ({link.value})</text>
                </g>
              ))}
            </g>
          </svg>
        </div>
      </div>
    </div>

    <div class="weekly-overview-grid">
      <article class="chart-subpanel">
        <div class="chart-subpanel-head">
          <div>
            <h3>Daily submission activity</h3>
            <p>Papers submitted each day of the week, split by whether they contained a detected language.</p>
          </div>
        </div>
        <div class="chart-legend-inline" style="justify-content:center">
          <span><span class="coverage-dot abstract"></span>Other papers</span>
          <span><span class="coverage-dot html"></span>Papers with detected languages</span>
        </div>
        {weeklyDailySeries.length > 0 ? (
          <div class="chart-scroll" id="weekly-daily-chart">
            <svg class="chart-svg" style="height:auto" width="100%" viewBox={`0 0 ${weeklyDailyWidth} ${weeklyDailyHeight}`} preserveAspectRatio="xMinYMin meet" role="img" aria-label="Daily submission activity stacked bar chart">
              <g transform={`translate(${weeklyDailyMargins.left} ${weeklyDailyMargins.top})`}>
                {/* baseline */}
                <line x1="0" x2={weeklyDailyInnerWidth} y1={weeklyDailyInnerHeight} y2={weeklyDailyInnerHeight} class="chart-grid-line"></line>
                {weeklyDailyY.ticks(5).map((tick) => (
                  <g transform={`translate(0 ${weeklyDailyY(tick)})`}>
                    <line x1="0" x2={weeklyDailyInnerWidth} y1="0" y2="0" class="chart-grid-line"></line>
                    <text x="-10" y="4" text-anchor="end" class="chart-axis-label">{tick}</text>
                  </g>
                ))}
                {weeklyDailySeries.map((point) => {
                  const total = Math.max(point.papers || 0, 0);
                  const flagged = Math.max(Math.min(point.flagged || 0, total), 0);
                  const other = total - flagged;
                  const x = weeklyDailyScale(point.date) || 0;
                  const barWidth = weeklyDailyScale.bandwidth();
                  const totalHeight = total > 0 ? (total / weeklyDailyMax) * weeklyDailyInnerHeight : 0;
                  const flaggedHeight = total > 0 ? totalHeight * (flagged / total) : 0;
                  const nonFlaggedHeight = Math.max(totalHeight - flaggedHeight, 0);
                  const y = weeklyDailyInnerHeight - totalHeight;
                  return (
                    <g transform={`translate(${x} 0)`}>
                      {nonFlaggedHeight > 0 && <path d={roundedTopRect(0, y, barWidth, nonFlaggedHeight, 5)} fill="rgba(32, 22, 19, 0.18)"></path>}
                      {flaggedHeight > 0 && <path d={roundedBottomRect(0, y + nonFlaggedHeight, barWidth, flaggedHeight, 5)} fill="#0f6c5d"></path>}
                      {nonFlaggedHeight > 14 && (
                        <text x={barWidth / 2} y={y + nonFlaggedHeight / 2 + 4} text-anchor="middle" class="chart-value">{other}</text>
                      )}
                      {total > 0 && nonFlaggedHeight <= 14 && other > 0 && (
                        <text x={barWidth / 2} y={Math.max(y - 4, 6)} text-anchor="middle" class="chart-value">{other}</text>
                      )}
                      {flaggedHeight > 14 && (
                        <text x={barWidth / 2} y={y + nonFlaggedHeight + flaggedHeight / 2 + 4} text-anchor="middle" class="chart-value" style="fill:#fff">{flagged}</text>
                      )}
                      <text x={barWidth / 2} y={weeklyDailyInnerHeight + 16} text-anchor="middle" class="chart-label">{formatWeekdayLabel(point.date)}</text>
                      <text x={barWidth / 2} y={weeklyDailyInnerHeight + 30} text-anchor="middle" class="chart-label chart-label-subtle">{point.date.slice(5)}</text>
                    </g>
                  );
                })}
              </g>
            </svg>
          </div>
        ) : (
          <p class="placeholder-text">Daily submission series will appear once a weekly snapshot is available.</p>
        )}
      </article>

      <article class="chart-subpanel">
        <div class="chart-subpanel-head">
          <div>
            <h3>Language class distribution</h3>
            <p>Languages studied this week grouped by class type. Each studied language occurrence in a paper is counted — a paper studying multiple language classes contributes to each.</p>
          </div>
        </div>
        <p class="chart-axis-label" style="text-align:center;margin-bottom:8px">Resource availability: Class 0 (lowest) to Class 5 (highest)</p>
        <div class="class-bar-wrap class-pie-wrap" id="weekly-class-pie-container">
          <svg class="chart-svg coverage-pie-svg" width="100%" height="220" viewBox="0 0 460 220" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Pie chart of resource class breakdown">
            <g>
              {weeklyClassPie.map((slice) => (
                <g>
                  <path d={slice.path} fill={slice.color} stroke="white" stroke-width="1.5"></path>
                  <path d={slice.calloutPath} fill="none" stroke="var(--text)" stroke-dasharray="3 4" stroke-width="1"></path>
                  <text x={slice.labelX + (slice.side === 'right' ? 8 : -8)} y={slice.labelY + 4} text-anchor={slice.side === 'right' ? 'start' : 'end'} class="chart-axis-label" style="fill:var(--text);font-weight:700">
                    {formatSliceLabel(slice.label, slice.value)}
                  </text>
                </g>
              ))}
              <circle cx="228" cy="110" r="36" fill="var(--panel)" stroke="var(--line)"></circle>
              <text x="228" y="104" text-anchor="middle" class="chart-value">{weeklyClassTotal}</text>
              <text x="228" y="119" text-anchor="middle" class="chart-axis-label">classified</text>
            </g>
          </svg>
        </div>
      </article>

      <article class="chart-subpanel chart-subpanel-wide">
        <div class="chart-subpanel-head">
          <div>
            <h3>Weekly rank comparison</h3>
            <p>Top 10 studied languages this week vs. last week, ranked by studied frequency (mentioned-only sightings excluded) — each side ranked independently, lines connect matched languages.</p>
          </div>
        </div>
        {hasPrevWeek && (mirrorPrevRows.length > 0 || mirrorCurrRows.length > 0) ? (
          <div class="chart-scroll">
            <svg class="chart-svg" width="100%" height={mirrorSvgHeight} viewBox={`0 0 ${mirrorSvgWidth} ${mirrorSvgHeight}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label="Mirror rank comparison chart">
              {/* Column headers */}
              <text x={mirrorLeftSpineX / 2} y="22" text-anchor="middle" class="chart-caption">PREV WEEK</text>
              <text x={mirrorRightSpineX + (mirrorSvgWidth - mirrorRightSpineX) / 2} y="22" text-anchor="middle" class="chart-caption">THIS WEEK</text>

              {/* Vertical spine guide lines */}
              <line x1={mirrorLeftSpineX} x2={mirrorLeftSpineX} y1={mirrorTopPad - 8} y2={mirrorSvgHeight - 8} stroke="var(--line)" stroke-width="1" opacity="0.25"></line>
              <line x1={mirrorRightSpineX} x2={mirrorRightSpineX} y1={mirrorTopPad - 8} y2={mirrorSvgHeight - 8} stroke="var(--line)" stroke-width="1" opacity="0.25"></line>

              {/* Connection S-curves between spine circle centres (drawn first, under bars) */}
              {mirrorConnections.map(conn => {
                const barColor = classColor(conn.language);
                const midX = mirrorSvgWidth / 2;
                const lx = mirrorLeftSpineX + mirrorRankR;
                const rx = mirrorRightSpineX - mirrorRankR;
                return (
                  <path d={`M ${lx} ${conn.prevY} C ${midX} ${conn.prevY} ${midX} ${conn.currY} ${rx} ${conn.currY}`}
                    fill="none" stroke={barColor} stroke-width="1.5" stroke-opacity="0.4"></path>
                );
              })}

              {/* Prev week rows — bar extends left from spine, circle at inner (right/spine) end, stacked label outside */}
              {mirrorPrevRows.map(row => {
                const barColor = classColor(row.language);
                const barW = (row.count / mirrorPrevMaxCount) * mirrorBarAreaWidth;
                const cy = row.y + mirrorRowHeight / 2;
                const labelX = mirrorLeftSpineX - barW - 8;
                const isConnected = mirrorCurrRowMap.has(row.language);
                return (
                  <g>
                    <rect x={mirrorLeftSpineX - barW} y={row.y + 4} width={barW} height={mirrorRowHeight - 8} rx="4" fill={barColor} fill-opacity="0.25"></rect>
                    {isConnected && (
                      <g>
                        <circle cx={mirrorLeftSpineX + mirrorRankR} cy={cy} r={mirrorRankR} fill={barColor} stroke="var(--panel)" stroke-width="2"></circle>
                        <text x={mirrorLeftSpineX + mirrorRankR} y={cy + 4} text-anchor="middle" style="fill:#fff;font-size:0.65rem;font-weight:700">{row.rank}</text>
                      </g>
                    )}
                    {pfpWarn(row.language) ? (
                      <g class="chart-warn-label" data-pfp-reason={pfpWarn(row.language)}>
                        <text x={labelX} y={cy - 3} text-anchor="end" class="h-bar-label h-bar-label-name">{row.language}<tspan class="warn-star-svg" dx="2" dy="-3" font-size="0.5em">★</tspan></text>
                      </g>
                    ) : (
                      <text x={labelX} y={cy - 3} text-anchor="end" class="h-bar-label h-bar-label-name">{row.language}</text>
                    )}
                    <text x={labelX} y={cy + 11} text-anchor="end" class="chart-axis-label">{row.count}</text>
                  </g>
                );
              })}

              {/* Dropped languages: S-curve dropping down from bar tip to rank circle in centre zone */}
              {mirrorDroppedWithRank.map(row => {
                const barColor = classColor(row.language);
                const cy = row.y + mirrorRowHeight / 2;
                const indicatorX = mirrorLeftSpineX + mirrorRankR * 3;
                const indicatorY = cy + 20;
                return (
                  <g opacity="0.65">
                    {(() => {
                      const startX = mirrorLeftSpineX + mirrorRankR * 2; // leave left circle edge
                      const endX = indicatorX - 10; // left edge of indicator circle
                      const midX = (startX + endX) / 2;
                      const deltaY = indicatorY - cy;
                      const off = Math.min(18, Math.abs(deltaY) / 2) * (deltaY === 0 ? 1 : Math.sign(deltaY));
                      const d = `M ${startX} ${cy} C ${midX} ${cy + off} ${midX} ${indicatorY - off} ${endX} ${indicatorY}`;
                      return (
                        <g opacity="0.65">
                    <path d={`M ${mirrorLeftSpineX} ${cy} C ${mirrorLeftSpineX + 22} ${cy} ${indicatorX - 5} ${indicatorY} ${indicatorX} ${indicatorY}`}
                      fill="none" stroke={barColor} stroke-width="1.2" stroke-dasharray="3 3"></path>
                    <circle cx={indicatorX} cy={indicatorY} r="10" fill="var(--panel)" stroke={barColor} stroke-width="1.5" stroke-dasharray="3 3"></circle>
                    <text x={indicatorX} y={indicatorY + 4} text-anchor="middle" style="fill:#000;font-size:0.6rem;font-weight:700">{row.currRank ?? '–'}</text>
                  </g>
                      );
                    })()}
                    <text x={indicatorX} y={indicatorY + 4} text-anchor="middle" style="fill:#000;font-size:0.6rem;font-weight:700">{row.currRank ?? '–'}</text>
                  </g>
                );
              })}

              {/* Current week rows — circle at inner (left/spine) end, bar extends right, stacked label outside */}
              {mirrorCurrRows.map(row => {
                const barColor = classColor(row.language);
                const barW = (row.count / mirrorCurrMaxCount) * mirrorBarAreaWidth;
                const cy = row.y + mirrorRowHeight / 2;
                const labelX = mirrorRightSpineX + barW + 8;
                const isConnected = mirrorPrevRowMap.has(row.language);
                return (
                  <g>
                    <rect x={mirrorRightSpineX} y={row.y + 4} width={barW} height={mirrorRowHeight - 8} rx="4" fill={barColor} fill-opacity="0.85"></rect>
                    {isConnected && (
                      <g>
                        <circle cx={mirrorRightSpineX - mirrorRankR} cy={cy} r={mirrorRankR} fill={barColor} stroke="var(--panel)" stroke-width="2"></circle>
                        <text x={mirrorRightSpineX - mirrorRankR} y={cy + 4} text-anchor="middle" style="fill:#fff;font-size:0.65rem;font-weight:700">{row.rank}</text>
                      </g>
                    )}
                    {pfpWarn(row.language) ? (
                      <g class="chart-warn-label" data-pfp-reason={pfpWarn(row.language)}>
                        <text x={labelX} y={cy - 3} text-anchor="start" class="h-bar-label h-bar-label-name">{row.language}<tspan class="warn-star-svg" dx="2" dy="-3" font-size="0.5em">★</tspan></text>
                      </g>
                    ) : (
                      <text x={labelX} y={cy - 3} text-anchor="start" class="h-bar-label h-bar-label-name">{row.language}</text>
                    )}
                    <text x={labelX} y={cy + 11} text-anchor="start" class="chart-axis-label">{row.count}</text>
                  </g>
                );
              })}

              {/* New languages: rank circle below in centre zone, S-curve rising up to bar */}
              {mirrorNewWithRank.map(row => {
                const barColor = classColor(row.language);
                const cy = row.y + mirrorRowHeight / 2;
                const indicatorX = mirrorRightSpineX - mirrorRankR * 3;
                const indicatorY = cy + 20;
                return (
                  <g opacity="0.65">
                    <path d={`M ${indicatorX} ${indicatorY} C ${indicatorX + 5} ${indicatorY} ${mirrorRightSpineX - 22} ${cy} ${mirrorRightSpineX} ${cy}`}
                      fill="none" stroke={barColor} stroke-width="1.2" stroke-dasharray="3 3"></path>
                    <circle cx={indicatorX} cy={indicatorY} r="10" fill="var(--panel)" stroke={barColor} stroke-width="1.5" stroke-dasharray="3 3"></circle>
                    <text x={indicatorX} y={indicatorY + 4} text-anchor="middle" style="fill:#000;font-size:0.6rem;font-weight:700">{row.prevRank ?? '–'}</text>
                  </g>
                );
              })}
            </svg>
          </div>
        ) : (
          <p class="placeholder-text">Rank comparison will appear once at least two weekly snapshots are available.</p>
        )}
      </article>

      <article class="chart-subpanel chart-subpanel-wide">
        <div class="chart-subpanel-head">
          <div>
            <h3>Full language frequency</h3>
            <p>Languages studied this week, ranked by frequency (excludes mentioned-only sightings).</p>
          </div>
        </div>
        {weeklyLanguageSeries.length > 0 ? (
          <div class="chart-scroll" id="weekly-lang-freq" style="max-height:520px;overflow-y:auto;">
            <svg class="chart-svg" style="height:auto" width="100%" viewBox={`0 0 ${weeklyLanguageBarWidth} ${weeklyLanguageBarHeight}`} preserveAspectRatio="xMinYMin meet" role="img" aria-label="Full language frequency horizontal bar chart">
              <g transform={`translate(${weeklyLanguageBarMargins.left} ${weeklyLanguageBarMargins.top})`}>
                {weeklyLanguageSeries.map((item, index) => {
                  const y = index * weeklyLanguageRowHeight;
                  const barWidth = (item.count / weeklyLanguageMax) * weeklyLanguageBarInnerWidth;
                  const classColorValue = classColor(item.language);
                  const labelInside = barWidth > weeklyLanguageBarInnerWidth - 100;
                  return (
                    <g transform={`translate(0 ${y})`}>
                      {pfpWarn(item.language) ? (
                        <g class="chart-warn-label" data-pfp-reason={pfpWarn(item.language)}>
                          <text x={-12} y={16} text-anchor="end" class="h-bar-label h-bar-label-name">{item.language}<tspan class="warn-star-svg" dx="2" dy="-3" font-size="0.5em">★</tspan></text>
                        </g>
                      ) : (
                        <text x={-12} y={16} text-anchor="end" class="h-bar-label h-bar-label-name">{item.language}</text>
                      )}
                      <rect x="0" y="3" width={barWidth} height="18" rx="4" fill={classColorValue} fill-opacity="0.86"></rect>
                      <text
                        x={labelInside ? barWidth - 6 : barWidth + 8}
                        y="16"
                        text-anchor={labelInside ? 'end' : 'start'}
                        class="h-bar-label h-bar-label-count"
                        style={labelInside ? 'fill:#fff' : ''}
                      >{item.count} ({formatPercent(item.count, weeklyLanguageTotalCount)})</text>
                    </g>
                  );
                })}
              </g>
            </svg>
          </div>
        ) : (
          <p class="placeholder-text">Top languages will appear here once studied languages are available.</p>
        )}
      </article>

      <article class="chart-subpanel chart-subpanel-wide">
        <div class="chart-subpanel-head">
          <div>
            <h3>Mention flow by language class</h3>
            <p>Bands show how this week's studied languages flow from each class to up to its top 10 languages, with band width proportional to studied frequency (excludes mentioned-only sightings).</p>
          </div>
        </div>
        {showSankey ? (
          <div class="chart-scroll sankey-scroll" style={`max-height:${sankeyVisibleHeight}px;overflow-y:auto;`}>
            <svg class="chart-svg" style="height:auto" width="100%" viewBox={`0 0 ${sankeySvgWidth} ${sankeySvgHeight}`} preserveAspectRatio="xMinYMin meet" role="img" aria-label="Sankey diagram of language class to detected language flow">
              <g transform="translate(0 0)">
                {sankeyPaths.map(link => (
                  <path d={link.d} fill={link.color} fill-opacity="0.3" stroke={link.color} stroke-width="0.5" stroke-opacity="0.4">
                    <title>{`${CLASS_LABELS[link.classId] || `Class ${link.classId}`} → ${link.language}: ${link.count}`}</title>
                  </path>
                ))}
                {sankeyClassGroups.map(node => (
                  <g>
                    <rect x={sankeyLeftNodeX} y={node.y} width={sankeyNodeWidth} height={node.height} fill={node.color} rx="2" stroke="rgba(0,0,0,0.25)" stroke-width="1"></rect>
                    <text x={sankeyLeftNodeX - 10} y={node.y + node.height / 2 + 5} text-anchor="end" font-size="14" font-weight="700" fill="var(--text)">{node.label} ({node.total})</text>
                  </g>
                ))}
                {sankeyRightNodes.map(node => (
                  <g>
                    <rect x={sankeyRightNodeX} y={node.y} width={sankeyNodeWidth} height={node.height} fill={node.color} rx="2"></rect>
                    {pfpWarn(node.language) ? (
                      <g class="chart-warn-label" data-pfp-reason={pfpWarn(node.language)}>
                        <text x={sankeyRightNodeX + sankeyNodeWidth + 8} y={node.y + node.height / 2 + 4} text-anchor="start" font-size="12" font-weight="700" fill="var(--text)">{node.language}<tspan class="warn-star-svg" dx="2" dy="-3" font-size="6">★</tspan> ({node.count})</text>
                      </g>
                    ) : (
                      <text x={sankeyRightNodeX + sankeyNodeWidth + 8} y={node.y + node.height / 2 + 4} text-anchor="start" font-size="12" font-weight="700" fill="var(--text)">{node.language} ({node.count})</text>
                    )}
                  </g>
                ))}
              </g>
            </svg>
          </div>
        ) : (
          <p class="placeholder-text">Flow diagram will appear once at least 5 languages have been studied.</p>
        )}
      </article>
    </div>
  </details>

  <details id="period-trends-panel" class="panel chart-panel wide-panel" style="display:none" open>
    <summary class="paper-collapse-summary">
      <div>
        <h2 id="period-trend-title">Period trends</h2>
        <p>Per-week and aggregated language trends for the selected period.</p>
      </div>
      <span class="paper-collapse-hint">Collapse section</span>
    </summary>

    <div class="stat-row">
      <article class="stat-card-mini">
        <strong id="period-stat-papers">—</strong>
        <span>Papers in period</span>
      </article>
      <article class="stat-card-mini">
        <strong id="period-stat-flagged">—</strong>
        <span>Papers with detected languages (studied or mentioned-only)</span>
      </article>
      <article class="stat-card-mini">
        <strong id="period-stat-unique">—</strong>
        <span>Unique languages studied</span>
      </article>
    </div>

    <div class="overall-summary-grid" style="margin-bottom:14px">
      <div class="coverage-summary-card">
        <div class="chart-subpanel-head">
          <div>
            <h3>Period coverage</h3>
            <p>Papers scanned across the selected period vs. papers with at least one detected language.</p>
          </div>
        </div>
        <svg class="chart-svg coverage-pie-svg" width="100%" height="260" viewBox="0 0 520 260" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Pie chart of selected period papers analyzed versus papers with detected languages" id="period-coverage-pie"></svg>
      </div>

      <article class="chart-subpanel">
        <div class="chart-subpanel-head">
          <div>
            <h3>Period scan volume</h3>
            <p>Total papers scanned in each week of the selected period, split by papers with and without detected languages.</p>
          </div>
        </div>
        <div class="chart-legend-inline" style="justify-content:center">
          <span><span class="coverage-dot abstract"></span>Other papers</span>
          <span><span class="coverage-dot html"></span>Papers with detected languages</span>
        </div>
        <div class="chart-scroll trend-period-chart-scroll" id="period-scan-volume"></div>
      </article>
    </div>

    <div class="overall-trend-grid">
      <article class="chart-subpanel">
        <div class="chart-subpanel-head">
          <div>
            <h3>Resource class mix by week</h3>
            <p>Proportional share of studied languages per resource-availability tier within the selected period.</p>
          </div>
        </div>
        <div class="class-legend" id="period-class-legend"></div>
        <div class="chart-scroll trend-period-chart-scroll" id="period-class-mix"></div>
      </article>

      <article class="chart-subpanel">
        <div class="chart-subpanel-head">
          <div>
            <h3>Unique languages per week</h3>
            <p>How many distinct languages were studied in each week of the selected period (mentioned-only sightings excluded).</p>
          </div>
        </div>
        <div class="chart-scroll trend-period-chart-scroll" id="period-unique-languages"></div>
      </article>

      <article class="chart-subpanel chart-subpanel-wide">
        <div class="chart-subpanel-head">
          <div>
            <h3>Top-language trends</h3>
            <p>Top 10 studied languages in the selected period, tracked across all weeks in the range (mentioned-only sightings excluded).</p>
          </div>
        </div>
        <div class="trend-line-layout" id="period-top-language-trends"></div>
      </article>

      <article class="chart-subpanel chart-subpanel-wide">
        <div class="chart-subpanel-head">
          <div>
            <h3>Language rank trajectory</h3>
            <p>Rank 1 = most studied that week (mentioned-only sightings excluded). Tracks the languages that appear in each top 10 across the selected period. Filter to a resource class to watch how languages move <em>within</em> that tier. Hover any point to trace a single language.</p>
          </div>
        </div>
        <div class="bump-filter-bar">
          <div class="trend-view-controls trend-view-controls-inline bump-class-chips" id="period-rank-class-chips" role="group" aria-label="Filter rank trajectory by resource class">
            <span class="bump-filter-label">Resource class</span>
            <button type="button" class="trend-view-chip is-active" data-rank-class="all" aria-pressed="true">All</button>
            {CLASS_LABELS.map((_label, classId) => (
              <button type="button" class="trend-view-chip bump-class-chip" data-rank-class={String(classId)} aria-pressed="false">
                <span class="bump-class-swatch" style={`background:${classColorForId(classId)}`}></span>{classId}
              </button>
            ))}
            <span class="chart-caption bump-class-caption">0 = lowest-resource · 5 = highest</span>
          </div>
        </div>
        <p class="bump-most-improved" id="period-rank-most-improved" aria-live="polite"></p>
        <div class="chart-scroll bump-chart-scroll" id="period-rank-trajectory"></div>
      </article>

      <article class="chart-subpanel chart-subpanel-wide">
        <div class="chart-subpanel-head">
          <div>
            <h3>Top languages in period</h3>
            <p>Most-studied languages across all weeks in the selected period (mentioned-only sightings excluded).</p>
          </div>
        </div>
        <div id="period-langs-chart"></div>
      </article>
    </div>
  </details>

  <details id="overall-trends-panel" class="panel chart-panel wide-panel" open>
    <summary class="paper-collapse-summary">
      <div>
        <h2>Overall trends</h2>
        <p>Aggregated across all available weeks, with coverage and trend views rolled up over time.</p>
      </div>
      <span class="paper-collapse-hint">Collapse section</span>
    </summary>

    <div class="stat-row">
      <article class="stat-card-mini">
        <strong>{trendOverallPapers}</strong>
        <span>Total papers analyzed</span>
      </article>
      <article class="stat-card-mini">
        <strong>{trendOverallFlagged}</strong>
        <span>Papers with detected languages (studied or mentioned-only)</span>
      </article>
      <article class="stat-card-mini">
        <strong>{overallCoverageUniqueText}</strong>
        <span>Unique languages studied across weeks</span>
      </article>
    </div>

    {(['week', 'month', 'year'] as TrendGranularity[]).map((gran) => {
      const {
        granularity: trendGranularity,
        granularityLabel: trendGranularityLabel,
        periods: trendPeriods,
        topLanguages: topTrendLanguages,
        trendSeries,
        endpointLabelY: trendEndpointLabelY,
        groupedHeight: trendGroupedHeight,
        groupedMargins: trendGroupedMargins,
        groupedScrollPx: trendGroupedScrollPx,
        groupedWidth: trendGroupedWidth,
        groupedInnerWidth: trendGroupedInnerWidth,
        groupedInnerHeight: trendGroupedInnerHeight,
        groupedScale: trendGroupedScale,
        groupedMax: trendGroupedMax,
        groupedY: trendGroupedY,
        topLangHeight: trendTopLanguageHeight,
        topLangMargins: trendTopLanguageMargins,
        topLangScrollPx: trendTopLanguageScrollPx,
        topLangWidth: trendTopLanguageWidth,
        topLangInnerWidth: trendTopLanguageInnerWidth,
        topLangInnerHeight: trendTopLanguageInnerHeight,
        topLangScale: trendTopLanguageScale,
        topLangMax: trendTopLanguageMax,
        topLangY: trendTopLanguageY,
        classHeight: trendClassHeight,
        classMargins: trendClassMargins,
        classScrollPx: trendClassScrollPx,
        classWidth: trendClassWidth,
        classInnerWidth: trendClassInnerWidth,
        classInnerHeight: trendClassInnerHeight,
        classScale: trendClassScale,
        classBars: trendClassBars,
        uniqueHeight: trendUniqueHeight,
        uniqueMargins: trendUniqueMargins,
        uniqueScrollPx: trendUniqueScrollPx,
        uniqueWidth: trendUniqueWidth,
        uniqueInnerWidth: trendUniqueInnerWidth,
        uniqueInnerHeight: trendUniqueInnerHeight,
        uniqueScale: trendUniqueScale,
        uniqueMax: trendUniqueMax,
        uniqueY: trendUniqueY,
      } = trendDataByGranularity[gran];
      return (
        <div class="trend-granularity-pane" data-granularity={gran} style={gran !== 'week' ? 'display:none' : ''}>
          <div class="overall-summary-grid" style="margin-bottom:14px">
            <div class="trend-view-controls trend-view-controls-inline">
              <button type="button" class={`trend-view-chip ${trendGranularity === 'week' ? 'is-active' : ''}`} data-trend-mode="week" aria-pressed={trendGranularity === 'week' ? 'true' : 'false'}>Week</button>
              <button type="button" class={`trend-view-chip ${trendGranularity === 'month' ? 'is-active' : ''}`} data-trend-mode="month" aria-pressed={trendGranularity === 'month' ? 'true' : 'false'}>Month</button>
              <button type="button" class={`trend-view-chip ${trendGranularity === 'year' ? 'is-active' : ''}`} data-trend-mode="year" aria-pressed={trendGranularity === 'year' ? 'true' : 'false'}>Year</button>
              <span class="chart-caption">Overall trends grouped by {trendGranularityLabel.toLowerCase()}</span>
      </div>
      <div class="coverage-summary-card">
        <div class="chart-subpanel-head">
            <div>
              <h3>Overall coverage</h3>
              <p>Papers scanned all time vs. papers with at least one detected language.</p>
            </div>
          </div>
      <svg class="chart-svg coverage-pie-svg" width="100%" height="260" viewBox="0 0 520 260" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Pie chart of total papers analyzed versus papers with detected languages across all weeks">
        <g>
          {overallCoveragePie.map((slice) => (
            <g>
              <path d={slice.path} fill={slice.color} stroke="white" stroke-width="1.5"></path>
              <path d={slice.calloutPath} fill="none" stroke="var(--text)" stroke-dasharray="3 4" stroke-width="1"></path>
              <text
                x={260 + Math.cos(slice.midAngle) * 60}
                y={130 + Math.sin(slice.midAngle) * 60 + 4}
                text-anchor="middle"
                class="chart-value"
                style={`fill:${slice.label === 'Not detected' ? 'var(--text)' : '#fff'};font-size:0.6rem;font-weight:800`}
              >
                {coverageSlicePercent(slice.value, trendOverallPapers)}
              </text>
              <text x={slice.labelX + (slice.side === 'right' ? 8 : -8)} y={slice.labelY + 4} text-anchor={slice.side === 'right' ? 'start' : 'end'} class="chart-axis-label">
                {coverageSliceLines(slice.label, slice.value).map((line, index) => (
                  <tspan x={slice.labelX + (slice.side === 'right' ? 8 : -8)} dy={index === 0 ? 0 : 14}>{line}</tspan>
                ))}
              </text>
            </g>
          ))}
          <circle cx="260" cy="130" r="44" fill="var(--panel)" stroke="var(--line)"></circle>
          <text x="260" y="122" text-anchor="middle" class="chart-value">
            <tspan x="260" dy="0">{trendOverallPapers}</tspan>
            <tspan x="260" dy="14" class="chart-axis-label">papers</tspan>
          </text>
        </g>
      </svg>
      </div>
      <article class="chart-subpanel">
            <div class="chart-subpanel-head">
              <div>
                <h3>{trendGranularityLabel} scan volume</h3>
                <p>Total papers scanned in each {trendGranularity} period, split by papers with and without detected languages.</p>
              </div>
            </div>
            <div class="chart-legend-inline" style="justify-content:center">
              <span><span class="coverage-dot abstract"></span>Other papers</span>
              <span><span class="coverage-dot html"></span>Papers with detected languages</span>
            </div>
            {trendPeriods.length > 0 ? (
              <div class={`chart-scroll trend-period-chart-scroll${trendGroupedScrollPx !== null ? ' chart-scroll-frozen' : ''}`}>
                {trendGroupedScrollPx !== null && (
                  <svg class="chart-axis-overlay" width={trendGroupedMargins.left} height={trendGroupedHeight} viewBox={`0 0 ${trendGroupedMargins.left} ${trendGroupedHeight}`} aria-hidden="true">
                    <rect x="0" y="0" width={trendGroupedMargins.left} height={trendGroupedHeight} class="chart-axis-overlay-bg"></rect>
                    {trendGroupedY.ticks(4).map((tick) => (
                      <text x={trendGroupedMargins.left - 10} y={trendGroupedMargins.top + trendGroupedY(tick) + 4} text-anchor="end" class="chart-axis-label">{tick}</text>
                    ))}
                  </svg>
                )}
                <svg class="chart-svg" width={trendGroupedScrollPx === null ? "100%" : undefined} style={trendGroupedScrollPx !== null ? `width:${trendGroupedScrollPx}px;max-width:none` : undefined} viewBox={`0 0 ${trendGroupedWidth} ${trendGroupedHeight}`} preserveAspectRatio="xMinYMin meet" role="img" aria-label={`Stacked bar chart of ${trendGranularity} scan volume`}>
                  <g transform={`translate(${trendGroupedMargins.left} ${trendGroupedMargins.top})`}>
                    {trendGroupedY.ticks(4).map((tick) => (
                      <g transform={`translate(0 ${trendGroupedY(tick)})`}>
                        <line x1="0" x2={trendGroupedInnerWidth} y1="0" y2="0" class="chart-grid-line"></line>
                        <text x="-10" y="4" text-anchor="end" class="chart-axis-label">{tick}</text>
                      </g>
                    ))}
                    {trendPeriods.map((period) => {
                      const x = trendGroupedScale(period.label) || 0;
                      const barWidth = trendGroupedScale.bandwidth();
                      const totalHeight = (period.papers / trendGroupedMax) * trendGroupedInnerHeight;
                      const flaggedHeight = (period.flaggedPapers / trendGroupedMax) * trendGroupedInnerHeight;
                      const otherHeight = Math.max(totalHeight - flaggedHeight, 0);
                      const yTop = trendGroupedInnerHeight - totalHeight;
                      const otherCount = Math.max(period.papers - period.flaggedPapers, 0);
                      return (
                        <g>
                          {otherHeight > 0 && <path d={roundedTopRect(x, yTop, barWidth, otherHeight, 5)} fill="rgba(32, 22, 19, 0.18)"></path>}
                          {flaggedHeight > 0 && <path d={roundedBottomRect(x, trendGroupedInnerHeight - flaggedHeight, barWidth, flaggedHeight, 5)} fill="#0f6c5d"></path>}
                          {otherHeight > 14 && (
                            <text x={x + barWidth / 2} y={yTop + otherHeight / 2 + 4} text-anchor="middle" class="chart-value">{otherCount}</text>
                          )}
                          {flaggedHeight > 14 && (
                            <text x={x + barWidth / 2} y={trendGroupedInnerHeight - flaggedHeight / 2 + 4} text-anchor="middle" class="chart-value" style="fill:#fff">{period.flaggedPapers}</text>
                          )}
                          <text x={x + barWidth / 2} y={trendGroupedInnerHeight + 18} text-anchor="middle" class="chart-label">{period.label}</text>
                        </g>
                      );
                    })}
                  </g>
                </svg>
              </div>
            ) : (
              <p class="placeholder-text">Scan volume will appear once multiple snapshots are available.</p>
            )}
      </article>
    </div>

    <div class="overall-trend-grid">
          <article class="chart-subpanel">
            <div class="chart-subpanel-head">
              <div>
                <h3>Resource class mix by {trendGranularity}</h3>
                <p>Proportional share of studied languages per resource-availability tier each {trendGranularity}.</p>
              </div>
            </div>
            <div class="class-legend">
              {CLASS_LABELS.map((label, classId) => (
                <div class="class-legend-item">
                  <span class="trend-legend-swatch" style={`background:${classColorForId(classId)}`}></span>
                  <span>{label}{classId === 0 ? ' (lowest)' : classId === CLASS_LABELS.length - 1 ? ' (highest)' : ''}</span>
                </div>
              ))}
            </div>
            {trendPeriods.length > 0 ? (
              <div class="chart-scroll trend-period-chart-scroll">
                <svg class="chart-svg" width={trendClassScrollPx === null ? "100%" : undefined} style={trendClassScrollPx !== null ? `width:${trendClassScrollPx}px;max-width:none` : undefined} viewBox={`0 0 ${trendClassWidth} ${trendClassHeight}`} preserveAspectRatio="xMinYMin meet" role="img" aria-label={`100 percent stacked bar chart of resource class mix by ${trendGranularity}`}>
                  <g transform={`translate(${trendClassMargins.left} ${trendClassMargins.top})`}>
                    {trendPeriods.map((period, index) => {
                      const x = trendClassScale(period.label) || 0;
                      const barWidth = trendClassScale.bandwidth();
                      const bar = trendClassBars[index];
                      return (
                        <g>
                          {bar.segments.map((segment) => (
                            <rect x={x} y={segment.y} width={barWidth} height={Math.max(segment.height, 0)} fill={segment.color}>
                              <title>{`${segment.label}: ${segment.count}`}</title>
                            </rect>
                          ))}
                          <text x={x + barWidth / 2} y={trendClassInnerHeight + 18} text-anchor="middle" class="chart-label">{period.label}</text>
                        </g>
                      );
                    })}
                  </g>
                </svg>
              </div>
            ) : (
              <p class="placeholder-text">Class mix will appear once multiple snapshots are available.</p>
            )}
          </article>

          <article class="chart-subpanel">
            <div class="chart-subpanel-head">
              <div>
                <h3>Unique languages per {trendGranularity}</h3>
                <p>How many distinct languages were studied in each {trendGranularity} period — a measure of breadth (mentioned-only sightings excluded).</p>
              </div>
            </div>
            {trendPeriods.length > 0 ? (
              <div class={`chart-scroll trend-period-chart-scroll${trendUniqueScrollPx !== null ? ' chart-scroll-frozen' : ''}`}>
                {trendUniqueScrollPx !== null && (
                  <svg class="chart-axis-overlay" width={trendUniqueMargins.left} height={trendUniqueHeight} viewBox={`0 0 ${trendUniqueMargins.left} ${trendUniqueHeight}`} aria-hidden="true">
                    <rect x="0" y="0" width={trendUniqueMargins.left} height={trendUniqueHeight} class="chart-axis-overlay-bg"></rect>
                    {trendUniqueY.ticks(4).map((tick) => (
                      <text x={trendUniqueMargins.left - 10} y={trendUniqueMargins.top + trendUniqueY(tick) + 4} text-anchor="end" class="chart-axis-label">{tick}</text>
                    ))}
                  </svg>
                )}
                <svg class="chart-svg" width={trendUniqueScrollPx === null ? "100%" : undefined} style={trendUniqueScrollPx !== null ? `width:${trendUniqueScrollPx}px;max-width:none` : undefined} viewBox={`0 0 ${trendUniqueWidth} ${trendUniqueHeight}`} preserveAspectRatio="xMinYMin meet" role="img" aria-label={`Line chart of unique languages per ${trendGranularity}`}>
                  <g transform={`translate(${trendUniqueMargins.left} ${trendUniqueMargins.top})`}>
                    {trendUniqueY.ticks(4).map((tick) => (
                      <g transform={`translate(0 ${trendUniqueY(tick)})`}>
                        <line x1="0" x2={trendUniqueInnerWidth} y1="0" y2="0" class="chart-grid-line"></line>
                        <text x="-10" y="4" text-anchor="end" class="chart-axis-label">{tick}</text>
                      </g>
                    ))}
                    <path
                      d={trendPeriods.map((period, i) => {
                        const x = (trendUniqueScale(period.label) || 0) + trendUniqueScale.bandwidth() / 2;
                        const y = trendUniqueY(period.uniqueLanguages);
                        return `${i === 0 ? 'M' : 'L'}${x},${y}`;
                      }).join(' ')}
                      fill="none" stroke="#7c3aed" stroke-width="2.5" stroke-linejoin="round"
                    />
                    {trendPeriods.map((period) => {
                      const x = (trendUniqueScale(period.label) || 0) + trendUniqueScale.bandwidth() / 2;
                      const y = trendUniqueY(period.uniqueLanguages);
                      const labelY = Math.max(12, Math.min(y - 10, trendUniqueInnerHeight - 12));
                      return (
                        <g>
                          <circle cx={x} cy={y} r="5" fill="#7c3aed" stroke="white" stroke-width="2"></circle>
                          <text x={x} y={labelY} text-anchor="middle" class="chart-value">{period.uniqueLanguages}</text>
                          <text x={x} y={trendUniqueInnerHeight + 18} text-anchor="middle" class="chart-label">{period.label}</text>
                        </g>
                      );
                    })}
                  </g>
                </svg>
              </div>
            ) : (
              <p class="placeholder-text">Unique-language counts will appear once multiple snapshots are available.</p>
            )}
          </article>

          <article class="chart-subpanel chart-subpanel-wide">
            <div class="chart-subpanel-head">
              <div>
                <h3>Top-language trends</h3>
                <p>Top 10 studied languages in the selected {trendGranularity} view, tracked across all available periods (mentioned-only sightings excluded).</p>
              </div>
            </div>
            {trendPeriods.length > 0 && topTrendLanguages.length > 0 ? (
              <div class="trend-line-layout">
                <div class={`chart-scroll trend-period-chart-scroll${trendTopLanguageScrollPx !== null ? ' chart-scroll-frozen' : ''}`}>
                  {trendTopLanguageScrollPx !== null && (
                    <svg class="chart-axis-overlay" width={trendTopLanguageMargins.left} height={trendTopLanguageHeight} viewBox={`0 0 ${trendTopLanguageMargins.left} ${trendTopLanguageHeight}`} aria-hidden="true">
                      <rect x="0" y="0" width={trendTopLanguageMargins.left} height={trendTopLanguageHeight} class="chart-axis-overlay-bg"></rect>
                      {trendTopLanguageY.ticks(6).map((tick) => (
                        <text x={trendTopLanguageMargins.left - 10} y={trendTopLanguageMargins.top + trendTopLanguageY(tick) + 4} text-anchor="end" class="chart-axis-label">{tick}</text>
                      ))}
                    </svg>
                  )}
                  <svg class="chart-svg trend-line-svg" width={trendTopLanguageScrollPx === null ? "100%" : undefined} style={trendTopLanguageScrollPx !== null ? `width:${trendTopLanguageScrollPx}px;max-width:none` : undefined} height={trendTopLanguageScrollPx !== null ? trendTopLanguageHeight : undefined} viewBox={`0 0 ${trendTopLanguageWidth} ${trendTopLanguageHeight}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={`Line chart of top-language trends across ${trendGranularity}s`}>
                    <g transform={`translate(${trendTopLanguageMargins.left} ${trendTopLanguageMargins.top})`}>
                      {trendTopLanguageY.ticks(6).map((tick) => (
                        <g transform={`translate(0 ${trendTopLanguageY(tick)})`}>
                          <line x1="0" x2={trendTopLanguageInnerWidth} y1="0" y2="0" class="chart-grid-line"></line>
                          <text x="-10" y="4" text-anchor="end" class="chart-axis-label">{tick}</text>
                        </g>
                      ))}
                      {trendSeries.map((series, idx) => {
                        const lastPt = series.points[series.points.length - 1];
                        const labelY = trendEndpointLabelY[idx];
                        return (
                          <g class="trend-series" data-lang={series.language}>
                            <path class="trend-hit" d={series.path} fill="none" stroke="transparent" stroke-width="14"></path>
                            <path class="trend-line" d={series.path} fill="none" stroke={series.color} stroke-width="2.5"></path>
                            {lastPt && lastPt.value > 0 && (
                              <g>
                                <path d={`M ${lastPt.x + 14} ${lastPt.y} L ${trendTopLanguageInnerWidth + 10} ${labelY}`} fill="none" stroke={series.color} stroke-dasharray="3 4" stroke-width="1"></path>
                                {pfpWarn(series.language) ? (
                                  <g class="chart-warn-label" data-pfp-reason={pfpWarn(series.language)}>
                                    <text x={trendTopLanguageInnerWidth + 14} y={labelY + 4} class="chart-axis-label" style={`fill:${series.color};font-weight:700`}>{series.language}<tspan class="warn-star-svg" dx="2" dy="-3" font-size="0.5em">★</tspan> · {lastPt.value}</text>
                                  </g>
                                ) : (
                                  <text x={trendTopLanguageInnerWidth + 14} y={labelY + 4} class="chart-axis-label" style={`fill:${series.color};font-weight:700`}>{series.language} · {lastPt.value}</text>
                                )}
                              </g>
                            )}
                            {series.points.map((point) => (
                              <path d={markerPath(idx, point.x, point.y, 4)} fill={series.color} stroke="white" stroke-width="1.2"></path>
                            ))}
                          </g>
                        );
                      })}
                      {trendPeriods.map((period) => {
                        const x = trendTopLanguageScale(period.label) || 0;
                        return (
                          <text x={x + trendTopLanguageScale.bandwidth() / 2} y={trendTopLanguageInnerHeight + 18} text-anchor="middle" class="chart-label">{period.label}</text>
                        );
                      })}
                    </g>
                  </svg>
                </div>
              </div>
            ) : (
              <p class="placeholder-text">Multi-period language trend lines will appear once data is available.</p>
            )}
          </article>

          <article class="chart-subpanel chart-subpanel-wide">
            <div class="chart-subpanel-head">
              <div>
                <h3>Language rank trajectory</h3>
                <p>Rank 1 = most studied that {trendGranularity} (mentioned-only sightings excluded). Filter to a resource class to watch how languages move <em>within</em> that tier. Hover any point to trace a single language.</p>
              </div>
            </div>
            <div class="bump-filter-bar">
              <div class="trend-view-controls trend-view-controls-inline bump-class-chips" id={`overall-rank-chips-${gran}`} role="group" aria-label="Filter rank trajectory by resource class">
                <span class="bump-filter-label">Resource class</span>
                <button type="button" class="trend-view-chip is-active" data-rank-class="all" aria-pressed="true">All</button>
                {CLASS_LABELS.map((_label, classId) => (
                  <button type="button" class="trend-view-chip bump-class-chip" data-rank-class={String(classId)} aria-pressed="false">
                    <span class="bump-class-swatch" style={`background:${classColorForId(classId)}`}></span>{classId}
                  </button>
                ))}
                <span class="chart-caption bump-class-caption">0 = lowest-resource · 5 = highest</span>
              </div>
            </div>
            <p class="bump-most-improved" id={`overall-rank-stats-${gran}`}></p>
            <div class="chart-scroll bump-chart-scroll" id={`overall-rank-trajectory-${gran}`}></div>
          </article>
        </div>
        </div>
      );
    })}
  </details>
  <div id="chart-pfp-tooltip" class="review-popover-body chart-pfp-tooltip" aria-hidden="true">
    <strong>⚠ Manual verification may be needed</strong>
    <p id="chart-pfp-tooltip-reason"></p>
  </div>

  <script is:inline>
    const trendStateStorageKey = 'langtrend:overall-trend-details-state';
    const trendScrollStorageKey = 'langtrend:overall-trend-scroll-y';
    const trendModeStorageKey = 'langtrend:trend-mode';

    // Horizontally scrollable per-period charts (scan volume, class mix,
    // unique languages, top-language trends, rank trajectory) default to
    // showing the earliest period on the left — scroll them to the right
    // edge so the latest period is visible without the user having to
    // scroll manually. Safe to call on non-overflowing charts (scrollLeft
    // is a no-op when scrollWidth === clientWidth) and on hidden panes
    // (scrollWidth reads 0 while display:none, so it's a harmless no-op
    // there too — callers re-invoke this once a pane becomes visible).
    function scrollChartsToEnd(root) {
      (root || document).querySelectorAll('.trend-period-chart-scroll, .bump-chart-scroll').forEach(function(el) {
        el.scrollLeft = el.scrollWidth;
      });
    }

    function switchTrendPane(mode) {
      document.querySelectorAll('.trend-granularity-pane').forEach(function(pane) {
        pane.style.display = pane.dataset.granularity === mode ? '' : 'none';
      });
      document.querySelectorAll('.trend-view-chip').forEach(function(btn) {
        var active = btn.getAttribute('data-trend-mode') === mode;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      // Preserve other query params (notably `from`, which drives the period
      // comparison panel) instead of overwriting the whole query string.
      try {
        const _p = new URLSearchParams(location.search);
        _p.set('trend', mode);
        history.replaceState(null, '', '?' + _p.toString());
      } catch {}
      try { sessionStorage.setItem(trendModeStorageKey, mode); } catch {}
      var activePane = document.querySelector('.trend-granularity-pane[data-granularity="' + mode + '"]');
      requestAnimationFrame(function() { scrollChartsToEnd(activePane); });
    }

    // Restore trend mode from URL param or session storage
    try {
      var _trendMode = new URLSearchParams(location.search).get('trend') || sessionStorage.getItem(trendModeStorageKey) || 'week';
      if (_trendMode !== 'week') switchTrendPane(_trendMode);
      else requestAnimationFrame(function() { scrollChartsToEnd(); });
    } catch {}

    try { window.history.scrollRestoration = 'manual'; } catch {}

    // Apply collapse state immediately, before toggle listeners are attached,
    // to avoid a flash of all-expanded sections after filter-button navigation.
    try {
      const _rawState = sessionStorage.getItem(trendStateStorageKey);
      if (_rawState) {
        const _state = JSON.parse(_rawState);
        document.querySelectorAll('details').forEach((el, i) => {
          const key = el.id || el.getAttribute('data-trend-panel') || el.getAttribute('name') || `details-${i}`;
          if (Object.prototype.hasOwnProperty.call(_state, key)) el.open = Boolean(_state[key]);
        });
      }
    } catch {}

    const saveTrendState = () => {
      try {
        sessionStorage.setItem(trendScrollStorageKey, String(window.scrollY));
        const state = {};
        document.querySelectorAll('details').forEach((el, i) => {
          const key = el.id || el.getAttribute('data-trend-panel') || el.getAttribute('name') || `details-${i}`;
          state[key] = el.open;
        });
        sessionStorage.setItem(trendStateStorageKey, JSON.stringify(state));
      } catch {}
    };

    // Add toggle listeners after the initial restore so restoration-triggered
    // toggles don't overwrite sessionStorage with a partially-restored state.
    document.querySelectorAll('details').forEach((el) => el.addEventListener('toggle', saveTrendState));

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest('[data-trend-mode]') : null;
      if (!target) return;
      saveTrendState();
      switchTrendPane(target.getAttribute('data-trend-mode'));
    });

    window.addEventListener('beforeunload', saveTrendState);

    // Chart language warning tooltips
    const _pfpTip = document.getElementById('chart-pfp-tooltip');
    const _pfpReason = document.getElementById('chart-pfp-tooltip-reason');
    function _showPfpTip(el, reason) {
      if (!_pfpTip || !_pfpReason) return;
      _pfpReason.textContent = reason;
      const rect = el.getBoundingClientRect();
      const tipW = 280;
      let left = rect.left + window.scrollX + rect.width / 2 - tipW / 2;
      left = Math.max(8, Math.min(left, window.innerWidth + window.scrollX - tipW - 8));
      _pfpTip.style.left = left + 'px';
      _pfpTip.style.top = (rect.top + window.scrollY - 8) + 'px';
      _pfpTip.style.transform = 'translateY(-100%)';
      _pfpTip.style.opacity = '1';
      _pfpTip.style.visibility = 'visible';
      _pfpTip.removeAttribute('aria-hidden');
    }
    function _hidePfpTip() {
      if (!_pfpTip) return;
      _pfpTip.style.opacity = '0';
      _pfpTip.style.visibility = 'hidden';
      _pfpTip.setAttribute('aria-hidden', 'true');
    }
    document.querySelectorAll('.chart-warn-label').forEach(function(el) {
      const reason = el.getAttribute('data-pfp-reason') || '';
      el.addEventListener('mouseenter', function() { _showPfpTip(el, reason); });
      el.addEventListener('mouseleave', _hidePfpTip);
      el.addEventListener('focusin', function() { _showPfpTip(el, reason); });
      el.addEventListener('focusout', _hidePfpTip);
    });

    // Restore scroll position. Try immediately on load (collapse state was
    // applied synchronously so layout height is already correct), then
    // retry once after a frame to cover any deferred rendering.
    window.addEventListener('load', () => {
      try {
        const scrollY = Number(sessionStorage.getItem(trendScrollStorageKey)) || 0;
        if (scrollY > 0) {
          window.scrollTo(0, scrollY);
          requestAnimationFrame(() => window.scrollTo(0, scrollY));
        }
      } catch {}
    });

    // --- Period mode enhancements ---
    (function() {
      function fmtPeriodWeekLabel(slug) {
        var start = new Date(slug + 'T12:00:00');
        var end = new Date(start); end.setDate(end.getDate() + 6);
        var sm = start.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
        var em = end.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
        return sm + '–' + em;
      }
      function fmtShortLabel(slug) {
        var d = new Date(slug + 'T12:00:00');
        return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
      }

      function roundedTopRectPath(x, y, w, h, r) {
        r = Math.min(r, w / 2, Math.max(h / 2, 0));
        if (h <= 0) return '';
        return 'M '+(x+r)+','+y+' H '+(x+w-r)+' Q '+(x+w)+','+y+' '+(x+w)+','+(y+r)+' V '+(y+h)+' H '+x+' V '+(y+r)+' Q '+x+','+y+' '+(x+r)+','+y+' Z';
      }

      function roundedBottomRectPath(x, y, w, h, r) {
        r = Math.min(r, w / 2, Math.max(h / 2, 0));
        if (h <= 0) return '';
        return 'M '+x+','+y+' H '+(x+w)+' V '+(y+h-r)+' Q '+(x+w)+','+(y+h)+' '+(x+w-r)+','+(y+h)+' H '+(x+r)+' Q '+x+','+(y+h)+' '+x+','+(y+h-r)+' Z';
      }

      // A small "frozen column" y-axis overlay for horizontally scrollable
      // per-period charts (many weeks/months/years): without it, the axis
      // labels scroll away with the plot and the user has to scroll all the
      // way back to the start to see what the numbers mean. tickEntries is
      // an array of { y, label } where y is already in inner-plot
      // coordinates (0 at the top of the plot area, matching the main
      // chart's own tick positions).
      function axisOverlaySvg(marginLeft, marginTop, height, tickEntries) {
        var bg = '<rect x="0" y="0" width="' + marginLeft + '" height="' + height + '" class="chart-axis-overlay-bg"></rect>';
        var labels = tickEntries.map(function(t) {
          return '<text x="' + (marginLeft - 10) + '" y="' + (marginTop + t.y + 4) + '" text-anchor="end" class="chart-axis-label">' + t.label + '</text>';
        }).join('');
        return '<svg class="chart-axis-overlay" width="' + marginLeft + '" height="' + height + '" viewBox="0 0 ' + marginLeft + ' ' + height + '" aria-hidden="true">' + bg + labels + '</svg>';
      }

      function pieSlicePath(cx, cy, radius, startAngle, endAngle) {
        var start = {
          x: cx + radius * Math.cos(startAngle),
          y: cy + radius * Math.sin(startAngle),
        };
        var end = {
          x: cx + radius * Math.cos(endAngle),
          y: cy + radius * Math.sin(endAngle),
        };
        var largeArcFlag = endAngle - startAngle > Math.PI ? 1 : 0;
        return 'M '+cx+' '+cy+' L '+start.x+' '+start.y+' A '+radius+' '+radius+' 0 '+largeArcFlag+' 1 '+end.x+' '+end.y+' Z';
      }

      function buildPieSlices(items, centerX, centerY, radius, startOffset, labelOffset) {
        var total = Math.max(1, items.reduce(function(sum, item) { return sum + Math.max(item.value || 0, 0); }, 0));
        var angle = startOffset;
        var slices = [];

        items.forEach(function(item) {
          if ((item.value || 0) <= 0) {
            return;
          }

          var sweep = (item.value / total) * Math.PI * 2;
          var startAngle = angle;
          var endAngle = angle + sweep;
          var midAngle = startAngle + sweep / 2;
          var side = Math.cos(midAngle) >= 0 ? 'right' : 'left';
          var calloutStart = {
            x: centerX + radius * Math.cos(midAngle),
            y: centerY + radius * Math.sin(midAngle),
          };
          var calloutElbow = {
            x: centerX + (radius + 16) * Math.cos(midAngle),
            y: centerY + (radius + 16) * Math.sin(midAngle),
          };
          var labelX = centerX + (side === 'right' ? radius + labelOffset : -(radius + labelOffset));
          var labelY = centerY + Math.sin(midAngle) * (radius + 22);

          slices.push({
            ...item,
            startAngle: startAngle,
            endAngle: endAngle,
            midAngle: midAngle,
            path: pieSlicePath(centerX, centerY, radius, startAngle, endAngle),
            calloutPath: 'M '+calloutStart.x+' '+calloutStart.y+' L '+calloutElbow.x+' '+calloutElbow.y+' L '+labelX+' '+labelY,
            labelX: labelX,
            labelY: labelY,
            side: side,
          });
          angle = endAngle;
        });

        var leftSlices = slices.filter(function(slice) { return slice.side === 'left'; }).sort(function(a, b) { return a.labelY - b.labelY; });
        var rightSlices = slices.filter(function(slice) { return slice.side === 'right'; }).sort(function(a, b) { return a.labelY - b.labelY; });

        function settle(collection) {
          var previousY = -Infinity;
          collection.forEach(function(slice) {
            slice.labelY = Math.max(slice.labelY, previousY + 16);
            previousY = slice.labelY;
          });
        }

        settle(leftSlices);
        settle(rightSlices);
        return slices;
      }

      var weekMetaEl = document.getElementById('all-weeks-meta');
      if (!weekMetaEl) return;
      var allWeeksMeta;
      try { allWeeksMeta = JSON.parse(weekMetaEl.textContent || '[]'); } catch(e) { return; }
      var langClassesMetaEl = document.getElementById('lang-classes-meta');
      var langClassesMeta = {};
      try { langClassesMeta = JSON.parse(langClassesMetaEl && langClassesMetaEl.textContent || '{}'); } catch(e) { langClassesMeta = {}; }

      // Returns -1 (not 0) for a language absent from the taxonomy map — this
      // used to only feed chart coloring (where classColorForLanguage's
      // `|| CLASS_COLORS_JS[0]` already falls back safely on an out-of-range
      // index), but the resource-class filter now also calls this to decide
      // tier membership. Defaulting an unclassified language to "0" would
      // silently count it as lowest-resource in the Class 0 filter's stats;
      // -1 never matches a real 0–5 filter, so it only shows under "All".
      function classIndexForLanguage(language) {
        for (var classIdStr in langClassesMeta) {
          if (!Object.prototype.hasOwnProperty.call(langClassesMeta, classIdStr)) continue;
          var languages = langClassesMeta[classIdStr] || [];
          if (Array.isArray(languages) && languages.indexOf(language) !== -1) {
            return Number(classIdStr);
          }
        }
        return -1;
      }

      function classColorForLanguage(language) {
        return CLASS_COLORS_JS[classIndexForLanguage(language)] || CLASS_COLORS_JS[0];
      }

      var anchorPath = location.pathname.replace(/index\.html$/, '').replace(/\/$/, '');
      var pathParts = anchorPath.split('/');
      var anchorSlug = pathParts[pathParts.length - 1];

      var _params = new URLSearchParams(location.search);
      var fromParam = _params.get('from');

      var periodSwitcher = document.getElementById('period-week-switcher');
      var periodTrendsPanel = document.getElementById('period-trends-panel');

      // Chart color palettes — declared here (before the period-only early
      // return) because the always-on overall rank trajectory below needs them.
      var CLASS_COLORS_JS = ['#cfe8f3','#a2d4ec','#73bfe2','#46abdb','#1696d2','#12719e'];
      var CLASS_LABELS_JS = ['Class 0','Class 1','Class 2','Class 3','Class 4','Class 5'];
      var TREND_LINE_COLORS_JS = ['#1696d2','#000000','#d2d2d2','#fdbf11','#55b748','#ec008b','#0a4c6a','#db2b27','#5c5859','#a2d4ec'];
      var BUMP_RANK_COLORS_JS = ['#1A2E19','#2C5C2D','#347032','#408941','#55B748','#78C26D','#8ABE80','#98CF90','#BCDEB4','#DCEDD9'];

      // Overall-trends rank trajectory — always rendered (not gated on the period
      // `from` param), client-side so the resource-class filter re-ranks in place.
      // One instance per granularity pane (week/month/year); each keeps its own
      // filter state. Reuses the exact renderer/stats as the period panel.
      (function() {
        var obpEl = document.getElementById('overall-bump-periods');
        var overallBumpPeriods = {};
        try { overallBumpPeriods = JSON.parse(obpEl && obpEl.textContent || '{}'); } catch (e) { overallBumpPeriods = {}; }
        ['week', 'month', 'year'].forEach(function(gran) {
          var container = document.getElementById('overall-rank-trajectory-' + gran);
          var statsEl = document.getElementById('overall-rank-stats-' + gran);
          var chips = document.getElementById('overall-rank-chips-' + gran);
          if (!container) return;
          var periods = overallBumpPeriods[gran] || [];
          var state = { filter: 'all' };
          renderRankTrajectory(container, statsEl, periods, state.filter);
          if (chips) {
            chips.addEventListener('click', function(e) {
              var btn = e.target.closest ? e.target.closest('button[data-rank-class]') : null;
              if (!btn || !chips.contains(btn)) return;
              state.filter = btn.getAttribute('data-rank-class');
              chips.querySelectorAll('button[data-rank-class]').forEach(function(b) {
                var active = b === btn;
                b.classList.toggle('is-active', active);
                b.setAttribute('aria-pressed', active ? 'true' : 'false');
              });
              renderRankTrajectory(container, statsEl, periods, state.filter);
            });
          }
        });
      }());

      if (!fromParam) return;

      if (periodSwitcher) periodSwitcher.style.display = '';
      if (periodTrendsPanel) periodTrendsPanel.style.display = '';

      var sortedSlugs = allWeeksMeta.map(function(w) { return w.weekStart; }).sort();
      var fromIdx = sortedSlugs.indexOf(fromParam);
      var toIdx = sortedSlugs.indexOf(anchorSlug);
      if (fromIdx === -1 || toIdx === -1) return;

      var periodSlugs = sortedSlugs.slice(Math.min(fromIdx, toIdx), Math.max(fromIdx, toIdx) + 1);
      var periodData = periodSlugs.map(function(slug) {
        return allWeeksMeta.find(function(w) { return w.weekStart === slug; });
      }).filter(Boolean);

      // Week switcher: populate and wire change handler
      // --- Chart re-rendering helpers --- (color palettes declared above)

      function sectorPathSVG(cx, cy, r, innerR, startDeg, sweepDeg) {
        if (sweepDeg >= 360) sweepDeg = 359.99;
        if (sweepDeg <= 0) return '';
        var s = (startDeg - 90) * Math.PI / 180;
        var e = (startDeg + sweepDeg - 90) * Math.PI / 180;
        var x1o = cx + r*Math.cos(s), y1o = cy + r*Math.sin(s);
        var x2o = cx + r*Math.cos(e), y2o = cy + r*Math.sin(e);
        var x1i = cx + innerR*Math.cos(e), y1i = cy + innerR*Math.sin(e);
        var x2i = cx + innerR*Math.cos(s), y2i = cy + innerR*Math.sin(s);
        var lg = sweepDeg > 180 ? 1 : 0;
        return 'M'+x1o+','+y1o+' A'+r+','+r+',0,'+lg+',1,'+x2o+','+y2o+' L'+x1i+','+y1i+' A'+innerR+','+innerR+',0,'+lg+',0,'+x2i+','+y2i+' Z';
      }

      function buildBumpSegmentPath(start, end) {
        var midX = (start.x + end.x) / 2;
        return 'M ' + start.x + ' ' + start.y + ' C ' + midX + ' ' + start.y + ' ' + midX + ' ' + end.y + ' ' + end.x + ' ' + end.y;
      }

      function markerPathJs(shapeIdx, cx, cy, size) {
        var s = size;
        switch (shapeIdx % 10) {
          case 0: return 'M ' + cx + ',' + (cy - s) + ' A ' + s + ',' + s + ' 0 1 1 ' + (cx - 0.001) + ',' + (cy - s) + ' Z';
          case 1: return 'M ' + (cx - s) + ',' + (cy - s) + ' H ' + (cx + s) + ' V ' + (cy + s) + ' H ' + (cx - s) + ' Z';
          case 2: return 'M ' + cx + ',' + (cy - s * 1.3) + ' L ' + (cx + s * 1.3) + ',' + cy + ' L ' + cx + ',' + (cy + s * 1.3) + ' L ' + (cx - s * 1.3) + ',' + cy + ' Z';
          case 3: return 'M ' + cx + ',' + (cy - s * 1.3) + ' L ' + (cx + s * 1.15) + ',' + (cy + s * 0.75) + ' L ' + (cx - s * 1.15) + ',' + (cy + s * 0.75) + ' Z';
          case 4: return 'M ' + cx + ',' + (cy + s * 1.3) + ' L ' + (cx + s * 1.15) + ',' + (cy - s * 0.75) + ' L ' + (cx - s * 1.15) + ',' + (cy - s * 0.75) + ' Z';
          case 5: return 'M ' + (cx - s) + ',' + cy + ' H ' + (cx + s) + ' M ' + cx + ',' + (cy - s) + ' V ' + (cy + s);
          case 6: {
            var pts = Array.from({length: 5}, function(_, i) {
              var a = (i * 2 * Math.PI / 5) - Math.PI / 2;
              return (cx + s * 1.2 * Math.cos(a)) + ',' + (cy + s * 1.2 * Math.sin(a));
            });
            return 'M ' + pts.join(' L ') + ' Z';
          }
          case 7: {
            var hexPts = Array.from({length: 6}, function(_, i) {
              var a = (i * Math.PI / 3);
              return (cx + s * 1.1 * Math.cos(a)) + ',' + (cy + s * 1.1 * Math.sin(a));
            });
            return 'M ' + hexPts.join(' L ') + ' Z';
          }
          case 8: return 'M ' + (cx - s * 0.4) + ',' + (cy - s * 1.2) + ' H ' + (cx + s * 0.4) + ' V ' + (cy - s * 0.4) + ' H ' + (cx + s * 1.2) + ' V ' + (cy + s * 0.4) + ' H ' + (cx + s * 0.4) + ' V ' + (cy + s * 1.2) + ' H ' + (cx - s * 0.4) + ' V ' + (cy + s * 0.4) + ' H ' + (cx - s * 1.2) + ' V ' + (cy - s * 0.4) + ' H ' + (cx - s * 0.4) + ' Z';
          default: return 'M ' + (cx - s) + ',' + (cy - s) + ' L ' + (cx + s) + ',' + (cy - s) + ' L ' + cx + ',' + (cy + s) + ' Z';
        }
      }

      function renderCoveragePie(papers, flaggedPapers) {
        var card = document.getElementById('weekly-coverage-pie-card');
        if (!card) return;
        var existing = card.querySelector('svg');
        if (!existing) return;
        var cx = 228, cy = 110, r = 66, innerR = 36;
        var notFlagged = Math.max(papers - flaggedPapers, 0);
        var slices = buildPieSlices([
          { label: 'Not detected', value: notFlagged, color: 'rgba(32, 22, 19, 0.16)' },
          { label: 'Papers with detected languages', value: flaggedPapers, color: '#0f6c5d' },
        ].sort(function(left, right) { return right.value - left.value; }), cx, cy, r, -Math.PI / 2, 30);

        function coverageSliceLines(label, value) {
          if (label === 'Papers with detected languages') {
            return ['Papers with', 'detected languages ('+value+')'];
          }
          return [label+' ('+value+')'];
        }

        existing.outerHTML = '<svg class="chart-svg coverage-pie-svg" width="100%" height="220" viewBox="0 0 460 220" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Pie chart of weekly papers scanned versus papers with detected languages"><g>' +
          slices.map(function(slice) {
            var percent = papers > 0 ? ((slice.value / papers) * 100).toFixed(1) + '%' : '0.0%';
            var labelX = slice.labelX + (slice.side === 'right' ? 8 : -8);
            var labelAnchor = slice.side === 'right' ? 'start' : 'end';
            return '<g><path d="'+slice.path+'" fill="'+slice.color+'" stroke="white" stroke-width="1.5"></path>'+
              '<path d="'+slice.calloutPath+'" fill="none" stroke="var(--text)" stroke-dasharray="3 4" stroke-width="1"></path>'+
              '<text x="'+(cx + Math.cos(slice.midAngle) * 51)+'" y="'+(cy + Math.sin(slice.midAngle) * 51 + 4)+'" text-anchor="middle" class="chart-value" style="fill:'+(slice.label === 'Not detected' ? 'var(--text)' : '#fff')+';font-size:0.5rem;font-weight:800">'+percent+'</text>'+
              '<text x="'+labelX+'" y="'+(slice.labelY + 4)+'" text-anchor="'+labelAnchor+'" class="chart-axis-label">'+coverageSliceLines(slice.label, slice.value).map(function(line, index) { return '<tspan x="'+labelX+'" dy="'+(index === 0 ? 0 : 14)+'">'+line+'</tspan>'; }).join('')+'</text>'+
              '</g>';
          }).join('') +
          '<circle cx="228" cy="110" r="36" fill="var(--panel)" stroke="var(--line)"></circle>'+
          '<text x="228" y="102" text-anchor="middle" class="chart-value"><tspan x="228" dy="0">'+papers+'</tspan><tspan x="228" dy="14" class="chart-axis-label">scanned</tspan></text>'+
          '</g></svg>';
      }

      function renderSourceBreakdown(coverageStats, total) {
        var card = document.getElementById('weekly-source-breakdown-card');
        if (!card) return;
        var svg = card.querySelector('svg');
        if (!svg) return;
        var cs = coverageStats || { htmlScanned:0, pdfOnly:0, abstractOnly:0 };
        var items = [
          { label:'HTML + Abstract', value:cs.htmlScanned, color:'#ec008b' },
          { label:'PDF + Abstract', value:cs.pdfOnly, color:'#d94f2b' },
          { label:'Abstract only', value:cs.abstractOnly, color:'#7b6c64' }
        ].filter(function(item) { return item.value > 0; }).sort(function(left, right) { return right.value - left.value; });
        var totalValue = Math.max(1, items.reduce(function(sum, item) { return sum + item.value; }, 0));
        var flowHeight = 160;
        var leftX = 140;
        var rightX = 360;
        var nodeW = 18;
        var barHeight = 90;
        var rightYBase = 28;
        var rightGap = 6;
        var nodes = [];
        var cursor = rightYBase;
        items.forEach(function(item) {
          var height = Math.max(10, (item.value / totalValue) * barHeight);
          nodes.push({ label: item.label, value: item.value, color: item.color, y: cursor, height: height });
          cursor += height + rightGap;
        });
        var leftLinkTotal = nodes.reduce(function(sum, item) { return sum + item.height; }, 0);
        var rightSpanTop = nodes[0] ? nodes[0].y : rightYBase;
        var rightSpanBottom = nodes.length > 0 ? nodes[nodes.length - 1].y + nodes[nodes.length - 1].height : rightYBase;
        var leftHeight = Math.max(18, leftLinkTotal);
        var leftNodeY = (rightSpanTop + rightSpanBottom) / 2 - leftHeight / 2;
        var links = [];
        var offset = 0;
        nodes.forEach(function(node) {
          var linkHeight = Math.max(10, node.height);
          var srcY = leftNodeY + offset;
          var tgtY = node.y;
          offset += linkHeight;
          links.push('<path d="M '+(leftX + nodeW)+' '+srcY+' C '+(leftX + 112)+' '+srcY+' '+(leftX + 112)+' '+tgtY+' '+rightX+' '+tgtY+' L '+rightX+' '+(tgtY + linkHeight)+' C '+(leftX + 112)+' '+(tgtY + linkHeight)+' '+(leftX + 112)+' '+(srcY + linkHeight)+' '+(leftX + nodeW)+' '+(srcY + linkHeight)+' Z" fill="'+node.color+'" fill-opacity="0.22" stroke="'+node.color+'" stroke-opacity="0.45" stroke-width="0.6"><title>'+node.label+': '+node.value+'</title></path>');
        });
        var rects = nodes.map(function(node) {
          return '<g><rect x="'+rightX+'" y="'+node.y+'" width="'+nodeW+'" height="'+node.height+'" fill="'+node.color+'" rx="3"></rect><text x="'+(rightX + nodeW + 8)+'" y="'+(node.y + node.height / 2 + 4)+'" text-anchor="start" class="chart-axis-label" style="fill:var(--text);font-weight:700">'+node.label+' ('+node.value+')</text></g>';
        }).join('');
        svg.setAttribute('width', '100%');
        svg.setAttribute('height', String(flowHeight));
        svg.setAttribute('viewBox', '0 0 520 '+flowHeight);
        svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
        svg.setAttribute('aria-label', 'Small sankey showing detected languages flowing into source types');
        svg.innerHTML = '<g>'+links.join('')+
          '<g><rect x="'+leftX+'" y="'+leftNodeY+'" width="'+nodeW+'" height="'+leftHeight+'" fill="#0f6c5d" rx="3"></rect><text x="'+(leftX - 8)+'" y="'+(leftNodeY + leftHeight / 2)+'" text-anchor="end" class="chart-axis-label" style="fill:var(--text);font-weight:700"><tspan x="'+(leftX - 8)+'" dy="-6">Flagged papers</tspan><tspan x="'+(leftX - 8)+'" dy="13">('+totalValue+')</tspan></text></g>'+rects+'</g>';
      }

      function renderDailyChart(dailySeries) {
        var container = document.getElementById('weekly-daily-chart');
        if (!container || !dailySeries || !dailySeries.length) return;
        var margin = { top: 24, right: 18, bottom: 52, left: 42 };
        var width = 760;
        var height = 420;
        var innerW = width - margin.left - margin.right;
        var innerH = height - margin.top - margin.bottom;
        var bandW = innerW / dailySeries.length;
        var barW = bandW * 0.56;
        var maxP = Math.max.apply(null, dailySeries.map(function(d){ return d.papers || 0; })) || 1;
        var scaleY = function(v){ return innerH - (v / maxP) * innerH; };
        var ticks = [0,1,2,3,4].map(function(i){ return Math.round(maxP*i/4); });
        var yAxis = ticks.map(function(t){
          var y = scaleY(t);
          return '<g transform="translate(0 '+y+')"><line x1="0" x2="'+innerW+'" y1="0" y2="0" class="chart-grid-line"></line><text x="-10" y="4" text-anchor="end" class="chart-axis-label">'+t+'</text></g>';
        }).join('');
        var bars = dailySeries.map(function(pt, i){
          var total = Math.max(pt.papers||0, 0);
          var flagged = Math.max(Math.min(pt.flagged||0, total), 0);
          var other = total - flagged;
          var x = i * bandW + (bandW - barW) / 2;
          var tH = total > 0 ? (total / maxP) * innerH : 0;
          var fH = total > 0 ? tH * (flagged / total) : 0;
          var oH = Math.max(tH-fH, 0);
          var yTop = innerH - tH;
          var d = new Date(pt.date+'T12:00:00');
          var wd = d.toLocaleDateString(undefined, { weekday:'short' });
          var ds = pt.date.slice(5);
          var s = '<g transform="translate('+x+' 0)">';
          if (oH > 0) s += '<path d="'+roundedTopRectPath(0, yTop, barW, oH, 5)+'" fill="rgba(32, 22, 19, 0.18)"></path>';
          if (fH > 0) s += '<path d="'+roundedBottomRectPath(0, yTop+oH, barW, fH, 5)+'" fill="#0f6c5d"></path>';
          if (oH > 14) s += '<text x="'+(barW/2)+'" y="'+(yTop+oH/2+4)+'" text-anchor="middle" class="chart-value">'+other+'</text>';
          if (fH > 14) s += '<text x="'+(barW/2)+'" y="'+(yTop+oH+fH/2+4)+'" text-anchor="middle" class="chart-value" style="fill:#fff">'+flagged+'</text>';
          s += '<text x="'+(barW/2)+'" y="'+(innerH+16)+'" text-anchor="middle" class="chart-label">'+wd+'</text>';
          s += '<text x="'+(barW/2)+'" y="'+(innerH+30)+'" text-anchor="middle" class="chart-label chart-label-subtle">'+ds+'</text>';
          s += '</g>';
          return s;
        }).join('');
        container.innerHTML = '<svg class="chart-svg" style="height:auto" width="100%" viewBox="0 0 '+width+' '+height+'" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Daily submission activity stacked bar chart"><g transform="translate('+margin.left+' '+margin.top+')"><line x1="0" x2="'+innerW+'" y1="'+innerH+'" y2="'+innerH+'" class="chart-grid-line"></line>'+yAxis+bars+'</g></svg>';
      }

      function renderClassPie(classCounts) {
        var container = document.getElementById('weekly-class-pie-container');
        if (!container || !classCounts || !classCounts.length) return;
        var cx = 228, cy = 110, r = 66, innerR = 36;
        var classMap = {};
        classCounts.forEach(function(cc){ classMap[cc.class_id] = cc.count; });
        var total = Math.max(1, Object.keys(classMap).reduce(function(s, key){ return s + (classMap[key] || 0); }, 0));
        var classColors = ['#cfe8f3','#a2d4ec','#73bfe2','#46abdb','#1696d2','#12719e'];
        var segments = CLASS_LABELS_JS.map(function(label, classId) {
          return { label: label, classId: classId, value: classMap[classId] || 0, color: classColors[classId] };
        }).filter(function(item) { return item.value > 0; }).sort(function(a, b) { return b.value - a.value || a.classId - b.classId; });
        var slices = buildPieSlices(segments, cx, cy, 66, -Math.PI / 2, 30);
        container.innerHTML = '<svg class="chart-svg coverage-pie-svg" width="100%" height="220" viewBox="0 0 460 220" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Pie chart of resource class breakdown"><g>' + slices.map(function(slice) {
          return '<g><path d="'+slice.path+'" fill="'+slice.color+'" stroke="white" stroke-width="1.5"></path><path d="'+slice.calloutPath+'" fill="none" stroke="var(--text)" stroke-dasharray="3 4" stroke-width="1"></path><text x="'+(slice.labelX + (slice.side === 'right' ? 8 : -8))+'" y="'+(slice.labelY + 4)+'" text-anchor="'+(slice.side === 'right' ? 'start' : 'end')+'" class="chart-axis-label" style="fill:var(--text);font-weight:700">'+slice.label+' ('+slice.value+')</text></g>';
        }).join('') + '<circle cx="228" cy="110" r="36" fill="var(--panel)" stroke="var(--line)"></circle><text x="228" y="104" text-anchor="middle" class="chart-value">'+total+'</text><text x="228" y="119" text-anchor="middle" class="chart-axis-label">classified</text></g></svg>';
      }

      function renderLangFreqChart(languageCounts) {
        var container = document.getElementById('weekly-lang-freq');
        languageCounts = (languageCounts || []).filter(function(item) { return item.count > 0; });
        if (!container || !languageCounts.length) return;
        var rowH = 28, margin = { top: 18, right: 24, bottom: 20, left: 210 };
        var width = 920;
        var innerW = width - margin.left - margin.right;
        var innerH = languageCounts.length * rowH;
        var totalH = innerH + margin.top + margin.bottom;
        var maxC = Math.max(1, ...languageCounts.map(function(item) { return item.count || 0; }));
        var totalC = languageCounts.reduce(function(s,lc){ return s+lc.count; }, 0);
        var bars = languageCounts.map(function(lc, i){
          var bW = (lc.count/maxC)*innerW;
          var y = i * rowH;
          var pct = ((lc.count/totalC)*100).toFixed(1)+'%';
          var inside = bW > innerW - 100;
          var barColor = classColorForLanguage(lc.language);
          return '<g transform="translate(0 '+y+')"><text x="-12" y="16" text-anchor="end" class="h-bar-label h-bar-label-name">'+lc.language+'</text><rect x="0" y="3" width="'+bW+'" height="18" rx="4" fill="'+barColor+'" fill-opacity="0.86"></rect>'+
                 (inside ? '<text x="'+(bW-6)+'" y="16" text-anchor="end" class="h-bar-label h-bar-label-count" style="fill:#fff">'+lc.count+' ('+pct+')</text>' : '<text x="'+(bW+8)+'" y="16" text-anchor="start" class="h-bar-label h-bar-label-count">'+lc.count+' ('+pct+')</text>') + '</g>';
        }).join('');
        container.innerHTML = '<svg class="chart-svg" style="height:auto" width="100%" viewBox="0 0 920 '+totalH+'" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Full language frequency horizontal bar chart"><g transform="translate('+margin.left+' '+margin.top+')">'+bars+'</g></svg>';
      }

      function renderWeekCharts(weekData) {
        renderCoveragePie(weekData.papers, weekData.flaggedPapers);
        renderSourceBreakdown(weekData.coverageStats, weekData.flaggedPapers);
        renderDailyChart(weekData.dailySeries || []);
        renderClassPie(weekData.classCounts || []);
        renderLangFreqChart(weekData.languageCounts || []);
      }

      // --- Week switcher ---
      var weekSelect = document.getElementById('period-stats-week-select');
      if (weekSelect) {
        periodData.slice().reverse().forEach(function(w) {
          var opt = document.createElement('option');
          opt.value = w.weekStart;
          opt.textContent = fmtPeriodWeekLabel(w.weekStart);
          if (w.weekStart === anchorSlug) opt.selected = true;
          weekSelect.appendChild(opt);
        });
        weekSelect.addEventListener('change', function() {
          var sel = allWeeksMeta.find(function(w) { return w.weekStart === weekSelect.value; });
          if (!sel) return;
          var pEl = document.getElementById('stat-total-papers');
          var fEl = document.getElementById('stat-flagged-papers');
          var uEl = document.getElementById('stat-unique-langs');
          var tEl = document.getElementById('weekly-stat-title');
          if (pEl) pEl.textContent = sel.papers;
          if (fEl) fEl.textContent = sel.flaggedPapers;
          if (uEl) uEl.textContent = sel.uniqueLanguages;
          if (tEl) tEl.textContent = 'For ' + fmtPeriodWeekLabel(weekSelect.value);
          renderWeekCharts(sel);
        });
      }

      // Period stat summary
      var totalPapers = periodData.reduce(function(s, w) { return s + w.papers; }, 0);
      var totalFlagged = periodData.reduce(function(s, w) { return s + w.flaggedPapers; }, 0);
      // .count means "studied" here (remapped server-side) — a language with
      // count 0 was only ever mentioned_only in this window, so it shouldn't
      // inflate the unique-languages-studied total.
      var allLangSet = new Set();
      periodData.forEach(function(w) { (w.languageCounts || []).forEach(function(lc) { if (lc.language && lc.count > 0) allLangSet.add(lc.language); }); });

      var ptitleEl = document.getElementById('period-trend-title');
      if (ptitleEl) ptitleEl.textContent = 'Period trends: ' + fmtShortLabel(fromParam) + '–' + fmtShortLabel(anchorSlug);
      var ppEl = document.getElementById('period-stat-papers'); if (ppEl) ppEl.textContent = totalPapers;
      var pfEl = document.getElementById('period-stat-flagged'); if (pfEl) pfEl.textContent = totalFlagged;
      var puEl = document.getElementById('period-stat-unique'); if (puEl) puEl.textContent = allLangSet.size;

      function buildLinePath(points) {
        return points.map(function(point, index) {
          return (index === 0 ? 'M' : 'L') + point.x + ',' + point.y;
        }).join(' ');
      }

      // Rank-trajectory class filter state, shared across re-renders.
      var rankClassFilter = 'all';
      var lastRankPeriods = null;

      function renderPeriodTrendCharts(selectedPeriodData) {
        if (!selectedPeriodData || !selectedPeriodData.length) return;

        var periods = selectedPeriodData.map(function(week) {
          return {
            weekStart: week.weekStart,
            label: fmtShortLabel(week.weekStart),
            papers: week.papers || 0,
            flaggedPapers: week.flaggedPapers || 0,
            uniqueLanguages: week.uniqueLanguages || 0,
            languageCounts: week.languageCounts || [],
            classCounts: week.classCounts || [],
          };
        });

        var totalPapersInPeriod = periods.reduce(function(sum, period) { return sum + period.papers; }, 0);
        var totalFlaggedInPeriod = periods.reduce(function(sum, period) { return sum + period.flaggedPapers; }, 0);
        // .count means "studied" here (remapped server-side) — exclude
        // languages that were only ever mentioned_only in this window.
        var uniqueLanguageSet = new Set();
        periods.forEach(function(period) {
          period.languageCounts.forEach(function(item) { if (item.language && item.count > 0) uniqueLanguageSet.add(item.language); });
        });

        function coverageSliceLines(label, value) {
          if (label === 'Papers with detected languages') {
            return ['Papers with', 'detected languages (' + value + ')'];
          }
          return [label + ' (' + value + ')'];
        }

        var coverageSlices = buildPieSlices([
          { label: 'Not detected', value: Math.max(totalPapersInPeriod - totalFlaggedInPeriod, 0), color: 'rgba(32, 22, 19, 0.16)' },
          { label: 'Papers with detected languages', value: totalFlaggedInPeriod, color: '#0f6c5d' },
        ].sort(function(left, right) { return right.value - left.value; }), 260, 130, 82, -Math.PI / 2, 36);
        var coverageSvg = '<g>' + coverageSlices.map(function(slice) {
          var labelX = slice.labelX + (slice.side === 'right' ? 8 : -8);
          var anchor = slice.side === 'right' ? 'start' : 'end';
          var percent = totalPapersInPeriod > 0 ? ((slice.value / totalPapersInPeriod) * 100).toFixed(1) + '%' : '0.0%';
          return '<g><path d="' + slice.path + '" fill="' + slice.color + '" stroke="white" stroke-width="1.5"></path>' +
            '<path d="' + slice.calloutPath + '" fill="none" stroke="var(--text)" stroke-dasharray="3 4" stroke-width="1"></path>' +
            '<text x="' + (260 + Math.cos(slice.midAngle) * 60) + '" y="' + (130 + Math.sin(slice.midAngle) * 60 + 4) + '" text-anchor="middle" class="chart-value" style="fill:' + (slice.label === 'Not detected' ? 'var(--text)' : '#fff') + ';font-size:0.6rem;font-weight:800">' + percent + '</text>' +
            '<text x="' + labelX + '" y="' + (slice.labelY + 4) + '" text-anchor="' + anchor + '" class="chart-axis-label">' + coverageSliceLines(slice.label, slice.value).map(function(line, index) { return '<tspan x="' + labelX + '" dy="' + (index === 0 ? 0 : 14) + '">' + line + '</tspan>'; }).join('') + '</text></g>';
        }).join('') + '<circle cx="260" cy="130" r="44" fill="var(--panel)" stroke="var(--line)"></circle><text x="260" y="122" text-anchor="middle" class="chart-value"><tspan x="260" dy="0">' + totalPapersInPeriod + '</tspan><tspan x="260" dy="14" class="chart-axis-label">papers</tspan></text></g>';
        var coverageSvgEl = document.getElementById('period-coverage-pie');
        if (coverageSvgEl) coverageSvgEl.innerHTML = coverageSvg;

        var scanContainer = document.getElementById('period-scan-volume');
        if (scanContainer) {
          var scanMargin = { top: 24, right: 44, bottom: 50, left: 42 };
          var scanHeight = 260;
          var scanWidth = chartWidthForPeriods(760, scanMargin, periods.length, 5);
          var scanInnerW = scanWidth - scanMargin.left - scanMargin.right;
          var scanInnerH = scanHeight - scanMargin.top - scanMargin.bottom;
          var bandW = scanInnerW / periods.length;
          var barW = bandW * 0.56;
          var maxP = Math.max.apply(null, periods.map(function(period) { return period.papers; })) || 1;
          var yAxis = [0, 1, 2, 3, 4].map(function(i) {
            var tick = Math.round(maxP * i / 4);
            var y = scanInnerH - (tick / maxP) * scanInnerH;
            return '<g transform="translate(0 ' + y + ')"><line x1="0" x2="' + scanInnerW + '" y1="0" y2="0" class="chart-grid-line"></line><text x="-10" y="4" text-anchor="end" class="chart-axis-label">' + tick + '</text></g>';
          }).join('');
          var bars = periods.map(function(period, index) {
            var x = index * bandW + (bandW - barW) / 2;
            var totalHeight = (period.papers / maxP) * scanInnerH;
            var flaggedHeight = (period.flaggedPapers / maxP) * scanInnerH;
            var otherHeight = Math.max(totalHeight - flaggedHeight, 0);
            var yTop = scanInnerH - totalHeight;
            var otherCount = Math.max(period.papers - period.flaggedPapers, 0);
            var svg = '';
            if (otherHeight > 0) svg += '<path d="' + roundedTopRectPath(x, yTop, barW, otherHeight, 5) + '" fill="rgba(32, 22, 19, 0.18)"></path>';
            if (flaggedHeight > 0) svg += '<path d="' + roundedBottomRectPath(x, scanInnerH - flaggedHeight, barW, flaggedHeight, 5) + '" fill="#0f6c5d"></path>';
            if (otherHeight > 14) svg += '<text x="' + (x + barW / 2) + '" y="' + (yTop + otherHeight / 2 + 4) + '" text-anchor="middle" class="chart-value">' + otherCount + '</text>';
            if (flaggedHeight > 14) svg += '<text x="' + (x + barW / 2) + '" y="' + (scanInnerH - flaggedHeight / 2 + 4) + '" text-anchor="middle" class="chart-value" style="fill:#fff">' + period.flaggedPapers + '</text>';
            svg += '<text x="' + (x + barW / 2) + '" y="' + (scanInnerH + 18) + '" text-anchor="middle" class="chart-label">' + period.label + '</text>';
            return svg;
          }).join('');
          var scanIsScrollable = scanWidth !== 760;
          scanContainer.classList.toggle('chart-scroll-frozen', scanIsScrollable);
          var scanOverlay = scanIsScrollable ? axisOverlaySvg(scanMargin.left, scanMargin.top, scanHeight, [0, 1, 2, 3, 4].map(function(i) {
            var tick = Math.round(maxP * i / 4);
            return { y: scanInnerH - (tick / maxP) * scanInnerH, label: tick };
          })) : '';
          scanContainer.innerHTML = scanOverlay + '<svg class="chart-svg"' + (scanWidth !== 760 ? ' style="width:' + scanWidth + 'px;max-width:none"' : ' width="100%"') + ' viewBox="0 0 ' + scanWidth + ' ' + scanHeight + '" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Stacked bar chart of selected period scan volume"><g transform="translate(' + scanMargin.left + ' ' + scanMargin.top + ')"><line x1="0" x2="' + scanInnerW + '" y1="' + scanInnerH + '" y2="' + scanInnerH + '" class="chart-grid-line"></line>' + yAxis + bars + '</g></svg>';
        }

        var classLegend = document.getElementById('period-class-legend');
        if (classLegend) {
          classLegend.innerHTML = CLASS_LABELS_JS.map(function(label, classId) {
            return '<div class="class-legend-item"><span class="trend-legend-swatch" style="background:' + CLASS_COLORS_JS[classId] + '"></span><span>' + label + (classId === 0 ? ' (lowest)' : classId === CLASS_LABELS_JS.length - 1 ? ' (highest)' : '') + '</span></div>';
          }).join('');
        }

        var classContainer = document.getElementById('period-class-mix');
        if (classContainer) {
          var classHeight = 380;
          var classMargin = { top: 20, right: 18, bottom: 56, left: 42 };
          var classWidth = chartWidthForPeriods(700, classMargin, periods.length, 5);
          var classInnerW = classWidth - classMargin.left - classMargin.right;
          var classInnerH = classHeight - classMargin.top - classMargin.bottom;
          var classScale = classInnerW / periods.length;
          var classRows = periods.map(function(period) {
            var classMap = new Map(period.classCounts.map(function(item) { return [item.class_id, item.studied ?? item.count]; }));
            var total = Math.max(1, CLASS_LABELS_JS.reduce(function(sum, _label, classId) { return sum + (classMap.get(classId) || 0); }, 0));
            var offset = 0;
            return CLASS_LABELS_JS.map(function(label, classId) {
              var count = classMap.get(classId) || 0;
              var percentage = count / total;
              var height = classInnerH * percentage;
              var segment = { classId: classId, label: label, count: count, y: classInnerH - offset - height, height: height, color: CLASS_COLORS_JS[classId] };
              offset += height;
              return segment;
            });
          });
          var classSvg = periods.map(function(period, index) {
            var x = index * classScale;
            var barWidth = classScale * 0.55;
            var segments = classRows[index];
            return '<g><g transform="translate(' + (x + (classScale - barWidth) / 2) + ' 0)">' + segments.map(function(segment) {
              return '<rect x="0" y="' + segment.y + '" width="' + barWidth + '" height="' + Math.max(segment.height, 0) + '" fill="' + segment.color + '"><title>' + segment.label + ': ' + segment.count + '</title></rect>';
            }).join('') + '<text x="' + (barWidth / 2) + '" y="' + (classInnerH + 18) + '" text-anchor="middle" class="chart-label">' + period.label + '</text></g></g>';
          }).join('');
          classContainer.innerHTML = '<svg class="chart-svg"' + (classWidth !== 700 ? ' style="width:' + classWidth + 'px;max-width:none"' : ' width="100%"') + ' viewBox="0 0 ' + classWidth + ' ' + classHeight + '" preserveAspectRatio="xMinYMin meet" role="img" aria-label="100 percent stacked bar chart of resource class mix by week"><g transform="translate(' + classMargin.left + ' ' + classMargin.top + ')">' + classSvg + '</g></svg>';
        }

        var uniqueContainer = document.getElementById('period-unique-languages');
        if (uniqueContainer) {
          var uniqueHeight = 440;
          var uniqueMargin = { top: 28, right: 18, bottom: 64, left: 42 };
          var uniqueWidth = chartWidthForPeriods(700, uniqueMargin, periods.length, 5);
          var uniqueInnerW = uniqueWidth - uniqueMargin.left - uniqueMargin.right;
          var uniqueInnerH = uniqueHeight - uniqueMargin.top - uniqueMargin.bottom;
          var uniqueBand = uniqueInnerW / periods.length;
          var uniqueRawMax = Math.max.apply(null, periods.map(function(period) { return period.uniqueLanguages; })) || 1;
          var uniqueYInset = 8;
          var uniqueTickStep = Math.pow(10, Math.floor(Math.log10(Math.max(uniqueRawMax / 4, 1))));
          var uniqueMax = Math.ceil(uniqueRawMax / uniqueTickStep) * uniqueTickStep + uniqueTickStep;
          var uniqueY = function(v) { return uniqueInnerH - uniqueYInset - (v / uniqueMax) * (uniqueInnerH - uniqueYInset * 2); };
          var uniqueLabelY = function(y) { return Math.max(12, Math.min(y - 10, uniqueInnerH - 12)); };
          var uniqueTicks = [0, 1, 2, 3, 4].map(function(i) { return Math.round(uniqueMax * i / 4); });
          var uniqueAxis = uniqueTicks.map(function(tick) {
            var y = uniqueY(tick);
            return '<g transform="translate(0 ' + y + ')"><line x1="0" x2="' + uniqueInnerW + '" y1="0" y2="0" class="chart-grid-line"></line><text x="-10" y="4" text-anchor="end" class="chart-axis-label">' + tick + '</text></g>';
          }).join('');
          var uniquePts = periods.map(function(period, index) {
            return { x: index * uniqueBand + uniqueBand / 2, y: uniqueY(period.uniqueLanguages), label: period.label, val: period.uniqueLanguages };
          });
          var uniqueLine = buildLinePath(uniquePts);
          var uniqueDots = uniquePts.map(function(point) {
            return '<circle cx="' + point.x + '" cy="' + point.y + '" r="5" fill="#7c3aed" stroke="white" stroke-width="2"></circle><text x="' + point.x + '" y="' + uniqueLabelY(point.y) + '" text-anchor="middle" class="chart-value">' + point.val + '</text><text x="' + point.x + '" y="' + (uniqueInnerH + 18) + '" text-anchor="middle" class="chart-label">' + point.label + '</text>';
          }).join('');
          var uniqueIsScrollable = uniqueWidth !== 700;
          uniqueContainer.classList.toggle('chart-scroll-frozen', uniqueIsScrollable);
          var uniqueOverlay = uniqueIsScrollable ? axisOverlaySvg(uniqueMargin.left, uniqueMargin.top, uniqueHeight, uniqueTicks.map(function(tick) {
            return { y: uniqueY(tick), label: tick };
          })) : '';
          uniqueContainer.innerHTML = uniqueOverlay + '<svg class="chart-svg"' + (uniqueWidth !== 700 ? ' style="width:' + uniqueWidth + 'px;max-width:none"' : ' width="100%"') + ' viewBox="0 0 ' + uniqueWidth + ' ' + uniqueHeight + '" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Line chart of unique languages per selected period"><g transform="translate(' + uniqueMargin.left + ' ' + uniqueMargin.top + ')">' + uniqueAxis + '<path d="' + uniqueLine + '" fill="none" stroke="#7c3aed" stroke-width="2.5" stroke-linejoin="round"></path>' + uniqueDots + '</g></svg>';
        }

        var langTotals = new Map();
        periods.forEach(function(period) {
          period.languageCounts.forEach(function(item) {
            if (!item.language) return;
            langTotals.set(item.language, (langTotals.get(item.language) || 0) + item.count);
          });
        });
        var topLanguages = [...langTotals.entries()]
          .filter(function(entry) { return entry[1] > 0; })
          .sort(function(left, right) {
            var d = right[1] - left[1];
            return d !== 0 ? d : left[0].localeCompare(right[0]);
          })
          .slice(0, 10)
          .map(function(entry, index) {
            return { language: entry[0], count: entry[1], color: TREND_LINE_COLORS_JS[index] || CLASS_COLORS_JS[index % CLASS_COLORS_JS.length] };
          });

        var topTrendsContainer = document.getElementById('period-top-language-trends');
        if (topTrendsContainer && topLanguages.length) {
          var trendHeight = 500;
          var trendMargin = { top: 28, right: 124, bottom: 130, left: 42 };
          var trendWidth = chartWidthForPeriods(760, trendMargin, periods.length, 5);
          var trendInnerW = trendWidth - trendMargin.left - trendMargin.right;
          var trendInnerH = trendHeight - trendMargin.top - trendMargin.bottom;
          var trendBand = trendInnerW / periods.length;
          var trendRawMax = Math.max(1, ...topLanguages.flatMap(function(item) {
            return periods.map(function(period) {
              var found = period.languageCounts.find(function(lang) { return lang.language === item.language; });
              return found ? found.count : 0;
            });
          }));
          var trendTickStep = Math.pow(10, Math.floor(Math.log10(Math.max(trendRawMax / 5, 1))));
          var trendMax = Math.ceil(trendRawMax / trendTickStep) * trendTickStep + trendTickStep;
          var trendY = function(v) { return trendInnerH - (v / trendMax) * trendInnerH; };
          var trendSeries = topLanguages.map(function(item) {
            var points = periods.map(function(period, index) {
              var found = period.languageCounts.find(function(lang) { return lang.language === item.language; });
              return { x: index * trendBand + trendBand / 2, y: trendY(found ? found.count : 0), value: found ? found.count : 0 };
            });
            return { language: item.language, color: item.color, points: points, path: buildLinePath(points) };
          });
          var trendEndpointRaw = trendSeries.map(function(series, idx) {
            var lastPt = series.points[series.points.length - 1];
            return { idx: idx, naturalY: lastPt ? lastPt.y : 0 };
          }).sort(function(a, b) { return a.naturalY - b.naturalY; });
          var trendEndpointLabelY = new Array(trendSeries.length).fill(0);
          var trendPrevEndpointY = -Infinity;
          trendEndpointRaw.forEach(function(item) {
            var y = Math.max(item.naturalY, trendPrevEndpointY + 14);
            trendEndpointLabelY[item.idx] = y;
            trendPrevEndpointY = y;
          });
          var trendAxisTicks = [0, 1, 2, 3, 4, 5].map(function(i) { return Math.round(trendMax * i / 5); });
          var trendAxis = trendAxisTicks.map(function(tick) {
            var y = trendY(tick);
            return '<g transform="translate(0 ' + y + ')"><line x1="0" x2="' + trendInnerW + '" y1="0" y2="0" class="chart-grid-line"></line><text x="-10" y="4" text-anchor="end" class="chart-axis-label">' + tick + '</text></g>';
          }).join('');
          var trendSvg = trendSeries.map(function(series, index) {
            var lastPt = series.points[series.points.length - 1];
            var labelY = trendEndpointLabelY[index];
            return '<g class="trend-series" data-lang="' + String(series.language).replace(/"/g, '&quot;') + '">' +
              '<path class="trend-hit" d="' + series.path + '" fill="none" stroke="transparent" stroke-width="14"></path>' +
              '<path class="trend-line" d="' + series.path + '" fill="none" stroke="' + series.color + '" stroke-width="2.5"></path>' +
              (lastPt && lastPt.value > 0 ? '<g><path d="M ' + (lastPt.x + 14) + ' ' + lastPt.y + ' L ' + (trendInnerW + 10) + ' ' + labelY + '" fill="none" stroke="' + series.color + '" stroke-dasharray="3 4" stroke-width="1"></path><text x="' + (trendInnerW + 14) + '" y="' + (labelY + 4) + '" class="chart-axis-label trend-line-label" style="fill:' + series.color + ';font-weight:700">' + series.language + ' · ' + lastPt.value + '</text></g>' : '') +
              series.points.map(function(point) { return '<path d="' + markerPathJs(index, point.x, point.y, 4) + '" fill="' + series.color + '" stroke="white" stroke-width="1.2"></path>'; }).join('') +
              '</g>';
          }).join('');
          var trendIsScrollable = trendWidth !== 760;
          var trendOverlay = trendIsScrollable ? axisOverlaySvg(trendMargin.left, trendMargin.top, trendHeight, trendAxisTicks.map(function(tick) {
            return { y: trendY(tick), label: tick };
          })) : '';
          topTrendsContainer.innerHTML = '<div class="chart-scroll trend-period-chart-scroll' + (trendIsScrollable ? ' chart-scroll-frozen' : '') + '">' + trendOverlay + '<svg class="chart-svg trend-line-svg"' + (trendWidth !== 760 ? ' style="width:' + trendWidth + 'px;max-width:none"' : ' width="100%"') + (trendWidth !== 760 ? ' height="' + trendHeight + '"' : '') + ' viewBox="0 0 ' + trendWidth + ' ' + trendHeight + '" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Line chart of top-language trends across selected period"><g transform="translate(' + trendMargin.left + ' ' + trendMargin.top + ')">' + trendAxis + trendSvg + periods.map(function(period) { return '<text x="' + ((periods.indexOf(period) * trendBand) + trendBand / 2) + '" y="' + (trendInnerH + 18) + '" text-anchor="middle" class="chart-label">' + period.label + '</text>'; }).join('') + '</g></svg></div>';
        }

        lastRankPeriods = periods;
        renderRankTrajectory(document.getElementById('period-rank-trajectory'), document.getElementById('period-rank-most-improved'), periods, rankClassFilter);

        requestAnimationFrame(function() { scrollChartsToEnd(document.getElementById('period-trends-panel')); });
      }

      // Rank trajectory (bump) chart — re-rendered on demand so the resource-class
      // filter can re-rank languages *within* a tier without a page reload. When a
      // class is selected, only that tier's studied languages are ranked (rank 1 =
      // most studied in the tier), the rank axis shrinks to how many languages the
      // tier actually has (never padding empty rows), and the "most improved"
      // callout is scoped to that tier. This is the low-resource lens: a language
      // that never cracks the overall top 10 can still lead its own class.
      function renderRankTrajectory(rankContainer, improvedEl, periods, classFilter) {
        if (!rankContainer) return;
        if (!periods || periods.length < 2) {
          rankContainer.innerHTML = '<p class="placeholder-text">Language rank trajectory will appear once multiple periods are available.</p>';
          if (improvedEl) improvedEl.innerHTML = '';
          return;
        }

        var classFilterNum = (classFilter == null || classFilter === 'all') ? null : Number(classFilter);
        function passesClass(language) { return classFilterNum === null || classIndexForLanguage(language) === classFilterNum; }

        // Overall studied totals across the window — used only to order the
        // margin labels stably (most-studied first), independent of the filter.
        var langTotals = new Map();
        periods.forEach(function(period) {
          period.languageCounts.forEach(function(item) {
            if (!item.language) return;
            langTotals.set(item.language, (langTotals.get(item.language) || 0) + item.count);
          });
        });

        // Studied languages passing the class filter, ranked per period.
        var perPeriodRanked = periods.map(function(period) {
          return [...period.languageCounts]
            // Exclude languages that were only ever mentioned_only this week —
            // the bump chart ranks studied activity, not raw mentions.
            .filter(function(item) { return item.count > 0 && passesClass(item.language); })
            .sort(function(left, right) { return right.count - left.count || left.language.localeCompare(right.language); });
        });
        var maxAvailable = perPeriodRanked.reduce(function(m, list) { return Math.max(m, list.length); }, 0);
        if (maxAvailable === 0) {
          rankContainer.innerHTML = '<p class="placeholder-text">No ' + (classFilterNum === null ? '' : 'Class ' + classFilterNum + ' ') + 'languages were studied in this period.</p>';
          if (improvedEl) improvedEl.innerHTML = '';
          return;
        }

        // Cap at top 10, but shrink the axis to the tier's real size so a
        // sparse class never draws empty rank rows (misleading whitespace).
        var bumpMaxRank = Math.min(10, maxAvailable);
        var bumpRowGap = 50;
        // top margin leaves room for a mid-entry label sitting above a rank-1
        // node (node top −14, label baseline −19, ascent ~9 ⇒ needs ~32px).
        var bumpMargin = { top: 36, right: 230, bottom: 84, left: 200 };
        var bumpInnerH = Math.max(1, bumpMaxRank - 1) * bumpRowGap;
        var bumpHeight = bumpInnerH + bumpMargin.top + bumpMargin.bottom;
        var bumpWidth = chartWidthForPeriods(960, bumpMargin, periods.length, 5);
        var bumpInnerW = bumpWidth - bumpMargin.left - bumpMargin.right;
        var bumpBand = bumpInnerW / periods.length;
        var bumpRowSpacing = bumpRowGap;
        var bumpY = function(rank) { return (rank - 1) * bumpRowSpacing; };
        var bumpPeriods = periods.map(function(period, index) {
          var rankedLanguages = perPeriodRanked[index]
            .slice(0, bumpMaxRank)
            .map(function(item, rankIndex) {
              return { x: index * bumpBand + bumpBand / 2, y: bumpY(rankIndex + 1), rank: rankIndex + 1, language: item.language, count: item.count };
            });
          return { label: period.label, rankedLanguages: rankedLanguages, rankMap: new Map(rankedLanguages.map(function(item) { return [item.language, item]; })) };
        });

        // Per-language weekly studied-count series (0 where absent), across every
        // studied language in the tier — not just the top 10 that week — so the
        // "fastest rising" stat below reflects a language's real trajectory even
        // in weeks it sat just outside the visible ranks.
        var weeklyCounts = new Map();
        perPeriodRanked.forEach(function(list, weekIdx) {
          list.forEach(function(item) {
            var arr = weeklyCounts.get(item.language);
            if (!arr) { arr = new Array(periods.length).fill(0); weeklyCounts.set(item.language, arr); }
            arr[weekIdx] = item.count;
          });
        });
        {
          var bumpLanguageList = [...new Set(bumpPeriods.flatMap(function(item) { return item.rankedLanguages.map(function(lang) { return lang.language; }); }))].sort(function(left, right) {
            var leftTotal = langTotals.get(left) || 0;
            var rightTotal = langTotals.get(right) || 0;
            return rightTotal - leftTotal || left.localeCompare(right);
          });
          updateRankStats(improvedEl, weeklyCounts, periods.length, periods[0].label, periods[periods.length - 1].label, classFilterNum);
          var bumpSeriesData = bumpLanguageList.map(function(language, seriesIdx) {
            var points = bumpPeriods.map(function(period) { return period.rankMap.get(language) ?? null; });
            var segments = [];
            var previousPoint = null;
            for (var i = 0; i < points.length; i++) {
              var point = points[i];
              if (!point) { previousPoint = null; continue; }
              if (previousPoint) {
                segments.push({ d: buildBumpSegmentPath(previousPoint, point), color: BUMP_RANK_COLORS_JS[previousPoint.rank - 1] || BUMP_RANK_COLORS_JS[BUMP_RANK_COLORS_JS.length - 1] });
              }
              previousPoint = point;
            }
            var firstIdx = points.findIndex(function(point) { return point !== null; });
            var lastIdx = points.length - 1 - [...points].reverse().findIndex(function(point) { return point !== null; });
            var firstPt = firstIdx === -1 ? null : points[firstIdx];
            var lastPt = firstIdx === -1 ? null : points[lastIdx];
            var firstIsEdge = firstIdx === 0;
            var lastIsEdge = lastIdx === points.length - 1;
            var labelColor = TREND_LINE_COLORS_JS[seriesIdx] || CLASS_COLORS_JS[seriesIdx % CLASS_COLORS_JS.length];
            return { language: language, points: points, segments: segments, firstPt: firstPt, lastPt: lastPt, firstIsEdge: firstIsEdge, lastIsEdge: lastIsEdge, labelColor: labelColor };
          });
          var bumpAxis = Array.from({ length: bumpMaxRank }, function(_, i) { return i + 1; }).map(function(rank) {
            return '<line x1="0" x2="' + bumpInnerW + '" y1="' + bumpY(rank) + '" y2="' + bumpY(rank) + '" class="chart-grid-line"></line>';
          }).join('');
          var bumpPoints = bumpPeriods.map(function(period, index) {
            return '<text x="' + (index * bumpBand + bumpBand / 2) + '" y="' + (bumpInnerH + 34) + '" text-anchor="middle" class="chart-label">' + period.label + '</text>';
          }).join('');
          function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
          // Direct labeling instead of a leader-line tangle: label ONLY the first
          // column's languages on the left and the last column's on the right,
          // each anchored at its own node's row. Those rows are distinct (one
          // language per rank per week), so labels never collide and need no
          // dotted leaders. Every transient mid-window language is identified by
          // hovering its circle (native <title>), and hovering any series
          // highlights its whole path (see .bump-series CSS) — which is how you
          // follow a single language through the tangle without leader lines.
          var bumpNodes = bumpSeriesData.map(function(series) {
            var labelParts = '';
            if (series.firstIsEdge && series.firstPt) {
              labelParts += '<text x="' + (series.firstPt.x - 20) + '" y="' + (series.firstPt.y + 4) + '" text-anchor="end" class="chart-axis-label bump-label">' + esc(series.language) + '</text>';
            }
            if (series.lastIsEdge && series.lastPt) {
              labelParts += '<text x="' + (series.lastPt.x + 20) + '" y="' + (series.lastPt.y + 4) + '" text-anchor="start" class="chart-axis-label bump-label">' + esc(series.language) + '</text>';
            }
            // Languages that neither open in the first column nor survive to the
            // last are invisible to the margin labels. Label each one right where
            // it ENTERS the top ranks, above its first node — the ~22px inter-row
            // gap has room, and since only one language occupies any (week, rank)
            // cell these scatter across the grid instead of re-stacking. A white
            // halo (see .bump-mid-label) keeps them legible over the lines.
            if (!series.firstIsEdge && !series.lastIsEdge && series.firstPt) {
              labelParts += '<text x="' + series.firstPt.x + '" y="' + (series.firstPt.y - 19) + '" text-anchor="middle" class="bump-mid-label">' + esc(series.language) + '</text>';
            }
            var lineParts = series.segments.map(function(segment) { return '<path class="bump-line" d="' + segment.d + '" fill="none" stroke="' + segment.color + '" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>'; }).join('');
            var nodeParts = series.points.map(function(point, i) {
              if (!point) return '';
              var rankColor = BUMP_RANK_COLORS_JS[point.rank - 1] || BUMP_RANK_COLORS_JS[BUMP_RANK_COLORS_JS.length - 1];
              var textColor = point.rank >= 6 ? '#000' : '#fff';
              var weekLabel = bumpPeriods[i] ? bumpPeriods[i].label : '';
              return '<g class="bump-node"><circle cx="' + point.x + '" cy="' + point.y + '" r="14" fill="' + rankColor + '" stroke="#000" stroke-width="1.5"><title>' + esc(series.language) + ' — rank ' + point.rank + ' · ' + esc(weekLabel) + '</title></circle><text x="' + point.x + '" y="' + (point.y + 5) + '" text-anchor="middle" style="fill:' + textColor + ';font-size:0.65rem;font-weight:700;pointer-events:none">' + point.rank + '</text></g>';
            }).join('');
            return '<g class="bump-series" data-lang="' + esc(series.language) + '">' + lineParts + nodeParts + labelParts + '</g>';
          }).join('');
          rankContainer.innerHTML = '<svg class="chart-svg bump-svg"' + (bumpWidth !== 960 ? ' style="width:' + bumpWidth + 'px;max-width:none"' : ' width="100%"') + ' height="' + bumpHeight + '" viewBox="0 0 ' + bumpWidth + ' ' + bumpHeight + '" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Language rank bump chart across selected period"><g transform="translate(' + bumpMargin.left + ' ' + bumpMargin.top + ')">' + bumpAxis + bumpPoints + bumpNodes + '</g></svg>';
        }

        requestAnimationFrame(function() { rankContainer.scrollLeft = rankContainer.scrollWidth; });
      }

      // Rank-trajectory summary stats. Mirrors computeRankTrajectoryStats /
      // formatEffectiveLanguageCount in web/src/lib/trend-charts.js (unit-tested
      // there) — kept in sync manually rather than imported, matching this
      // block's existing pattern of duplicating the bump-chart helpers for the
      // non-module inline <script> (see buildBumpSegmentPath etc. above).
      //
      // All three stats use "share of studied mentions" (a language's studied
      // count ÷ all studied mentions in the tier), which is volume-robust and
      // measures representation directly — the equity question this project is
      // about — and all three are computed over EVERY studied language in the
      // tier, not just the ones visible in the chart's top-10 cutoff, so a
      // fast-growing or dominant low-resource language can win even if it never
      // cracks the top 10. All three respect the class filter.
      //
      //  • Fastest rising: the language whose share grew the most, comparing its
      //    later-half average vs its earlier-half average (per-week averaged so
      //    uneven halves stay comparable). Deliberately NOT an endpoint rank climb
      //    (usually empty in churny low-resource tiers) nor an absolute-count rise
      //    (confounded by submission volume — when arXiv dips, everything falls).
      //  • Tier leader: the single language holding the largest share across the
      //    whole window — who dominates, as a level to the rising stat's momentum.
      //  • Diversity: the effective number of languages = exp(Shannon entropy) of
      //    the window's share distribution — how many languages the tier studies
      //    if attention were spread evenly (200 studied but 90% on 5 ⇒ ~6).
      function computeRankTrajectoryStatsJs(weeklyCounts, weekCount) {
        var mid = Math.floor(weekCount / 2);
        var firstWeeks = mid;                 // weeks [0, mid)
        var secondWeeks = weekCount - mid;    // weeks [mid, weekCount)
        var weeklyTotals = new Array(weekCount).fill(0);
        weeklyCounts.forEach(function(counts) {
          for (var i = 0; i < weekCount; i++) weeklyTotals[i] += (counts[i] || 0);
        });

        var rising = null;
        weeklyCounts.forEach(function(counts, language) {
          var firstShare = 0, secondShare = 0;
          for (var i = 0; i < weekCount; i++) {
            var share = weeklyTotals[i] > 0 ? (counts[i] || 0) / weeklyTotals[i] : 0;
            if (i < mid) firstShare += share; else secondShare += share;
          }
          var firstAvg = firstWeeks ? firstShare / firstWeeks : 0;
          var secondAvg = secondWeeks ? secondShare / secondWeeks : 0;
          var delta = secondAvg - firstAvg;
          if (delta <= 0) return;
          if (!rising || delta > rising.delta || (delta === rising.delta && secondAvg > rising.secondAvg)) {
            rising = { language: language, delta: delta, firstAvg: firstAvg, secondAvg: secondAvg };
          }
        });

        var totals = new Map();
        var grandTotal = 0;
        weeklyCounts.forEach(function(counts, language) {
          var t = 0;
          for (var i = 0; i < weekCount; i++) t += (counts[i] || 0);
          if (t > 0) { totals.set(language, t); grandTotal += t; }
        });
        var leaderLanguage = null;
        totals.forEach(function(t, language) { if (!leaderLanguage || t > totals.get(leaderLanguage)) leaderLanguage = language; });
        var leader = leaderLanguage ? { language: leaderLanguage, share: grandTotal > 0 ? totals.get(leaderLanguage) / grandTotal : 0 } : null;

        var entropy = 0;
        if (grandTotal > 0) {
          totals.forEach(function(t) { var p = t / grandTotal; if (p > 0) entropy -= p * Math.log(p); });
        }
        var diversityEffective = grandTotal > 0 ? Math.exp(entropy) : 0;

        return { rising: rising, leader: leader, diversityEffective: diversityEffective };
      }

      function formatEffectiveLanguageCountJs(effective) {
        var value = effective >= 10 ? Math.round(effective) : Number(effective.toFixed(1));
        return { value: value, text: String(value), isSingular: value === 1 };
      }

      function updateRankStats(el, weeklyCounts, weekCount, firstLabel, lastLabel, classFilterNum) {
        if (!el) return;
        function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
        function pct(x) { var v = x * 100; return (Number.isInteger(v) ? String(v) : v.toFixed(1)) + '%'; }
        var scope = classFilterNum === null ? '' : ' in Class ' + classFilterNum;

        var stats = computeRankTrajectoryStatsJs(weeklyCounts, weekCount);
        var rising = stats.rising;
        var leader = stats.leader;
        var diversity = formatEffectiveLanguageCountJs(stats.diversityEffective);

        var risingHtml = rising
          ? '<span class="bump-stat"><span class="bump-improved-badge">▲ Fastest rising</span> <strong>' + esc(rising.language) + '</strong> <span class="bump-improved-detail">grew to ' + pct(rising.secondAvg) + ' of studied-language mentions' + scope + ', up from ' + pct(rising.firstAvg) + ' (' + firstLabel + ' → ' + lastLabel + ')</span></span>'
          : '<span class="bump-stat"><span class="bump-improved-badge bump-improved-badge-muted">▲ Fastest rising</span> <span class="bump-improved-detail">No language gained share of attention across ' + firstLabel + ' → ' + lastLabel + scope + '.</span></span>';
        var leaderHtml = leader
          ? '<span class="bump-stat"><span class="bump-improved-badge bump-badge-leader">★ Tier leader</span> <strong>' + esc(leader.language) + '</strong> <span class="bump-improved-detail">' + pct(leader.share) + ' of studied mentions' + scope + '</span></span>'
          : '';
        var diversityHtml = stats.diversityEffective > 0
          ? '<span class="bump-stat"><span class="bump-improved-badge bump-badge-diversity">◇ Diversity</span> <span class="bump-improved-detail">~' + diversity.text + ' effective language' + (diversity.isSingular ? '' : 's') + scope + '</span>'
            + '<span class="lang-chip-popover bump-info-popover"><span class="bump-info-icon" tabindex="0" role="button" aria-label="What does diversity mean?">&#9432;</span>'
            + '<span class="review-popover-body" role="tooltip"><strong>Diversity — effective number of languages</strong><p>The number of <em>equally-common</em> languages that would give the same spread of studied attention (exp of the Shannon entropy of each language\'s share). It equals the raw count when attention is spread evenly across languages, and drops well below it when a few dominate — so higher means broader, more equitable representation.</p></span></span>'
            + '</span>'
          : '';

        el.innerHTML = risingHtml + leaderHtml + diversityHtml;
      }

      renderPeriodTrendCharts(periodData);

      // Resource-class filter chips for the rank trajectory chart.
      var rankChipRow = document.getElementById('period-rank-class-chips');
      if (rankChipRow) {
        rankChipRow.addEventListener('click', function(e) {
          var btn = e.target.closest ? e.target.closest('button[data-rank-class]') : null;
          if (!btn || !rankChipRow.contains(btn)) return;
          rankClassFilter = btn.getAttribute('data-rank-class');
          rankChipRow.querySelectorAll('button[data-rank-class]').forEach(function(b) {
            var active = b === btn;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          if (lastRankPeriods) renderRankTrajectory(document.getElementById('period-rank-trajectory'), document.getElementById('period-rank-most-improved'), lastRankPeriods, rankClassFilter);
        });
      }

      function chartWidthForPeriods(baseWidth, margins, periodCount, maxVisible) {
        if (periodCount <= maxVisible) return baseWidth;
        var baseInner = baseWidth - margins.left - margins.right;
        var pxPerPeriod = baseInner / maxVisible;
        return Math.ceil(periodCount * pxPerPeriod) + margins.left + margins.right;
      }

      // Top 10 languages in period horizontal bar chart
      (function() {
        var container = document.getElementById('period-langs-chart');
        if (!container || !periodData.length) return;
        var langMap = {};
        periodData.forEach(function(w) {
          (w.languageCounts || []).forEach(function(lc) { langMap[lc.language] = (langMap[lc.language] || 0) + lc.count; });
        });
        var sorted = Object.keys(langMap).map(function(lang) { return { language: lang, count: langMap[lang] }; })
          .filter(function(item) { return item.count > 0; })
          .sort(function(a, b) { return b.count - a.count; }).slice(0, 10);
        if (!sorted.length) { container.innerHTML = '<p class="placeholder-text">No language data available.</p>'; return; }
        var maxC = sorted[0].count;
        var totalC = sorted.reduce(function(s, lc) { return s + lc.count; }, 0);
        var rowH = 28, margin = { top: 18, right: 24, bottom: 20, left: 210 };
        var width = 920;
        var innerW = width - margin.left - margin.right;
        var innerH = sorted.length * rowH;
        var totalH = innerH + margin.top + margin.bottom;
        var bars = sorted.map(function(lc, i) {
          var barW = (lc.count / maxC) * innerW;
          var y = i * rowH;
          var pct = ((lc.count / totalC) * 100).toFixed(1) + '%';
          var label = lc.count + ' (' + pct + ')';
          var labelInside = barW > innerW - 100;
          var barColor = classColorForLanguage(lc.language);
          return '<g transform="translate(0 '+y+')"><text x="-12" y="16" text-anchor="end" class="h-bar-label h-bar-label-name">'+lc.language+'</text><rect x="0" y="3" width="'+barW+'" height="18" rx="4" fill="'+barColor+'" fill-opacity="0.86"></rect>'+
                 (labelInside ? '<text x="'+(barW-6)+'" y="16" text-anchor="end" class="h-bar-label h-bar-label-count" style="fill:#fff">'+label+'</text>' : '<text x="'+(barW+8)+'" y="16" text-anchor="start" class="h-bar-label h-bar-label-count">'+label+'</text>') + '</g>';
        }).join('');
        container.innerHTML = '<svg class="chart-svg" width="100%" viewBox="0 0 920 '+totalH+'" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Top languages in selected period"><g transform="translate('+margin.left+' '+margin.top+')">'+bars+'</g></svg>';
      }());

    }());
  </script>
</section>
