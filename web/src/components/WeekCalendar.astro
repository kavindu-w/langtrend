---
const { activeWeek, availableWeeks = [] } = Astro.props as { activeWeek?: string; availableWeeks?: string[] };
---

<div class="calendar-card week-calendar-panel" data-active-week={activeWeek ?? ''} data-available-weeks={JSON.stringify(availableWeeks)} data-base-url={import.meta.env.BASE_URL}>

  <!-- View mode subtitle + tabs -->
  <p class="calendar-mode-label">View papers</p>
  <div class="calendar-mode-tabs" role="tablist" aria-label="View mode">
    <button class="mode-tab" id="mode-week-btn" data-mode="week" role="tab" aria-selected="true">Week</button>
    <button class="mode-tab" id="mode-period-btn" data-mode="period" role="tab" aria-selected="false">Period</button>
    <button class="mode-tab" id="mode-all-btn" data-mode="all" role="tab" aria-selected="false">All papers</button>
  </div>

  <!-- Period From / To selects (period mode only) -->
  <div id="period-controls" class="period-controls" style="display:none">
    <div class="period-endpoint">
      <span class="picker-label">From</span>
      <div class="period-endpoint-selects">
        <select id="from-year-select" class="picker-select picker-select-sm" aria-label="From year"></select>
        <select id="from-month-select" class="picker-select picker-select-md" aria-label="From month"></select>
        <select id="period-from-select" class="picker-select" aria-label="From week"></select>
      </div>
    </div>
    <div class="period-endpoint">
      <span class="picker-label">To</span>
      <div class="period-endpoint-selects">
        <select id="to-year-select" class="picker-select picker-select-sm" aria-label="To year"></select>
        <select id="to-month-select" class="picker-select picker-select-md" aria-label="To month"></select>
        <select id="period-to-select" class="picker-select" aria-label="To week"></select>
      </div>
    </div>
  </div>

  <!-- Year + month calendar jump (week mode only) -->
  <div id="calendar-month-jump-row" class="calendar-month-jump-row" style="display:none">
    <label class="picker-label">Go to</label>
    <select id="calendar-year-jump" class="picker-select picker-select-sm" aria-label="Year"></select>
    <select id="calendar-month-jump" class="picker-select picker-select-md" aria-label="Month"></select>
  </div>

  <!-- Calendar navigation header (hidden in all-papers mode via CSS) -->
  <div class="panel-head compact-head" id="calendar-head">
    <button id="fc-prev" class="week-nav-btn" aria-label="Previous week">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <h2 id="week-title">The Week of May 18–24</h2>
    <button id="fc-next" class="week-nav-btn" aria-label="Next week">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>

  <!-- Calendar widget (hidden in all-time mode via CSS) -->
  <div class="fc-controls" id="calendar-widget">
    <div class="fc-week-wrapper">
      <div id="fc-root" class="fc-root"></div>
    </div>
  </div>

  <p class="placeholder-text small" id="calendar-hint-text">Click a week to view its data. (Note: Data available from April 27, 2026.)</p>
  <script src="../scripts/week-calendar-client.js"></script>
</div>
