---
import { languageBorderClass, languageFillColor, buildLanguageClassLookup } from '../lib/language-colors.js';
import { buildPaperItem, formatSectionTitle } from '../lib/paper-table.js';

type LanguageEntry = string | [string, number] | { language?: string | null; class?: number; name?: string; needs_review?: boolean; flag_reason?: string; sources?: string[]; judge_verdict?: string; judge_reason?: string; judge_model?: string };
type PaperRecord = {
  id?: string;
  title: string;
  titleHtml?: string;
  authors: string[];
  abstract: string;
  abstractHtml?: string;
  pdf_url: string;
  published?: string;
  updated?: string;
  categories?: string[];
};
type SectionRecord = {
  name: string;
  source: string;
  detected_languages: LanguageEntry[];
};
type PaperWarning = {
  step: string;
  acronym?: string;
  language?: string;
  language_class?: number;
  message?: string;
};
type FlaggedPaper = {
  paper: PaperRecord;
  languages: LanguageEntry[];
  sourcesChecked: string[];
  sections: SectionRecord[];
  warnings?: PaperWarning[];
};
type WeekMeta = { weekStart: string; papers: number; flaggedPapers: number; uniqueLanguages: number };

const {
  flaggedPapers,
  languageData,
  availableWeeks = [] as string[],
  currentWeekSlug = '',
  allWeeksMetadata = [] as WeekMeta[],
} = Astro.props as {
  flaggedPapers: FlaggedPaper[];
  languageData?: { lang_classes?: Record<string, unknown[]> };
  availableWeeks?: string[];
  currentWeekSlug?: string;
  allWeeksMetadata?: WeekMeta[];
};

const langClasses = languageData?.lang_classes ?? {};
const pfpMap: Record<string, string> = (languageData as any)?.possible_false_positive_languages ?? {};

// Full taxonomy of ~6k language names (not just ones detected this week) — powers
// the language-search typeahead and lets it tell "0 papers" apart from "not a language".
const allLanguageNames = Object.keys(buildLanguageClassLookup(langClasses)).sort((a, b) => a.localeCompare(b));

type SourceGroup = { src: string; label: string; langs: string[] };
type ChipEntry = { language: string; borderClass: number; needsReview: boolean; flagReason: string; fillColor: string; judgeVerdict: string; judgeReason: string; mentionedOnly: boolean };
type SectionItem = { name: string; label: string; source: string; sourceLabel: string; chips: ChipEntry[] };
type SuppressedChip = { language: string; borderClass: number; acronyms: string[] };
type JudgeSuppressedChip = { language: string; borderClass: number; reason: string; model: string };
type PaperItem = {
  index: number;
  paper: PaperRecord;
  allAuthors: string;
  chips: ChipEntry[];
  chipLanguageNames: string[];
  minClass: number;
  hasPdf: boolean;
  coverageBadge: { label: string; title: string } | null;
  searchText: string;
  sourcesGroups: SourceGroup[];
  sections: SectionItem[];
  pubDateStr: string;
  updDateStr: string;
  showUpdated: boolean;
  arxivUrl: string;
  acronymConflicts: PaperWarning[];
  suppressedChips: SuppressedChip[];
  judgeSuppressedChips: JudgeSuppressedChip[];
  verdicts: string[];
  weekStart: string;
};

// Current week papers first, tracking seen IDs for deduplication
const seenIds = new Set<string>();
const paperItems: PaperItem[] = flaggedPapers.map((item, i) => {
  if (item.paper.id) seenIds.add(item.paper.id);
  return buildPaperItem(item, i, currentWeekSlug, langClasses, pfpMap) as PaperItem;
});

// Language chips — derived from current week only at build time; counts updated in JS for multi-week
const languageCounts = new Map<string, number>();
for (const it of paperItems) {
  for (const chip of it.chips) {
    if (!chip.language) continue;
    languageCounts.set(chip.language, (languageCounts.get(chip.language) || 0) + 1);
  }
}
const languages = [...languageCounts.entries()]
  .sort((l, r) => { const d = r[1] - l[1]; return d !== 0 ? d : l[0].localeCompare(r[0]); })
  .map(([language]) => language);

const verdictCounts = { studied: 0, mentioned_only: 0, false_positive: 0 };
for (const it of paperItems) {
  for (const v of it.verdicts) {
    if (v in verdictCounts) verdictCounts[v as keyof typeof verdictCounts]++;
  }
}
---
<section
  class="panel paper-panel"
  id="paper-table-root"
  data-current-week={currentWeekSlug}
  data-available-weeks={JSON.stringify(availableWeeks)}
  data-weeks-meta={JSON.stringify(allWeeksMetadata)}
  data-base-url={import.meta.env.BASE_URL}
>
  <div class="glossary-note">
    <span class="glossary-note-icon" aria-hidden="true">ⓘ</span>
    <p><strong>How these labels work:</strong> a paper is <strong>flagged</strong> when the pipeline's regex detects a candidate language. Each flagged detection is then judged by an LLM as <strong>studied</strong> (real research use), <strong>mentioned-only</strong> (referenced in passing, not studied), or a <strong>false positive</strong> (not actually that language). By default this list shows studied and mentioned-only papers — together called <strong>detected</strong> — while false positives stay hidden unless you enable them with the Show filter below. The same definitions apply to the Statistics section further down this page.</p>
  </div>
  <div id="active-filters-bar" class="active-filters-bar" style="display:none">
    <button id="clear-filters-btn" class="clear-filters-btn" type="button">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      Clear filters
    </button>
    <span id="active-filter-tags" class="active-filter-tags"></span>
  </div>

  <div class="paper-controls-bar">
    <div class="search-wrapper paper-search-wrapper">
      <svg class="input-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input id="paper-search" class="search-input" type="search" placeholder="Search by title or author" aria-label="Search papers by title or author" />
    </div>
    <div class="search-wrapper lang-search-wrapper">
      <svg class="input-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        id="lang-search"
        class="search-input lang-search-input"
        type="search"
        placeholder="Search languages…"
        aria-label="Filter language chips"
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="lang-suggest-list"
        aria-autocomplete="list"
      />
      <ul id="lang-suggest-list" class="lang-suggest-list" role="listbox" hidden></ul>
    </div>
    <div class="paper-controls-right">
      <div class="sort-wrapper">
        <svg class="input-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/>
        </svg>
        <label class="sr-only" for="paper-sort">Sort papers</label>
        <select id="paper-sort" class="sort-select">
          <optgroup label="Sort">
            <option value="default">Newest first (arXiv order)</option>
            <option value="lang-desc">Most languages (count ↓)</option>
            <option value="lang-asc">Fewest languages (count ↑)</option>
            <option value="resource-asc">Low-resource first (class 0→5)</option>
            <option value="resource-desc">High-resource first (class 5→0)</option>
            <option value="title-asc">Title A–Z</option>
            <option value="title-desc">Title Z–A</option>
          </optgroup>
          <optgroup label="Filter by class">
            <option value="class-0">Class 0</option>
            <option value="class-1">Class 1</option>
            <option value="class-2">Class 2</option>
            <option value="class-3">Class 3</option>
            <option value="class-4">Class 4</option>
            <option value="class-5">Class 5</option>
          </optgroup>
        </select>
      </div>
      <span id="result-count" class="result-count" aria-live="polite" aria-atomic="true"></span>
    </div>
  </div>

  <div class="chip-area" id="chip-area">
    <div class="chip-row verdict-row" id="verdict-filters" role="group" aria-label="Filter by judge verdict">
      <span class="verdict-row-label">Show:</span>
      <button class="chip verdict-chip active" type="button" data-verdict="studied">
        Studied <span class="chip-count">(<span class="chip-count-val">{verdictCounts.studied}</span>)</span>
      </button>
      <button class="chip verdict-chip active" type="button" data-verdict="mentioned_only">
        Mentioned-only <span class="chip-count">(<span class="chip-count-val">{verdictCounts.mentioned_only}</span>)</span>
      </button>
      <button class="chip verdict-chip" type="button" data-verdict="false_positive">
        False positives <span class="chip-count">(<span class="chip-count-val">{verdictCounts.false_positive}</span>)</span>
      </button>
    </div>
    <div class="chip-row-wrapper" id="chip-row-wrapper">
      <div class="chip-row" id="language-filters">
        <button class="chip active" type="button" data-lang="all">All</button>
        {languages.map((language) => (
          <button
            class={`chip lang-filter-chip class-${languageBorderClass(language, langClasses)}`}
            type="button"
            data-lang={language}
            style={`background:${languageFillColor(language)}`}
          >
            {language} <span class="chip-count">(<span class="chip-count-val">{languageCounts.get(language) || 0}</span>)</span>
          </button>
        ))}
        <button id="chip-expand-btn" class="chip-expand-btn" type="button" aria-expanded="false" aria-label="Show more language filters" style="display:none">… +0 more</button>
      </div>
      <p id="lang-chip-empty" class="lang-chip-empty" role="status" style="display:none"></p>
    </div>
  </div>
  <script type="application/json" id="all-languages-data" set:html={JSON.stringify(allLanguageNames)} is:inline />

  <div class="paper-list" id="paper-list">
    {paperItems.map((item) => (
      <div class="paper-row-wrap">
        <details
          class="paper-row"
          data-search={item.searchText}
          data-languages={item.chipLanguageNames.join('|')}
          data-lang-count={item.chipLanguageNames.length}
          data-min-class={item.minClass}
          data-classes={[...new Set(item.chips.map(c => c.borderClass))].join(',')}
          data-title={item.paper.title.toLowerCase()}
          data-index={item.index}
          data-week={item.weekStart}
          data-verdicts={item.verdicts.join(',')}
        >
          <summary class="paper-summary">
            <div class="paper-main">
              <div class="paper-title-row">
                <h3 set:html={item.paper.titleHtml}></h3>
              </div>
            <p class="paper-authors">{item.allAuthors}</p>
            <div class="paper-tags">
              {item.chips.map((chip, chipIdx) => (
                chip.needsReview || chip.mentionedOnly ? (
                  <span class="lang-chip-popover">
                    <span class={`lang-chip class-${chip.borderClass}${chip.needsReview ? ' needs-review' : ''}${chip.mentionedOnly ? ' mentioned-only' : ''}`} style={`background:${chip.fillColor}`} aria-describedby={`chip-tip-${item.index}-${chipIdx}`} data-verdict={chip.mentionedOnly ? 'mentioned_only' : 'studied'}>
                      {chip.language}{chip.needsReview && <span class="review-star" aria-hidden="true">★</span>}{chip.mentionedOnly && <span class="mentioned-mark" aria-hidden="true">~</span>}
                    </span>
                    <div class="review-popover-body" id={`chip-tip-${item.index}-${chipIdx}`} role="tooltip">
                      {chip.mentionedOnly && (
                        <div>
                          <strong>LLM judge: mentioned but not studied</strong>
                          {chip.judgeReason && <p>{chip.judgeReason}</p>}
                        </div>
                      )}
                      {chip.needsReview && (
                        <div>
                          <strong>⚠ Manual verification may be needed</strong>
                          {chip.flagReason && <p>{chip.flagReason}</p>}
                        </div>
                      )}
                    </div>
                  </span>
                ) : (
                  <span class={`lang-chip class-${chip.borderClass}`} style={`background:${chip.fillColor}`} data-verdict="studied">{chip.language}</span>
                )
              ))}
              {item.suppressedChips.map((sc, scIdx) => (
                <span class="lang-chip-popover">
                  <span class={`lang-chip class-${sc.borderClass} suppressed`} aria-describedby={`suppressed-tip-${item.index}-${scIdx}`}>
                    {sc.language}<span class="suppressed-mark" aria-hidden="true">?</span>
                  </span>
                  <div class="review-popover-body" id={`suppressed-tip-${item.index}-${scIdx}`} role="tooltip">
                    <strong>Potentially suppressed</strong>
                    <p>This paper defines <code>{sc.acronyms.join(', ')}</code> as {sc.acronyms.length === 1 ? 'an acronym' : 'acronyms'} — mentions of <em>{sc.language}</em> may not have been detected.</p>
                  </div>
                </span>
              ))}
              {(item.judgeSuppressedChips ?? []).map((jc, jcIdx) => (
                <span class="lang-chip-popover">
                  <span class={`lang-chip class-${jc.borderClass} suppressed judge-suppressed`} aria-describedby={`judge-suppressed-tip-${item.index}-${jcIdx}`} data-verdict="false_positive">
                    {jc.language}<span class="suppressed-mark" aria-hidden="true">✗</span>
                  </span>
                  <div class="review-popover-body" id={`judge-suppressed-tip-${item.index}-${jcIdx}`} role="tooltip">
                    <strong>Excluded by LLM judge{jc.model ? ` (${jc.model})` : ''}</strong>
                    {jc.reason && <p>{jc.reason}</p>}
                  </div>
                </span>
              ))}
              {item.coverageBadge && (
                <span class="lang-chip-popover">
                  <span class={`coverage-badge${item.hasPdf ? ' pdf-only' : ' abstract-only'}`} aria-describedby={`coverage-tip-${item.index}`}>
                    {item.coverageBadge.label}
                  </span>
                  <div class="review-popover-body" id={`coverage-tip-${item.index}`} role="tooltip">
                    <strong>⚠ {item.coverageBadge.label}</strong>
                    <p>{item.coverageBadge.title}</p>
                  </div>
                </span>
              )}
            </div>
          </div>
        </summary>
        <div class="paper-body">
          {(item.pubDateStr || (item.paper.categories && item.paper.categories.length > 0)) && (
            <div class="paper-meta">
              {item.pubDateStr && <span class="paper-date">Published {item.pubDateStr}</span>}
              {item.showUpdated && <span class="paper-meta-sep">·</span>}
              {item.showUpdated && <span class="paper-date">Updated {item.updDateStr}</span>}
              {item.paper.categories && item.paper.categories.length > 0 && (
                <span class="paper-categories">
                  {item.paper.categories.map((cat: string) => (
                    <span class="category-badge">{cat}</span>
                  ))}
                </span>
              )}
            </div>
          )}
          <strong class="paper-abstract-label">Abstract</strong>
          <p class="paper-abstract" set:html={item.paper.abstractHtml} />
          {item.acronymConflicts.length > 0 && (
            <div class="acronym-conflict-notice">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <span>
                <strong>Manual review may be needed:</strong>{' '}
                {item.acronymConflicts.map((w, i) => (
                  <span>
                    {i > 0 && ' · '}
                    This paper defines <code>{w.acronym}</code> as an acronym — mentions of the language <em>{w.language}</em> (class {w.language_class}) may have been suppressed.
                  </span>
                ))}
              </span>
            </div>
          )}
          {item.sourcesGroups.length > 0 && (
            <details class="lang-sources-summary">
              <summary class="lang-sources-toggle">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="lang-sources-chevron"><polyline points="9 18 15 12 9 6"/></svg>
                Language detection sources
              </summary>
              <div class="lang-sources-body">
                {item.sourcesGroups
                  .filter((g) => g.src !== 'abstract')
                  .map((g) => (
                    <div class="lang-source-row">
                      <span class="lang-source-label">{g.label}:</span>
                      <span class="lang-source-langs">{g.langs.join(', ')}</span>
                      {g.src === 'html' && item.sections && item.sections.length > 0 && (
                        <details class="html-sections-list">
                          <summary class="html-sections-summary">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="html-sections-chevron"><polyline points="9 18 15 12 9 6"/></svg>
                            Section-wise breakdown
                          </summary>
                          <div class="html-sections-body">
                            {item.sections
                              .filter((s) => s.source === 'html')
                              .map((s) => (
                                <div class="html-section-item">
                                  <div class="html-section-title"><strong>{formatSectionTitle(s.name)}</strong></div>
                                  <div class="html-section-langs">{Array.from(new Set((s.chips || []).map(c => c.language).filter(Boolean))).join(', ')}</div>
                                </div>
                              ))}
                          </div>
                        </details>
                      )}
                    </div>
                  ))}
              </div>
            </details>
          )}
          <div class="paper-body-footer">
            <a class="arxiv-link" href={item.arxivUrl} target="_blank" rel="noreferrer">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              View on arXiv<span class="sr-only"> (opens in new tab)</span>
            </a>
          </div>
        </div>
        </details>
        <a class="pdf-link" href={item.paper.pdf_url} target="_blank" rel="noreferrer" aria-label={`PDF — ${item.paper.title} (opens in new tab)`}>
          <svg class="pdf-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7zm0 1.5V8h4.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          </svg>
          <span aria-hidden="true">PDF</span>
        </a>
      </div>
    ))}
  </div>
</section>

<script>
  import { foldSearchText } from '../lib/text-utils.js';

  // ── State ────────────────────────────────────────────────────────────────────

  const root = document.getElementById('paper-table-root') as HTMLElement;
  const currentWeekSlug: string = root?.dataset.currentWeek ?? '';
  const availableWeeks: string[] = JSON.parse(root?.dataset.availableWeeks ?? '[]');
  const baseUrl: string = (root?.dataset.baseUrl ?? '').replace(/\/+$/, '');

  const urlParams = new URLSearchParams(location.search);
  const _langParam = urlParams.get('lang') ?? '';
  const activeLanguages = new Set<string>(_langParam ? _langParam.split(',').filter(Boolean) : []);

  const DEFAULT_VERDICTS = ['studied', 'mentioned_only'];
  const _verdictParam = urlParams.get('verdict');
  const enabledVerdicts = new Set<string>(_verdictParam !== null ? _verdictParam.split(',').filter(Boolean) : DEFAULT_VERDICTS);

  // Track fetched/fetching weeks to avoid duplicate requests
  const fetchedWeeks = new Set<string>([currentWeekSlug]);
  const pendingFetches = new Map<string, Promise<void>>();

  const searchInput = document.getElementById('paper-search') as HTMLInputElement | null;
  const langSearchInput = document.getElementById('lang-search') as HTMLInputElement | null;
  const sortSelect = document.getElementById('paper-sort') as HTMLSelectElement | null;
  const resultCount = document.getElementById('result-count') as HTMLElement | null;
  const activeFiltersBar = document.getElementById('active-filters-bar') as HTMLElement | null;
  const activeFilterTags = document.getElementById('active-filter-tags') as HTMLElement | null;
  const clearFiltersBtn = document.getElementById('clear-filters-btn') as HTMLButtonElement | null;
  const expandBtn = document.getElementById('chip-expand-btn') as HTMLButtonElement | null;
  const paperList = document.getElementById('paper-list') as HTMLElement | null;
  const langSuggestList = document.getElementById('lang-suggest-list') as HTMLUListElement | null;
  const langChipEmpty = document.getElementById('lang-chip-empty') as HTMLElement | null;

  const verdictChips = Array.from(document.querySelectorAll<HTMLButtonElement>('#verdict-filters .verdict-chip'));
  const allChips = Array.from(document.querySelectorAll<HTMLButtonElement>('#language-filters .chip'));
  const langChips = Array.from(document.querySelectorAll<HTMLButtonElement>('#language-filters .lang-filter-chip'));
  let rows = Array.from(document.querySelectorAll<HTMLElement>('#paper-list .paper-row'));
  let chipExpanded = false;
  const chipRow = document.getElementById('language-filters') as HTMLElement | null;

  // Full taxonomy (~6k names), used for the search typeahead and to tell a
  // known-but-absent language apart from an unrecognized/misspelled one.
  const allLanguageNames: string[] = JSON.parse(document.getElementById('all-languages-data')?.textContent || '[]');
  const foldedLanguageNames = allLanguageNames.map(name => ({ name, folded: foldSearchText(name) }));

  // ── URL param helpers ────────────────────────────────────────────────────────

  function updateUrlParams() {
    const p = new URLSearchParams(location.search);
    const langs = [...activeLanguages].join(',');
    if (langs) p.set('lang', langs); else p.delete('lang');
    const q = searchInput?.value.trim() ?? '';
    if (q) p.set('q', q); else p.delete('q');
    const sort = sortSelect?.value ?? 'default';
    if (sort && sort !== 'default') p.set('sort', sort); else p.delete('sort');
    if (!isDefaultVerdicts()) p.set('verdict', [...enabledVerdicts].join(',')); else p.delete('verdict');
    const qs = p.toString();
    history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
  }

  // ── Active-period week set ───────────────────────────────────────────────────

  function getActiveWeekSlugs(): string[] {
    const params = new URLSearchParams(location.search);
    const periodParam = params.get('period');
    const fromParam = params.get('from');
    if (periodParam === 'all') return [...availableWeeks];
    if (fromParam) {
      const fromIdx = availableWeeks.indexOf(fromParam);
      const anchorIdx = availableWeeks.indexOf(currentWeekSlug);
      if (fromIdx !== -1 && anchorIdx !== -1) {
        return availableWeeks.slice(Math.min(fromIdx, anchorIdx), Math.max(fromIdx, anchorIdx) + 1);
      }
    }
    return [currentWeekSlug];
  }

  // ── Multi-week fetch ─────────────────────────────────────────────────────────

  type PaperJSON = {
    id: string; title: string; titleHtml: string; authors: string[]; abstract: string; abstractHtml: string;
    pdf_url: string; arxiv_url: string; published: string; categories: string[];
    searchText: string;
    languages: { language: string; borderClass: number; fillColor: string; needsReview: boolean; judgeVerdict?: string }[];
    languageNames: string[]; langCount: number; minClass: number; classes: number[];
    judgeSuppressedChips: { language: string; borderClass: number; reason: string; model: string }[];
    verdicts: string[];
  };

  function formatPubDate(iso: string): string {
    if (!iso) return '';
    try { return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }); }
    catch { return iso; }
  }

  function fmtWeekLabel(slug: string): string {
    try { return new Date(slug + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }); }
    catch { return slug; }
  }

  // arXiv titles/abstracts routinely contain <, >, & (math, literal tags like
  // "<think>", entities). The server-rendered rows are auto-escaped by Astro;
  // these dynamically-built rows go through innerHTML, so escape to match —
  // otherwise the browser parses the markup (breaking the text, and allowing
  // injection) only in period/all-papers mode.
  function escapeHtml(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function createPaperRow(p: PaperJSON, weekStart: string, index: number): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'paper-row-wrap';
    wrap.style.display = 'none';

    const chips = p.languages.map(l => {
      const mentionedOnly = l.judgeVerdict === 'mentioned_only';
      const span = document.createElement('span');
      span.className = `lang-chip class-${l.borderClass}${l.needsReview ? ' needs-review' : ''}${mentionedOnly ? ' mentioned-only' : ''}`;
      span.dataset.verdict = mentionedOnly ? 'mentioned_only' : 'studied';
      span.style.background = l.fillColor;
      span.textContent = l.language;
      if (l.needsReview) {
        const star = document.createElement('span');
        star.className = 'review-star';
        star.setAttribute('aria-hidden', 'true');
        star.textContent = '★';
        span.appendChild(star);
      }
      if (mentionedOnly) {
        const mark = document.createElement('span');
        mark.className = 'mentioned-mark';
        mark.setAttribute('aria-hidden', 'true');
        mark.textContent = '~';
        span.appendChild(mark);
        span.title = 'LLM judge: mentioned but not studied';
      }
      return span;
    });

    const suppressedChips = (p.judgeSuppressedChips || []).map(sc => {
      const span = document.createElement('span');
      span.className = `lang-chip class-${sc.borderClass} suppressed judge-suppressed`;
      span.dataset.verdict = 'false_positive';
      span.textContent = sc.language;
      const mark = document.createElement('span');
      mark.className = 'suppressed-mark';
      mark.setAttribute('aria-hidden', 'true');
      mark.textContent = '✗';
      span.appendChild(mark);
      span.title = `Excluded by LLM judge${sc.model ? ` (${sc.model})` : ''}${sc.reason ? `: ${sc.reason}` : ''}`;
      return span;
    });

    const weekBadge = `<span class="week-badge">w/o ${fmtWeekLabel(weekStart)}</span>`;
    const pubDateStr = formatPubDate(p.published);
    const catBadges = p.categories.map(c => `<span class="category-badge">${escapeHtml(c)}</span>`).join('');

    const details = document.createElement('details');
    details.className = 'paper-row';
    details.dataset.id = p.id;
    details.dataset.search = p.searchText;
    details.dataset.languages = p.languageNames.join('|');
    details.dataset.langCount = String(p.langCount);
    details.dataset.minClass = String(p.minClass);
    details.dataset.classes = p.classes.join(',');
    details.dataset.title = p.title.toLowerCase();
    details.dataset.index = String(index);
    details.dataset.week = weekStart;
    details.dataset.verdicts = p.verdicts.join(',');

    const tagsHtml = [...chips, ...suppressedChips].map(c => c.outerHTML).join('');
    details.innerHTML = `
      <summary class="paper-summary">
        <div class="paper-main">
          <div class="paper-title-row">
            <!-- titleHtml is pre-rendered server-side (renderTitleHtml) — already
                 HTML-escaped except for trusted <sup>/<sub> markup, so not re-escaped here. -->
            <h3>${p.titleHtml}${weekBadge}</h3>
          </div>
          <p class="paper-authors">${escapeHtml(p.authors.join(', ')) || 'Unknown authors'}</p>
          <div class="paper-tags">${tagsHtml}</div>
        </div>
      </summary>
      <div class="paper-body">
        ${pubDateStr || catBadges ? `<div class="paper-meta">${pubDateStr ? `<span class="paper-date">Published ${pubDateStr}</span>` : ''}${catBadges ? `<span class="paper-categories">${catBadges}</span>` : ''}</div>` : ''}
        <strong class="paper-abstract-label">Abstract</strong>
        <!-- abstractHtml is pre-rendered server-side (renderAbstractHtml) — already
             HTML-escaped except for trusted KaTeX math markup, so not re-escaped here. -->
        <p class="paper-abstract">${p.abstractHtml}</p>
        <div class="paper-body-footer">
          <a class="arxiv-link" href="${escapeHtml(p.arxiv_url)}" target="_blank" rel="noreferrer">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            View on arXiv<span class="sr-only"> (opens in new tab)</span>
          </a>
        </div>
      </div>`;

    const pdfLink = document.createElement('a');
    pdfLink.className = 'pdf-link';
    pdfLink.href = p.pdf_url;
    pdfLink.target = '_blank';
    pdfLink.rel = 'noreferrer';
    pdfLink.setAttribute('aria-label', `PDF — ${p.title} (opens in new tab)`);
    pdfLink.innerHTML = `<svg class="pdf-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7zm0 1.5V8h4.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg><span aria-hidden="true">PDF</span>`;

    wrap.appendChild(details);
    wrap.appendChild(pdfLink);
    return wrap;
  }

  async function fetchWeek(weekSlug: string): Promise<void> {
    if (fetchedWeeks.has(weekSlug)) return;
    if (pendingFetches.has(weekSlug)) return pendingFetches.get(weekSlug);

    const promise = (async () => {
      try {
        const url = `${baseUrl}/api/weeks/${weekSlug}.json`;
        const resp = await fetch(url);
        if (!resp.ok) return;
        const papers: PaperJSON[] = await resp.json();
        const existingIds = new Set(rows.map(r => r.dataset.id).filter(Boolean));
        let idx = rows.length;
        for (const p of papers) {
          if (p.id && existingIds.has(p.id)) continue;
          if (p.id) existingIds.add(p.id);
          const wrap = createPaperRow(p, weekSlug, idx++);
          paperList?.appendChild(wrap);
        }
        // Refresh rows array to include newly added rows
        rows = Array.from(document.querySelectorAll<HTMLElement>('#paper-list .paper-row'));
        fetchedWeeks.add(weekSlug);
      } catch { /* silently ignore fetch errors */ }
    })();

    pendingFetches.set(weekSlug, promise);
    await promise;
    pendingFetches.delete(weekSlug);
  }

  // ── Chip counts ──────────────────────────────────────────────────────────────

  function updateChipCounts(): Map<string, number> {
    const activeWeekSet = new Set(getActiveWeekSlugs());
    const counts = new Map<string, number>();
    for (const row of rows) {
      const rowWeek = row.dataset.week ?? currentWeekSlug;
      if (!activeWeekSet.has(rowWeek)) continue;
      (row.dataset.languages ?? '').split('|').filter(Boolean).forEach(l => {
        counts.set(l, (counts.get(l) ?? 0) + 1);
      });
    }
    document.querySelectorAll<HTMLElement>('#language-filters .lang-filter-chip').forEach(chip => {
      const lang = chip.dataset.lang ?? '';
      const valEl = chip.querySelector<HTMLElement>('.chip-count-val');
      if (valEl) valEl.textContent = String(counts.get(lang) ?? 0);
    });
    return counts;
  }

  function updateVerdictCounts() {
    const activeWeekSet = new Set(getActiveWeekSlugs());
    const counts = new Map<string, number>();
    for (const row of rows) {
      const rowWeek = row.dataset.week ?? currentWeekSlug;
      if (!activeWeekSet.has(rowWeek)) continue;
      (row.dataset.verdicts ?? '').split(',').filter(Boolean).forEach(v => {
        counts.set(v, (counts.get(v) ?? 0) + 1);
      });
    }
    verdictChips.forEach(chip => {
      const verdict = chip.dataset.verdict ?? '';
      const valEl = chip.querySelector<HTMLElement>('.chip-count-val');
      if (valEl) valEl.textContent = String(counts.get(verdict) ?? 0);
    });
  }

  // ── Collapse helpers ─────────────────────────────────────────────────────────

  function measureFirstRow(): { firstRowChips: HTMLButtonElement[]; overflowChips: HTMLButtonElement[] } {
    const visible = langChips.filter(c => !c.hidden && c.style.display !== 'none');
    if (!visible.length) return { firstRowChips: [], overflowChips: [] };
    const firstTop = visible[0].getBoundingClientRect().top;
    const chipH   = visible[0].getBoundingClientRect().height;
    const threshold = firstTop + chipH * 0.5;
    return {
      firstRowChips: visible.filter(c => c.getBoundingClientRect().top < threshold),
      overflowChips: visible.filter(c => c.getBoundingClientRect().top >= threshold),
    };
  }

  function applyCollapse() {
    if (!expandBtn || !chipRow) return;
    chipRow.appendChild(expandBtn);
    requestAnimationFrame(() => {
      langChips.forEach(c => c.style.removeProperty('display'));
      expandBtn!.style.display = 'none';
      const { firstRowChips, overflowChips } = measureFirstRow();
      if (overflowChips.length === 0) return;
      if (firstRowChips.length === 0) return;
      const firstTop = firstRowChips[0].getBoundingClientRect().top;
      const chipH    = firstRowChips[0].getBoundingClientRect().height;
      // An active filter chip is kept visible even if it would otherwise land in
      // the collapsed "+N more" bucket — hiding it made an applied filter look
      // like it had silently reset when really it just wasn't in this week's top row.
      const candidates = [...overflowChips];
      if (firstRowChips.length > 0) candidates.push(firstRowChips[firstRowChips.length - 1]);
      const toHide = candidates.filter(c => !c.classList.contains('active'));
      toHide.forEach(c => { c.style.display = 'none'; });
      let hiddenCount = toHide.length;
      expandBtn!.style.removeProperty('display');
      expandBtn!.setAttribute('aria-expanded', 'false');
      expandBtn!.textContent = `… +${hiddenCount} more`;
      expandBtn!.setAttribute('aria-label', `Show ${hiddenCount} more language filters`);
      for (let i = 0; i < langChips.length; i++) {
        if (chipH === 0) break;
        if (Math.abs(expandBtn!.getBoundingClientRect().top - firstTop) <= chipH * 0.5) break;
        const stillVisible = langChips.filter(c => !c.hidden && c.style.display !== 'none');
        const extra = [...stillVisible].reverse().find(c => !c.classList.contains('active'));
        if (!extra) break;
        extra.style.display = 'none';
        hiddenCount++;
        expandBtn!.textContent = `… +${hiddenCount} more`;
        expandBtn!.setAttribute('aria-label', `Show ${hiddenCount} more language filters`);
      }
    });
  }

  function expandChips() {
    if (!expandBtn || !chipRow) return;
    chipExpanded = true;
    requestAnimationFrame(() => {
      langChips.forEach(c => { if (!c.hidden) c.style.removeProperty('display'); });
      expandBtn!.style.display = 'none';
      const visible = langChips.filter(c => !c.hidden && c.style.display !== 'none');
      if (visible.length > 0) {
        const firstTop = visible[0].getBoundingClientRect().top;
        const chipH    = visible[0].getBoundingClientRect().height;
        const threshold = firstTop + chipH * 0.5;
        const firstRowChips = visible.filter(c => c.getBoundingClientRect().top < threshold);
        if (firstRowChips.length > 0) firstRowChips[firstRowChips.length - 1].insertAdjacentElement('afterend', expandBtn!);
        expandBtn!.style.removeProperty('display');
        expandBtn!.setAttribute('aria-expanded', 'true');
        expandBtn!.textContent = 'Show less';
        expandBtn!.setAttribute('aria-label', 'Show fewer language filters');
        for (let i = 0; i < langChips.length; i++) {
          if (chipH === 0) break;
          if (Math.abs(expandBtn!.getBoundingClientRect().top - firstTop) <= chipH * 0.5) break;
          const prev = expandBtn!.previousElementSibling as Element | null;
          if (!prev || !langChips.includes(prev as HTMLButtonElement) || prev.parentNode !== chipRow) break;
          chipRow!.insertBefore(expandBtn!, prev);
        }
      } else {
        expandBtn!.style.removeProperty('display');
        expandBtn!.setAttribute('aria-expanded', 'true');
        expandBtn!.textContent = 'Show less';
        expandBtn!.setAttribute('aria-label', 'Show fewer language filters');
      }
    });
  }

  function collapseChips() { chipExpanded = false; applyCollapse(); }

  expandBtn?.addEventListener('click', () => { chipExpanded ? collapseChips() : expandChips(); });
  window.addEventListener('resize', () => { if (!chipExpanded) applyCollapse(); });
  document.getElementById('flagged-papers')?.addEventListener('toggle', (e) => {
    if ((e.target as HTMLDetailsElement).open && !chipExpanded) applyCollapse();
  });

  // ── Language chip search ─────────────────────────────────────────────────────

  // Narrows which chip *buttons* are shown — purely visual. It must never
  // touch activeLanguages: search text is also how multiple picks get stacked
  // (search A, Enter, search B, Enter), so clearing an active filter just
  // because its chip momentarily scrolled out of the text-matched set would
  // silently undo the previous pick before the user gets to their second one.
  function filterLangChips(query: string) {
    const q = foldSearchText(query.trim());
    langChips.forEach(chip => {
      chip.hidden = q.length > 0 && !foldSearchText(chip.dataset.lang || '').includes(q);
    });
    if (chipExpanded) {
      langChips.forEach(c => { if (!c.hidden) c.style.removeProperty('display'); });
    } else {
      applyCollapse();
    }
    updateUnmatchedQueryNotice(query);
  }

  // Two independent notices share the one status line below the chip row:
  // - unmatchedQueryNotice: the text currently typed in the search box doesn't
  //   exactly match any *visible* chip — could be a real language with 0
  //   occurrences, or just not a recognized name at all.
  // - zeroActiveLanguageNotice: any already-*activated* language filter(s)
  //   with 0 papers in the current view. Tracked separately from the search
  //   box so that e.g. picking "Xhosa" (has results) and later "Sa" (doesn't)
  //   still flags the zero one, instead of the presence of Xhosa's visible
  //   chip masking Sa's absence.
  let unmatchedQueryNotice = '';
  let zeroActiveLanguageNotice = '';

  function renderLangChipNotice() {
    if (!langChipEmpty) return;
    const parts = [zeroActiveLanguageNotice, unmatchedQueryNotice].filter(Boolean);
    langChipEmpty.textContent = parts.join(' · ');
    langChipEmpty.style.display = parts.length > 0 ? '' : 'none';
  }

  function updateUnmatchedQueryNotice(query: string) {
    const q = query.trim();
    if (!q) { unmatchedQueryNotice = ''; renderLangChipNotice(); return; }
    const foldedQuery = foldSearchText(q);
    const exactVisibleChip = langChips.some(c => !c.hidden && foldSearchText(c.dataset.lang || '') === foldedQuery);
    if (exactVisibleChip) { unmatchedQueryNotice = ''; renderLangChipNotice(); return; }
    // If this exact language is already an active filter, the zero-active-language
    // notice below owns reporting its status — don't say the same thing twice.
    const alreadyActive = [...activeLanguages].some(l => foldSearchText(l) === foldedQuery);
    if (alreadyActive) { unmatchedQueryNotice = ''; renderLangChipNotice(); return; }
    const known = foldedLanguageNames.find(({ folded }) => folded === foldedQuery);
    unmatchedQueryNotice = known
      ? `"${known.name}" is a recognized language, but has 0 papers in the current view.`
      : `No language matches "${q}".`;
    renderLangChipNotice();
  }

  function updateZeroActiveLanguageNotice(counts: Map<string, number>) {
    const zero = [...activeLanguages].filter(l => (counts.get(l) ?? 0) === 0);
    zeroActiveLanguageNotice = zero.length === 0
      ? ''
      : zero.length === 1
        ? `"${zero[0]}" has 0 papers in the current view.`
        : `${zero.map(l => `"${l}"`).join(', ')} have 0 papers in the current view.`;
    renderLangChipNotice();
  }

  // ── Language search typeahead ────────────────────────────────────────────────

  let suggestionItems: HTMLLIElement[] = [];
  let activeSuggestionIndex = -1;

  function getSuggestions(query: string): string[] {
    const q = foldSearchText(query.trim());
    if (!q) return [];
    const prefixMatches: string[] = [];
    const substringMatches: string[] = [];
    for (const { name, folded } of foldedLanguageNames) {
      if (folded.startsWith(q)) prefixMatches.push(name);
      else if (folded.includes(q)) substringMatches.push(name);
    }
    return [...prefixMatches, ...substringMatches];
  }

  function closeSuggestions() {
    if (langSuggestList) langSuggestList.hidden = true;
    suggestionItems = [];
    activeSuggestionIndex = -1;
    langSearchInput?.setAttribute('aria-expanded', 'false');
    langSearchInput?.removeAttribute('aria-activedescendant');
  }

  function setActiveSuggestion(index: number) {
    suggestionItems.forEach(item => { item.classList.remove('active'); item.removeAttribute('aria-selected'); });
    activeSuggestionIndex = index;
    if (index < 0 || index >= suggestionItems.length) {
      langSearchInput?.removeAttribute('aria-activedescendant');
      return;
    }
    const item = suggestionItems[index];
    item.classList.add('active');
    item.setAttribute('aria-selected', 'true');
    item.scrollIntoView({ block: 'nearest' });
    langSearchInput?.setAttribute('aria-activedescendant', item.id);
  }

  // Picking a suggestion (click or Enter) both narrows the chip row to it and
  // activates it as a filter — same end state as clicking its chip directly.
  function selectSuggestion(name: string) {
    if (langSearchInput) langSearchInput.value = name;
    closeSuggestions();
    // Activate first so filterLangChips's "already active" check (which reads
    // activeLanguages) sees this language and doesn't also raise its own notice.
    toggleLanguage(name);
    filterLangChips(name);
    applyFilters();
    langSearchInput?.focus();
  }

  function renderSuggestions(names: string[]) {
    if (!langSuggestList) return;
    langSuggestList.replaceChildren();
    suggestionItems = [];
    activeSuggestionIndex = -1;
    if (names.length === 0) {
      closeSuggestions();
      return;
    }
    names.forEach((name, i) => {
      const li = document.createElement('li');
      li.className = 'lang-suggest-item';
      li.id = `lang-suggest-opt-${i}`;
      li.setAttribute('role', 'option');
      li.textContent = name;
      // mousedown (not click) fires before the input's blur, so preventing its
      // default here keeps focus on the input instead of dismissing the list first.
      li.addEventListener('mousedown', (e) => { e.preventDefault(); selectSuggestion(name); });
      langSuggestList.appendChild(li);
      suggestionItems.push(li);
    });
    langSuggestList.hidden = false;
    langSearchInput?.setAttribute('aria-expanded', 'true');
  }

  function toggleLanguage(lang: string) {
    if (lang === 'all') {
      activeLanguages.clear();
    } else if (activeLanguages.has(lang)) {
      activeLanguages.delete(lang);
    } else {
      activeLanguages.add(lang);
    }
    const allBtn = allChips.find(c => c.dataset.lang === 'all');
    langChips.forEach(chip => chip.classList.toggle('active', activeLanguages.has(chip.dataset.lang || '')));
    if (allBtn) allBtn.classList.toggle('active', activeLanguages.size === 0);
    updateUrlParams();
  }

  // ── Paper filters ────────────────────────────────────────────────────────────

  function getClassFilter(): string {
    const v = sortSelect?.value ?? '';
    return v.startsWith('class-') ? v.slice(6) : 'all';
  }

  const VERDICT_LABEL: Record<string, string> = { studied: 'Studied', mentioned_only: 'Mentioned-only', false_positive: 'False positives' };

  function isDefaultVerdicts(): boolean {
    return enabledVerdicts.size === DEFAULT_VERDICTS.length && DEFAULT_VERDICTS.every(v => enabledVerdicts.has(v));
  }

  function updateFilterBar() {
    const searchTerm = searchInput?.value.trim() ?? '';
    const langTerm = langSearchInput?.value.trim() ?? '';
    const classFilter = getClassFilter();
    const tags: string[] = [];
    if (searchTerm) tags.push(`Title: "${searchTerm}"`);
    if (langTerm) tags.push(`Language search: "${langTerm}"`);
    if (activeLanguages.size > 0) tags.push(`Languages: ${[...activeLanguages].join(', ')}`);
    if (classFilter !== 'all') tags.push(`Class: ${classFilter}`);
    if (!isDefaultVerdicts()) {
      const label = [...enabledVerdicts].map(v => VERDICT_LABEL[v] ?? v).join(', ') || 'None';
      tags.push(`Show: ${label}`);
    }
    const active = tags.length > 0;
    if (activeFiltersBar) activeFiltersBar.style.display = active ? '' : 'none';
    if (activeFilterTags) activeFilterTags.textContent = tags.join(' · ');
  }

  function applyFilters() {
    const activeWeekSet = new Set(getActiveWeekSlugs());
    const searchTerm = foldSearchText(searchInput?.value.trim() ?? '');
    const classFilter = getClassFilter();
    let visible = 0;
    let inScopeTotal = 0;
    rows.forEach(row => {
      const rowWeek = row.dataset.week ?? currentWeekSlug;
      const inPeriod = activeWeekSet.has(rowWeek);
      const rowSearch = row.dataset.search || '';
      const rowLanguages = (row.dataset.languages || '').split('|').filter(Boolean);
      const rowClasses = (row.dataset.classes || '').split(',').filter(Boolean);
      const rowVerdicts = (row.dataset.verdicts || '').split(',').filter(Boolean);
      const matchesVerdict = rowVerdicts.some(v => enabledVerdicts.has(v));
      const inScope = inPeriod && matchesVerdict;
      const matchesLanguage = activeLanguages.size === 0 || rowLanguages.some(l => activeLanguages.has(l));
      const matchesSearch = !searchTerm || rowSearch.includes(searchTerm);
      const matchesClass = classFilter === 'all' || rowClasses.includes(classFilter);
      const show = inScope && matchesLanguage && matchesSearch && matchesClass;
      (row.parentElement as HTMLElement).style.display = show ? '' : 'none';
      if (show) visible++;
      if (inScope) inScopeTotal++;
    });
    if (resultCount) {
      resultCount.textContent = visible === inScopeTotal
        ? `${inScopeTotal} papers`
        : `${visible} of ${inScopeTotal} papers`;
    }
    updateFilterBar();
    const counts = updateChipCounts();
    updateVerdictCounts();
    updateZeroActiveLanguageNotice(counts);
  }

  // ── Sort ─────────────────────────────────────────────────────────────────────

  function sortPapers(mode: string) {
    if (!paperList) return;
    const sorted = [...rows].sort((a, b) => {
      switch (mode) {
        case 'lang-desc':    return parseInt(b.dataset.langCount || '0') - parseInt(a.dataset.langCount || '0');
        case 'lang-asc':     return parseInt(a.dataset.langCount || '0') - parseInt(b.dataset.langCount || '0');
        case 'resource-asc': return parseInt(a.dataset.minClass  || '5') - parseInt(b.dataset.minClass  || '5');
        case 'resource-desc':return parseInt(b.dataset.minClass  || '5') - parseInt(a.dataset.minClass  || '5');
        case 'title-asc':    return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        case 'title-desc':   return (b.dataset.title || '').localeCompare(a.dataset.title || '');
        default:             return parseInt(a.dataset.index || '0') - parseInt(b.dataset.index || '0');
      }
    });
    sorted.forEach(row => paperList.appendChild(row.parentElement as HTMLElement));
  }

  // ── Wire up ──────────────────────────────────────────────────────────────────

  allChips.forEach(chip => {
    chip.addEventListener('click', () => { toggleLanguage(chip.dataset.lang || 'all'); applyFilters(); });
  });
  searchInput?.addEventListener('input', () => { updateUrlParams(); applyFilters(); });
  langSearchInput?.addEventListener('input', e => {
    const value = (e.target as HTMLInputElement).value;
    filterLangChips(value);
    updateFilterBar();
    renderSuggestions(getSuggestions(value));
  });
  langSearchInput?.addEventListener('keydown', (e) => {
    if (!langSuggestList || langSuggestList.hidden) {
      if (e.key === 'ArrowDown' && langSearchInput.value.trim()) {
        e.preventDefault();
        renderSuggestions(getSuggestions(langSearchInput.value));
      }
      return;
    }
    switch (e.key) {
      case 'ArrowDown':
        e.preventDefault();
        setActiveSuggestion(activeSuggestionIndex < suggestionItems.length - 1 ? activeSuggestionIndex + 1 : 0);
        break;
      case 'ArrowUp':
        e.preventDefault();
        setActiveSuggestion(activeSuggestionIndex > 0 ? activeSuggestionIndex - 1 : suggestionItems.length - 1);
        break;
      case 'Enter': {
        // No arrow-key highlight yet — Enter still commits to the top match.
        const idx = activeSuggestionIndex >= 0 ? activeSuggestionIndex : 0;
        if (suggestionItems[idx]) {
          e.preventDefault();
          selectSuggestion(suggestionItems[idx].textContent || '');
        }
        break;
      }
      case 'Escape':
        closeSuggestions();
        break;
    }
  });
  langSearchInput?.addEventListener('focus', () => {
    if (langSearchInput.value.trim()) renderSuggestions(getSuggestions(langSearchInput.value));
  });
  langSearchInput?.addEventListener('blur', () => { closeSuggestions(); });
  sortSelect?.addEventListener('change', () => {
    const v = sortSelect.value;
    sortPapers(v.startsWith('class-') ? 'default' : v);
    updateUrlParams();
    applyFilters();
  });
  verdictChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const v = chip.dataset.verdict || '';
      if (enabledVerdicts.has(v)) enabledVerdicts.delete(v); else enabledVerdicts.add(v);
      chip.classList.toggle('active', enabledVerdicts.has(v));
      updateUrlParams();
      applyFilters();
    });
  });
  clearFiltersBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (langSearchInput) { langSearchInput.value = ''; filterLangChips(''); closeSuggestions(); }
    activeLanguages.clear();
    allChips.forEach(c => c.classList.toggle('active', c.dataset.lang === 'all'));
    langChips.forEach(c => c.classList.remove('active'));
    if (sortSelect) sortSelect.value = 'default';
    sortPapers('default');
    enabledVerdicts.clear();
    DEFAULT_VERDICTS.forEach(v => enabledVerdicts.add(v));
    verdictChips.forEach(c => c.classList.toggle('active', enabledVerdicts.has(c.dataset.verdict || '')));
    updateUrlParams();
    applyFilters();
  });

  // ── Init ─────────────────────────────────────────────────────────────────────

  // Restore active language chips from URL
  if (activeLanguages.size > 0) {
    const allBtn = allChips.find(c => c.dataset.lang === 'all');
    if (allBtn) allBtn.classList.remove('active');
    const chipLangs = new Set(langChips.map(c => c.dataset.lang || '').filter(Boolean));
    const validLanguageNames = new Set(allLanguageNames);
    // Only drop params that aren't even real taxonomy languages (garbage/typo'd
    // URLs) — a real language with 0 occurrences this week should stay active;
    // it just won't have a chip to highlight, which the zero-count notice covers.
    for (const l of activeLanguages) { if (!chipLangs.has(l) && !validLanguageNames.has(l)) activeLanguages.delete(l); }
    langChips.forEach(chip => { if (activeLanguages.has(chip.dataset.lang || '')) chip.classList.add('active'); });
    if (activeLanguages.size === 0 && allBtn) allBtn.classList.add('active');
  }

  // Restore verdict chip active state from URL (or default)
  verdictChips.forEach(chip => chip.classList.toggle('active', enabledVerdicts.has(chip.dataset.verdict || '')));

  // Restore search and sort from URL
  const _qParam = urlParams.get('q') ?? '';
  if (_qParam && searchInput) searchInput.value = _qParam;
  const _sortParam = urlParams.get('sort') ?? '';
  if (_sortParam && sortSelect) {
    sortSelect.value = _sortParam;
    sortPapers(_sortParam.startsWith('class-') ? 'default' : _sortParam);
  }

  // Fetch any weeks needed by the current URL state (period/all-time mode), then render
  document.fonts.ready.then(async () => {
    const activeWeeks = getActiveWeekSlugs();
    const weeksToFetch = activeWeeks.filter(w => !fetchedWeeks.has(w));
    if (weeksToFetch.length > 0) {
      await Promise.all(weeksToFetch.map(fetchWeek));
    }
    requestAnimationFrame(() => { applyCollapse(); applyFilters(); });
  });
</script>
