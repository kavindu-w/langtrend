# LLM judge configuration (scripts/judge_languages.py / langtrend/llm_client.py).
# Copy to .env and fill in the API key. All values below are the defaults.

# Default: Groq free tier (open-weight Llama 3.3 70B) via its OpenAI-compatible
# endpoint. Get a key at https://console.groq.com
# (free tier: ~1,000 req/day, 30 RPM for llama-3.3-70b-versatile).
LLM_JUDGE_BASE_URL=https://api.groq.com/openai/v1
LLM_JUDGE_MODEL=llama-3.3-70b-versatile
LLM_JUDGE_API_KEY=

# Local Ollama override for quota-free testing:
#LLM_JUDGE_BASE_URL=http://localhost:11434/v1
#LLM_JUDGE_MODEL=qwen3:8b
#LLM_JUDGE_API_KEY=ollama

# Gemini free tier is also OpenAI-compatible:
#LLM_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_JUDGE_MODEL=gemini-2.5-flash

# Tuning
LLM_JUDGE_TIMEOUT=180
LLM_JUDGE_TEMPERATURE=0
LLM_JUDGE_MAX_CONTEXT_CHARS=12000
LLM_JUDGE_WORKERS=4
# Shared requests-per-minute cap across workers (Groq free tier allows 30 RPM
# for llama-3.3-70b-versatile; kept conservative for safety margin)
LLM_JUDGE_RPM=20
